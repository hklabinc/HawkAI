@page "/airuler-result"

@using System.Text.Json
@using HawkAI.Data
@using HawkAI.Data.AirulerResultService
@using Microsoft.EntityFrameworkCore

@inject DataDbContext Db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<h4><strong>AIRuler Results</strong> (@_modelCards.Count)</h4>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <button class="btn btn-outline-secondary" @onclick="ReloadAsync">
        <span class="oi oi-reload"></span>
        Refresh
    </button>

    <button class="btn btn-danger" @onclick="ConfirmDeleteSelectedModelsAsync" disabled="@(!_modelCards.Any(x => x.IsSelectedForDelete))">
        <span class="oi oi-trash"></span>
        Delete Selected
    </button>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <span class="text-danger small">@_loadError</span>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <span class="text-muted small">@_statusMessage</span>
    }
</div>

@if (_modelCards.Count == 0)
{
    <div class="text-muted">No results found. Upload results via <code>/api/airuler/upload-results</code>.</div>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var m in _modelCards)
        {
            var isActive = string.Equals(m.ModelName, _selectedModelName, StringComparison.OrdinalIgnoreCase);

            <div class="card" style="width: 320px; position: relative; @(isActive ? "border:2px solid #0d6efd;" : "")">
                <img src="@m.RepresentativeThumbnailUrl"
                     class="card-img-top"
                     style="height: 180px; object-fit: cover; cursor: pointer;"
                     @onclick="() => SelectModelAsync(m.ModelName)" />

                <div class="card-body">
                    <h5 class="card-title mb-1">
                        <strong>@m.ModelName</strong>
                        <span class="text-muted" style="font-size: 0.95rem;">(@m.FileCount)</span>
                    </h5>
                    <p class="card-text text-muted" style="font-size: 0.85rem;">
                        Updated @m.LatestTimestampLocal
                    </p>
                </div>

                <!-- 카드 우측 상단 Delete Selected 체크박스 -->
                <div class="position-absolute top-0 end-0 m-2">
                    <input type="checkbox" class="form-check-input" @bind="m.IsSelectedForDelete" />
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_selectedModelName))
{
    <hr class="my-4" />

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h4 class="mb-0"><strong>@_selectedModelName</strong> <span class="text-muted" style="font-size: 0.95rem;">(@_records.Count)</span></h4>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedModel">Close</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_modelLoadError))
    {
        <div class="alert alert-warning mt-2">@_modelLoadError</div>
    }
    else if (_records.Count == 0)
    {
        <div class="text-muted mt-2">No records for this model.</div>
    }
    else
    {
        <div class="table-responsive mt-3" style="max-height: 70vh; overflow:auto;">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th style="min-width: 220px;"><strong>Image</strong></th>
                        <th style="min-width: 260px;"><strong>Info</strong></th>
                        <th style="width: 70px;"><strong>Film</strong></th>
                        @foreach (var col in _measureColumns)
                        {
                            <th style="min-width: 110px;"><strong>@col.Header</strong></th>
                        }
                        <th style="width: 120px;"><strong>Actions</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _records)
                    {
                        var filmRows = r.Films.Count > 0 ? r.Films : new List<FilmRowVm> { new FilmRowVm { Film = 0 } };
                        var rowspan = filmRows.Count;

                        for (var i = 0; i < filmRows.Count; i++)
                        {
                            var film = filmRows[i];
                            <tr>
                                @if (i == 0)
                                {
                                    <td rowspan="@rowspan" style="vertical-align: top;">
                                        <button type="button" class="btn btn-link p-0 text-start" @onclick="() => OpenPreviewAsync(r)">
                                            <div class="d-flex align-items-center" style="gap: 8px;">
                                                <img src="@r.ThumbnailUrl" style="width: 96px; height: 72px; object-fit: cover; border: 1px solid #eee;" />
                                                <div style="min-width:0;">
                                                    <div style="word-break: break-all;"><b>@r.Entity.FileName</b></div>
                                                    <div class="small text-muted">click to open</div>
                                                </div>
                                            </div>
                                        </button>
                                    </td>
                                    <td rowspan="@rowspan" style="vertical-align: top;">
                                        <div class="small">
                                            <div><b>timestamp</b>: @r.TimestampLocal</div>
                                            <div><b>deviceId</b>: @r.Entity.DeviceId</div>
                                            <div><b>modelName</b>: @r.Entity.ModelName</div>
                                            <div><b>imageSize</b>: @r.Entity.ImageSize</div>
                                            <div><b>measureMethod</b>: @r.Entity.MeasureMethod</div>
                                            <div><b>detectedFilms</b>: @r.Entity.DetectedFilms</div>
                                        </div>
                                    </td>
                                }

                                <td>
                                    @if (film.Film > 0)
                                    {
                                        <span>#{@film.Film}</span>
                                    }
                                </td>

                                @foreach (var col in _measureColumns)
                                {
                                    if (film.Cells.TryGetValue(col.Index, out var cell) && !string.IsNullOrWhiteSpace(cell.Text))
                                    {
                                        <td class="@(cell.IsFail ? "text-danger" : "")" style="white-space: nowrap;">
                                            @cell.Text
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }

                                @if (i == 0)
                                {
                                    <td rowspan="@rowspan" style="vertical-align: top;">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteRecordAsync(r.Entity.Id)">
                                            Delete
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_showPreviewModal && _previewRecord != null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><strong>@_previewRecord.Entity.FileName</strong></h5>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-lg-7">
                            <img src="@_previewRecord.ImageUrl" style="max-width: 100%; height: auto; border: 1px solid #eee;" />
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="mb-2">
                                <a href="@_previewRecord.ImageUrl" target="_blank">Open original image</a>
                                <span class="text-muted"> · </span>
                                <a href="@_previewRecord.JsonUrl" target="_blank">Open JSON file</a>
                            </div>
                            <h6><strong>Raw JSON (EXIF UserComment)</strong></h6>
                            <pre style="max-height: 70vh; overflow: auto; background: #fafafa; border: 1px solid #eee; padding: 8px;">@_previewJson</pre>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePreview">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    private sealed class ModelCardVm
    {
        public string ModelName { get; init; } = string.Empty;
        public int FileCount { get; init; }
        public DateTime LatestTimestampUtc { get; init; }
        public string RepresentativeThumbnailUrl { get; init; } = string.Empty;
        public bool IsSelectedForDelete { get; set; }

        public string LatestTimestampLocal => LatestTimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private sealed class MeasureColumnVm
    {
        public string Index { get; init; } = string.Empty;
        public string Gt { get; init; } = string.Empty;
        public string Header => string.IsNullOrWhiteSpace(Gt) ? Index : $"{Index} ({Gt})";
    }

    private sealed class MeasureCellVm
    {
        public string Text { get; init; } = string.Empty;
        public bool IsFail { get; init; }
    }

    private sealed class FilmRowVm
    {
        public int Film { get; init; }
        public Dictionary<string, MeasureCellVm> Cells { get; init; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private sealed class RecordVm
    {
        public AirulerFilmMeasureResult Entity { get; init; } = default!;
        public string ThumbnailUrl { get; init; } = string.Empty;
        public string ImageUrl { get; init; } = string.Empty;
        public string JsonUrl { get; init; } = string.Empty;

        public string TimestampLocal => Entity.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

        public List<FilmRowVm> Films { get; init; } = new();
    }

    private List<ModelCardVm> _modelCards = new();
    private string? _selectedModelName;
    private List<RecordVm> _records = new();
    private List<MeasureColumnVm> _measureColumns = new();

    private string? _loadError;
    private string? _modelLoadError;
    private string? _statusMessage;

    private bool _showPreviewModal;
    private RecordVm? _previewRecord;
    private string _previewJson = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private string ResultsRoot => Path.Combine(Env.WebRootPath, "results");

    private static string ThumbUrl(string modelName, string fileName)
        => $"/results/{Uri.EscapeDataString(modelName)}/thumbnail/{Uri.EscapeDataString(fileName)}";

    private static string ImageUrl(string modelName, string fileName)
        => $"/results/{Uri.EscapeDataString(modelName)}/image/{Uri.EscapeDataString(fileName)}";

    private static string JsonUrl(string modelName, string fileName)
        => $"/results/{Uri.EscapeDataString(modelName)}/json/{Uri.EscapeDataString(Path.GetFileNameWithoutExtension(fileName) + ".json")}";

    private string JsonFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, modelName, "json", Path.GetFileNameWithoutExtension(fileName) + ".json");

    private string ModelDirPath(string modelName)
        => Path.Combine(ResultsRoot, modelName);

    private string ImageFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, modelName, "image", fileName);

    private string ThumbnailFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, modelName, "thumbnail", fileName);

    private async Task ReloadAsync()
    {
        _loadError = null;
        _statusMessage = null;

        try
        {
            var all = await Db.AirulerFilmMeasureResults
                .AsNoTracking()
                .ToListAsync();

            _modelCards = all
                .GroupBy(x => x.ModelName, StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var latest = g.OrderByDescending(x => x.TimestampUtc).First();
                    return new ModelCardVm
                    {
                        ModelName = latest.ModelName,
                        FileCount = g.Count(),
                        LatestTimestampUtc = latest.TimestampUtc,
                        RepresentativeThumbnailUrl = ThumbUrl(latest.ModelName, latest.FileName),
                        IsSelectedForDelete = _modelCards.FirstOrDefault(m => string.Equals(m.ModelName, latest.ModelName, StringComparison.OrdinalIgnoreCase))?.IsSelectedForDelete ?? false
                    };
                })
                .OrderByDescending(x => x.LatestTimestampUtc)
                .ThenBy(x => x.ModelName)
                .ToList();

            // 선택된 모델이 그대로 존재하면 상세도 갱신
            if (!string.IsNullOrWhiteSpace(_selectedModelName)
                && _modelCards.Any(m => string.Equals(m.ModelName, _selectedModelName, StringComparison.OrdinalIgnoreCase)))
            {
                await LoadModelAsync(_selectedModelName!);
            }
            else
            {
                _selectedModelName = null;
                _records = new();
                _measureColumns = new();
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _modelCards = new();
        }
    }

    private async Task SelectModelAsync(string modelName)
    {
        _selectedModelName = modelName;
        await LoadModelAsync(modelName);
    }

    private void ClearSelectedModel()
    {
        _selectedModelName = null;
        _records = new();
        _measureColumns = new();
        _modelLoadError = null;
    }

    private async Task LoadModelAsync(string modelName)
    {
        _modelLoadError = null;
        _records = new();
        _measureColumns = new();

        try
        {
            var rows = await Db.AirulerFilmMeasureResults
                .AsNoTracking()
                .Where(x => x.ModelName == modelName)
                .OrderByDescending(x => x.TimestampUtc)
                .ThenByDescending(x => x.Id)
                .ToListAsync();

            var cols = new List<MeasureColumnVm>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            var vms = new List<RecordVm>(rows.Count);
            foreach (var e in rows)
            {
                var films = ParseFilms(e.ResultsJson, cols, seen);
                vms.Add(new RecordVm
                {
                    Entity = e,
                    ThumbnailUrl = ThumbUrl(e.ModelName, e.FileName),
                    ImageUrl = ImageUrl(e.ModelName, e.FileName),
                    JsonUrl = JsonUrl(e.ModelName, e.FileName),
                    Films = films
                });
            }

            _measureColumns = cols;
            _records = vms;
        }
        catch (Exception ex)
        {
            _modelLoadError = ex.Message;
        }
    }

    private static List<FilmRowVm> ParseFilms(string resultsJson, List<MeasureColumnVm> cols, HashSet<string> seen)
    {
        var films = new List<FilmRowVm>();

        if (string.IsNullOrWhiteSpace(resultsJson))
            return films;

        try
        {
            using var doc = JsonDocument.Parse(resultsJson);
            if (doc.RootElement.ValueKind != JsonValueKind.Array)
                return films;

            foreach (var filmEl in doc.RootElement.EnumerateArray())
            {
                var filmNo = 0;
                if (filmEl.TryGetProperty("film", out var fno) && fno.ValueKind == JsonValueKind.Number)
                    fno.TryGetInt32(out filmNo);

                var row = new FilmRowVm { Film = filmNo };

                if (filmEl.TryGetProperty("measures", out var meas) && meas.ValueKind == JsonValueKind.Array)
                {
                    foreach (var m in meas.EnumerateArray())
                    {
                        var idx = GetString(m, "index");
                        if (string.IsNullOrWhiteSpace(idx)) continue;

                        var gtStr = GetNumberAsString(m, "gt");
                        if (!seen.Contains(idx))
                        {
                            cols.Add(new MeasureColumnVm { Index = idx, Gt = gtStr });
                            seen.Add(idx);
                        }

                        var valueStr = GetNumberAsString(m, "value");
                        var errStr = GetNumberAsString(m, "err");
                        var result = GetString(m, "result");
                        var isFail = string.Equals(result, "FAIL", StringComparison.OrdinalIgnoreCase);

                        var text = valueStr;
                        if (!string.IsNullOrWhiteSpace(errStr))
                            text = string.IsNullOrWhiteSpace(valueStr) ? $"({errStr})" : $"{valueStr} ({errStr})";

                        row.Cells[idx] = new MeasureCellVm { Text = text, IsFail = isFail };
                    }
                }

                films.Add(row);
            }
        }
        catch
        {
            // ignore parse error
        }

        return films;
    }

    private static string GetString(JsonElement e, string name)
    {
        if (e.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String)
            return p.GetString() ?? string.Empty;
        return string.Empty;
    }

    private static string GetNumberAsString(JsonElement e, string name)
    {
        if (!e.TryGetProperty(name, out var p)) return string.Empty;

        if (p.ValueKind == JsonValueKind.Number)
        {
            if (p.TryGetDouble(out var d))
                return d.ToString("0.###");
        }
        else if (p.ValueKind == JsonValueKind.String)
        {
            return p.GetString() ?? string.Empty;
        }

        return string.Empty;
    }

    private async Task OpenPreviewAsync(RecordVm record)
    {
        _previewRecord = record;
        _previewJson = string.Empty;
        _showPreviewModal = true;

        try
        {
            var path = JsonFilePath(record.Entity.ModelName, record.Entity.FileName);
            if (System.IO.File.Exists(path))
            {
                _previewJson = await System.IO.File.ReadAllTextAsync(path);
            }
            else
            {
                _previewJson = "(JSON file not found on server.)";
            }
        }
        catch (Exception ex)
        {
            _previewJson = ex.Message;
        }
    }

    private void ClosePreview()
    {
        _showPreviewModal = false;
        _previewRecord = null;
        _previewJson = string.Empty;
    }

    private async Task ConfirmDeleteRecordAsync(long id)
    {
        var target = _records.FirstOrDefault(r => r.Entity.Id == id);
        if (target == null)
            return;

        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete '{target.Entity.FileName}'?\nThis will remove DB row and image/thumbnail/json files.");
        if (!ok)
            return;

        await DeleteRecordAsync(id);
    }

    private async Task DeleteRecordAsync(long id)
    {
        try
        {
            var ent = await Db.AirulerFilmMeasureResults.FirstOrDefaultAsync(x => x.Id == id);
            if (ent == null) return;

            // 파일 삭제
            SafeDeleteFile(ImageFilePath(ent.ModelName, ent.FileName));
            SafeDeleteFile(ThumbnailFilePath(ent.ModelName, ent.FileName));
            SafeDeleteFile(JsonFilePath(ent.ModelName, ent.FileName));

            Db.AirulerFilmMeasureResults.Remove(ent);
            await Db.SaveChangesAsync();

            _statusMessage = $"Deleted: {ent.FileName}";

            // 모델 폴더가 비어있으면 정리
            TryCleanupEmptyModelFolder(ent.ModelName);

            // UI 갱신
            await ReloadAsync();

            if (!string.IsNullOrWhiteSpace(_selectedModelName))
                await LoadModelAsync(_selectedModelName!);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Delete failed: {ex.Message}";
        }
    }

    private async Task ConfirmDeleteSelectedModelsAsync()
    {
        var selected = _modelCards.Where(x => x.IsSelectedForDelete).Select(x => x.ModelName).ToList();
        if (selected.Count == 0) return;

        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete selected model(s): {selected.Count}?\nThis will remove all DB rows and files under /results/{{model}}.");
        if (!ok) return;

        await DeleteModelsAsync(selected);
    }

    private async Task DeleteModelsAsync(List<string> modelNames)
    {
        try
        {
            var rows = await Db.AirulerFilmMeasureResults
                .Where(x => modelNames.Contains(x.ModelName))
                .ToListAsync();

            Db.AirulerFilmMeasureResults.RemoveRange(rows);
            await Db.SaveChangesAsync();

            // 폴더 삭제
            foreach (var m in modelNames)
            {
                var dir = ModelDirPath(m);
                SafeDeleteDirectory(dir);
            }

            _statusMessage = $"Deleted models: {string.Join(", ", modelNames)}";

            // 선택된 모델이 삭제된 경우 UI close
            if (!string.IsNullOrWhiteSpace(_selectedModelName) && modelNames.Any(x => string.Equals(x, _selectedModelName, StringComparison.OrdinalIgnoreCase)))
            {
                ClearSelectedModel();
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Delete models failed: {ex.Message}";
        }
    }

    private void SafeDeleteFile(string path)
    {
        try
        {
            var full = Path.GetFullPath(path);
            var root = Path.GetFullPath(ResultsRoot);
            if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase)) return;

            if (System.IO.File.Exists(full))
                System.IO.File.Delete(full);
        }
        catch
        {
            // ignore
        }
    }

    private void SafeDeleteDirectory(string path)
    {
        try
        {
            var full = Path.GetFullPath(path);
            var root = Path.GetFullPath(ResultsRoot);
            if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase)) return;

            if (Directory.Exists(full))
                Directory.Delete(full, recursive: true);
        }
        catch
        {
            // ignore
        }
    }

    private void TryCleanupEmptyModelFolder(string modelName)
    {
        try
        {
            var modelDir = ModelDirPath(modelName);
            if (!Directory.Exists(modelDir)) return;

            // image/thumbnail/json 모두 비면 삭제
            bool hasFiles = Directory.EnumerateFiles(modelDir, "*", SearchOption.AllDirectories).Any();
            if (!hasFiles)
            {
                SafeDeleteDirectory(modelDir);
            }
        }
        catch
        {
            // ignore
        }
    }
}
