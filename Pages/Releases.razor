@page "/releases"
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations;
@using Microsoft.AspNetCore.Components;
@attribute [Authorize]

@inject IAppUpdateService Updates

<h3>APK Releases</h3>

<AuthorizeView Roles="Admin">
    <Authorized Context="authState">
        <div class="card mb-3">
            <div class="card-header">
                Upload new APK release
            </div>
            <div class="card-body">
                <EditForm Model="_upload" OnValidSubmit="UploadAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label">PackageName</label>
                            <InputText class="form-control" @bind-Value="_upload.PackageName" />
                            <div class="form-text">예: com.hklab.aidetector</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">VersionCode</label>
                            <InputNumber class="form-control" @bind-Value="_upload.VersionCode" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">VersionName</label>
                            <InputText class="form-control" @bind-Value="_upload.VersionName" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">APK file</label>
                        <InputFile OnChange="OnApkSelected" accept=".apk" />
                        @if (_apkFileName != null)
                        {
                            <div class="form-text">
                                Selected: <b>@_apkFileName</b> (@_apkSizeText)
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary" type="submit" disabled="@(!_canUpload)">
                            @( _uploading ? "Uploading..." : "Upload" )
                        </button>

                        <button class="btn btn-outline-secondary ms-2" type="button" @onclick="ReloadAsync" disabled="@(_uploading)">
                            Refresh list
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_uploadMessage))
                    {
                        <div class="alert alert-info mt-3">@_uploadMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_uploadError))
                    {
                        <div class="alert alert-danger mt-3">@_uploadError</div>
                    }
                </EditForm>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="alert alert-warning">
            업로드는 <b>Admin</b> 권한 사용자만 가능합니다.
            (테스트 중이면 Roles 제한을 빼거나, 계정에 Admin Role을 부여하세요.)
        </div>
    </NotAuthorized>
</AuthorizeView>

<p class="text-muted">
    Storage: <code>@Updates.RootPath</code>
</p>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_rows.Count == 0)
{
    <p>업로드된 릴리즈가 없습니다.</p>
}
else
{
    @foreach (var pkg in _rows.GroupBy(x => x.PackageName).OrderBy(g => g.Key))
    {
        <h5 class="mt-4">@pkg.Key</h5>

        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>VersionCode</th>
                    <th>VersionName</th>
                    <th>Uploaded (Local)</th>
                    <th>Size</th>
                    <th>SHA-256</th>
                    <th>Links</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in pkg.OrderByDescending(x => x.VersionCode))
                {
                    <tr>
                        <td>@r.VersionCode</td>
                        <td>@r.VersionName</td>
                        <td>@r.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@FormatBytes(r.Size)</td>
                        <td><code>@ShortHash(r.Sha256)</code></td>
                        <td>
                            <a href="@GetApkUrl(r)" target="_blank">APK</a>
                            |
                            <a href="@GetJsonUrl(r)" target="_blank">JSON</a>
                            |
                            <a href="@GetLatestUrl(r.PackageName)" target="_blank">Latest</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}


@code {
    // 리스트
    protected bool _loading = true;
    protected List<ReleaseInfo> _rows = new();

    // 업로드 폼
    protected UploadModel _upload = new UploadModel();
    protected bool _uploading = false;
    protected string? _uploadMessage;
    protected string? _uploadError;

    protected IBrowserFile? _apk;
    protected string? _apkFileName;
    protected string? _apkSizeText;

    // 업로드 가능 여부
    protected bool _canUpload =>
        !_uploading &&
        _apk != null &&
        !string.IsNullOrWhiteSpace(_upload.PackageName) &&
        _upload.VersionCode > 0;

    // Blazor InputFile 기본은 매우 작습니다(기본 512KB). 반드시 maxAllowedSize를 크게 지정하세요. :contentReference[oaicite:1]{index=1}
    private const long MaxAllowedSize = 1024L * 1024L * 1024L; // 1GB (필요시 조정)

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    protected async Task ReloadAsync()
    {
        _loading = true;
        _rows = (await Updates.GetAllAsync()).ToList();
        _loading = false;
    }

    protected Task OnApkSelected(InputFileChangeEventArgs e)
    {
        _apk = e.File;
        _apkFileName = _apk?.Name;
        _apkSizeText = _apk == null ? null : FormatBytes((long)_apk.Size);

        _uploadMessage = null;
        _uploadError = null;

        return Task.CompletedTask;
    }

    protected async Task UploadAsync()
    {
        _uploadMessage = null;
        _uploadError = null;

        if (_apk == null)
        {
            _uploadError = "APK 파일을 선택하세요.";
            return;
        }

        try
        {
            _uploading = true;

            // IBrowserFile → Stream
            await using var stream = _apk.OpenReadStream(MaxAllowedSize);

            // ✅ 서버 서비스로 바로 저장(HTTP API 호출 안 함)
            var saved = await Updates.SaveAsync(
                _upload.PackageName.Trim(),
                _upload.VersionCode,
                _upload.VersionName ?? "",
                _apk.Name,
                stream,
                (long)_apk.Size);

            _uploadMessage = $"업로드 완료: {saved.PackageName} / {saved.VersionCode} ({saved.VersionName}), {FormatBytes(saved.Size)}";

            // 업로드 후 목록 갱신
            await ReloadAsync();

            // 파일 선택 상태 초기화(선택)
            _apk = null;
            _apkFileName = null;
            _apkSizeText = null;
        }
        catch (Exception ex)
        {
            _uploadError = "업로드 실패: " + ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    // 목록용 유틸
    protected static string ShortHash(string sha256)
    {
        if (string.IsNullOrWhiteSpace(sha256)) return "";
        return sha256.Length <= 12 ? sha256 : sha256.Substring(0, 12) + "...";
    }

    protected static string FormatBytes(long bytes)
    {
        const double KB = 1024.0;
        const double MB = 1024.0 * 1024.0;
        const double GB = 1024.0 * 1024.0 * 1024.0;

        if (bytes < 0) return "?";
        if (bytes < 1024) return bytes + " B";
        if (bytes < (long)MB) return (bytes / KB).ToString("0.0") + " KB";
        if (bytes < (long)GB) return (bytes / MB).ToString("0.0") + " MB";
        return (bytes / GB).ToString("0.00") + " GB";
    }

    protected static string GetApkUrl(ReleaseInfo r)
        => "/api/releases/apk/" + r.PackageName + "/" + r.VersionCode;

    protected static string GetJsonUrl(ReleaseInfo r)
        => "/api/releases/metadata/" + r.PackageName + "/" + r.VersionCode;

    protected static string GetLatestUrl(string packageName)
        => "/api/releases/latest/" + packageName;

    // 업로드 폼 모델
    public class UploadModel
    {
        [Required]
        public string PackageName { get; set; } = "";

        [Range(1, int.MaxValue)]
        public int VersionCode { get; set; } = 1;

        public string VersionName { get; set; } = "1.0.0";
    }
}
