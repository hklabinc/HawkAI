    private async Task ExecuteCopyFromModal()
    {
        if (copySourceProject == null)
        {
            await JS.InvokeVoidAsync("alert", "❌ No source project selected for copy.");
            return;
        }

        var source = await Db.Projects.Include(p => p.Images).FirstOrDefaultAsync(p => p.Id == copySourceProject.Id);
        if (source == null)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Source project '{copySourceProject.Name}' not found.");
            return;
        }

        if (Db.Projects.Any(p => p.Name == mergeProjectName))
        {
            await JS.InvokeVoidAsync("alert", $"❌ A project named '{mergeProjectName}' already exists.");
            return;
        }

        var newProj = new Project
        {
            Name = mergeProjectName,
            Labels = source.Labels,
            CreatorUserId = userId,
            ImageCount = source.Images.Count
        };
        await ProjectService.CreateProject(newProj);

        var newDir = Path.Combine(Env.WebRootPath, "datasets", newProj.Name);
        var imgDir = Path.Combine(newDir, "images");
        var lblDir = Path.Combine(newDir, "labels");
        var annDir = Path.Combine(newDir, "images_annotated");
        Directory.CreateDirectory(imgDir);
        Directory.CreateDirectory(lblDir);
        Directory.CreateDirectory(annDir);

        foreach (var entry in source.Images)
        {
            var newFile = entry.FileName;
            var srcPath = Path.Combine(Env.WebRootPath, entry.RelativePath);
            var newPath = Path.Combine(imgDir, newFile);
            if (File.Exists(srcPath))
            {
                File.Copy(srcPath, newPath, overwrite: false);
            }

            Db.Images.Add(new ImageEntry
            {
                ProjectId = newProj.Id,
                FileName = newFile,
                RelativePath = $"datasets/{newProj.Name}/images/{newFile}",
                UploadedAt = DateTime.Now,
                UploadedByUserId = userId,
                Width = entry.Width,
                Height = entry.Height,
                LabelStatus = entry.LabelStatus,
                LabelData = entry.LabelData
            });

            // label 파일 복사
            var labelSrc = Path.Combine(Env.WebRootPath, "datasets", source.Name, "labels", Path.ChangeExtension(entry.FileName, ".txt"));
            var labelDest = Path.Combine(lblDir, Path.GetFileName(labelSrc));
            if (File.Exists(labelSrc)) File.Copy(labelSrc, labelDest, false);

            // annotated 이미지 복사
            var annSrc = Path.Combine(Env.WebRootPath, "datasets", source.Name, "images_annotated", entry.FileName);
            var annDest = Path.Combine(annDir, entry.FileName);
            if (File.Exists(annSrc)) File.Copy(annSrc, annDest, false);
        }

        // 카메라 설정 복사
        var camSrc = Path.Combine(Env.WebRootPath, "datasets", source.Name, "camera.json");
        var camDest = Path.Combine(newDir, "camera.json");
        if (File.Exists(camSrc)) File.Copy(camSrc, camDest, false);

        await Db.SaveChangesAsync();
        await ReloadProjects();

        showMergeModal = false;
        isCopyMode = false;
        copySourceProject = null;

        await JS.InvokeVoidAsync("alert", $"✅ Project '{mergeProjectName}' copied successfully.");
    }


    private void CopyDirectory(string sourceDir, string destinationDir)
    {
        Directory.CreateDirectory(destinationDir);
        foreach (var file in Directory.GetFiles(sourceDir))
        {
            var destFile = Path.Combine(destinationDir, Path.GetFileName(file));
            File.Copy(file, destFile, overwrite: false);
        }
        foreach (var dir in Directory.GetDirectories(sourceDir))
        {
            CopyDirectory(dir, Path.Combine(destinationDir, Path.GetFileName(dir)));
        }
    }

    private void PrepareMerge()
    {
        var selected = projects.Where(p => p.IsSelectedForMerge).ToList();        
        if (selected.Count <= 1)
        {
            JS.InvokeVoidAsync("alert", "⚠️ Please select at least two projects to merge.");
            return;
        }

        var baseNames = selected.Select(p => p.Name).ToList();
        mergeProjectName = string.Join("-", baseNames);

        var labelSet = new HashSet<string>();
        foreach (var proj in selected)
        {
            var labels = proj.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries);
            foreach (var l in labels) labelSet.Add(l.Trim());
        }
        mergeLabels = string.Join(", ", labelSet);
        showMergeModal = true;
    }

    private async Task ExecuteMerge()
    {
        if (isCopyMode)
        {
            await ExecuteCopyFromModal();
            return;
        }

        // ✅ 1. ViewModel에서 선택된 프로젝트 확인
        var selectedProjectVMs = projects.Where(p => p.IsSelectedForMerge).ToList();        

        // ✅ 2. 이름 중복 확인
        if (Db.Projects.Any(p => p.Name == mergeProjectName))
        {
            await JS.InvokeVoidAsync("alert", $"❌ A project named '{mergeProjectName}' already exists. Please choose a different name.");
            return;
        }

        // ✅ 3. 새 프로젝트 생성
        var newProj = new Project
            {
                Name = mergeProjectName,
                Labels = mergeLabels,
                CreatorUserId = userId,
                ImageCount = 0
            };
        await ProjectService.CreateProject(newProj);

        // ✅ 4. 폴더 준비
        var newDir = Path.Combine(Env.WebRootPath, "datasets", newProj.Name);
        var imgDir = Path.Combine(newDir, "images");
        var lblDir = Path.Combine(newDir, "labels");
        var annDir = Path.Combine(newDir, "images_annotated");
        Directory.CreateDirectory(imgDir);
        Directory.CreateDirectory(lblDir);
        Directory.CreateDirectory(annDir);

        // ✅ 5. 중복 제거용 Set
        var addedFileNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var skippedFiles = new List<string>();

        // ✅ 6. 실제 Project 목록 조회
        var allProjects = isAdmin
            ? await ProjectService.GetAllProjects()
            : await ProjectService.GetUserProjects(userId);
        var selectedProjects = allProjects
            .Where(p => selectedProjectVMs.Any(vm => vm.Id == p.Id))
            .ToList();

        foreach (var proj in selectedProjects)
        {
            var imageEntries = await Db.Images.Where(img => img.ProjectId == proj.Id).ToListAsync();
            foreach (var entry in imageEntries)
            {
                string originalFileName = entry.FileName;
                string uniqueFileName = originalFileName;

                if (!addedFileNames.Add(uniqueFileName))
                {
                    if (allowDuplicateMerge)
                    {
                        int suffix = 1;
                        var name = Path.GetFileNameWithoutExtension(originalFileName);
                        var ext = Path.GetExtension(originalFileName);

                        while (!addedFileNames.Add(uniqueFileName))
                        {
                            uniqueFileName = $"{name}_{suffix}{ext}";
                            suffix++;
                        }
                    }
                    else
                    {
                        skippedFiles.Add(originalFileName);
                        continue;
                    }
                }

                // 이미지 복사
                var src = Path.Combine(Env.WebRootPath, entry.RelativePath);
                var dest = Path.Combine(imgDir, entry.FileName);
                if (File.Exists(src))
                {
                    if (File.Exists(dest))
                    {
                        if (allowDuplicateMerge)
                        {
                            int suffix = 1;
                            var name = Path.GetFileNameWithoutExtension(uniqueFileName);
                            var ext = Path.GetExtension(uniqueFileName);

                            string newDest;
                            do
                            {
                                uniqueFileName = $"{name}_{suffix}{ext}";
                                newDest = Path.Combine(imgDir, uniqueFileName);
                                suffix++;
                            }
                            while (File.Exists(newDest) || addedFileNames.Contains(uniqueFileName));

                            dest = newDest;
                            addedFileNames.Add(uniqueFileName);
                        }
                        else
                        {
                            skippedFiles.Add(uniqueFileName);
                            continue;
                        }
                    }

                    File.Copy(src, dest, overwrite: false);
                }


                // DB에 이미지 추가
                var newEntry = new ImageEntry
                    {
                        ProjectId = newProj.Id,
                        FileName = entry.FileName,
                        RelativePath = $"datasets/{newProj.Name}/images/{entry.FileName}",
                        UploadedAt = DateTime.Now,
                        UploadedByUserId = userId,
                        Width = entry.Width,
                        Height = entry.Height,
                        LabelStatus = entry.LabelStatus,
                        LabelData = entry.LabelData
                    };
                Db.Images.Add(newEntry);

                // 라벨 파일 복사
                var labelSrc = Path.Combine(Env.WebRootPath, "datasets", proj.Name, "labels", Path.ChangeExtension(entry.FileName, ".txt"));
                var labelDest = Path.Combine(lblDir, Path.GetFileName(labelSrc));
                if (File.Exists(labelSrc))
                    File.Copy(labelSrc, labelDest, overwrite: false);

                // annotated 이미지 복사
                var annSrc = Path.Combine(Env.WebRootPath, "datasets", proj.Name, "images_annotated", entry.FileName);
                var annDest = Path.Combine(annDir, entry.FileName);  // 초기 경로

                if (File.Exists(annSrc))
                {
                    string annFinalName = uniqueFileName; // images 복사에 사용된 이름 기준으로 시작
                    annDest = Path.Combine(annDir, annFinalName);    // ← 기존 annDest 변수에 덮어쓰기

                    if (File.Exists(annDest))
                    {
                        if (allowDuplicateMerge)
                        {
                            int suffix = 1;
                            var name = Path.GetFileNameWithoutExtension(annFinalName);
                            var ext = Path.GetExtension(annFinalName);

                            do
                            {
                                annFinalName = $"{name}_{suffix}{ext}";
                                annDest = Path.Combine(annDir, annFinalName);
                                suffix++;
                            }
                            while (File.Exists(annDest));
                        }
                        else
                        {
                            continue; // 병합 허용 안 하면 건너뜀
                        }
                    }

                    File.Copy(annSrc, annDest, overwrite: false);
                }

            }
        }

        // ✅ 7. 이미지 수 업데이트
        newProj.ImageCount = addedFileNames.Count;
        Db.Projects.Update(newProj);

        // ✅ 7.1 가장 최근 camera.json 복사
        var cameraJsonCandidates = selectedProjects
            .Select(p => Path.Combine(Env.WebRootPath, "datasets", p.Name, "camera.json"))
            .Where(File.Exists)
            .Select(path => new FileInfo(path))
            .OrderByDescending(f => f.LastWriteTime)
            .ToList();

        if (cameraJsonCandidates.Count > 0)
        {
            var selectedCameraJson = cameraJsonCandidates.First();
            var destPath = Path.Combine(newDir, "camera.json");
            File.Copy(selectedCameraJson.FullName, destPath, overwrite: false);
        }

        await Db.SaveChangesAsync();

        // ✅ 8. 병합 후 상태 업데이트
        showMergeModal = false;
        await ReloadProjects();

        // ✅ 9. 중복된 파일 경고
        if (skippedFiles.Any() || cameraJsonCandidates.Count > 1)
        {
            var message = "";

            if (skippedFiles.Any())
            {
                message += $"⚠️ {skippedFiles.Count} duplicated file(s) were skipped:\n" +
                           string.Join("\n", skippedFiles);
            }

            if (allowDuplicateMerge)
            {
                message = $"✅ Duplicate filenames were auto-renamed and merged.\n";
            }

            if (cameraJsonCandidates.Count > 1)
            {
                var selectedFrom = Path.GetFileName(Path.GetDirectoryName(cameraJsonCandidates.First().FullName));
                message += $"\n📷 Multiple camera.json files found.\nThe one from '{selectedFrom}' was used.";
            }

            await JS.InvokeVoidAsync("alert", message);
        }

    }


