@page "/projects"
@inject HawkAI.Data.ProjectService.IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Env
@inject DataDbContext Db
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client;
@using System.Text.Json
@using System.IO.Compression
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.PixelFormats
@using SixLabors.ImageSharp.Processing

<h4>Project Manager (@projects.Count)</h4>

<div class="d-flex gap-2 mb-3">
    <button @onclick="() => showCreateModal = true" class="btn btn-primary"><span class="oi oi-plus"></span> Create New Project</button>
    <button class="btn btn-success" @onclick="PrepareMerge"><span class="oi oi-transfer"></span> Project Merge</button>
    <button class="btn btn-danger" @onclick="ConfirmBulkDelete" title="Delete selected projects"><span class="oi oi-trash"></span> Delete Selected</button>
</div>

@if (projects == null)
{
    <p><em>Loading...</em></p>
}
else if (projects.Count == 0)
{
    <p>No projects found.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var p in projects)
        {
            <div class="card" style="width: 320px;">
                @if (p.Images.Count > 0)
                {
                    string displayPath;

                    var labeledImage = p.Images.FirstOrDefault(img => img.LabelStatus == "Labeled");
                    if (labeledImage != null)
                    {
                        // 라벨링된 이미지가 존재하면 annotated 폴더 경로 사용
                        var fileName = Path.GetFileName(labeledImage.RelativePath);
                        displayPath = $"/datasets/{p.Name}/images_annotated/{fileName}";
                    }
                    else
                    {
                        // 아니면 기본 images 폴더의 첫 번째 이미지 사용
                        displayPath = "/" + p.Images.First().RelativePath;
                    }

                    int labeled = p.Images.Count(img => img.LabelStatus == "Labeled");
                    int total = p.Images.Count;
                    int percent = (int)Math.Round((double)labeled / total * 100);

                    <span class="@((percent == 100 ? "badge bg-success" : "badge border border-success text-success bg-white")) position-absolute top-0 start-0 m-2" style="z-index: 1;">
                        @percent%
                    </span>

                    <img src="@displayPath"
                         class="card-img-top"
                         style="height: 180px; object-fit: cover; cursor: pointer;"
                         @onclick="() => OpenProject(p.Id)" />
                }
                <div class="card-body">
                    <h5 class="card-title mb-1">
                        <strong>@p.Name</strong>
                        <span class="text-muted" style="font-size: 0.95rem;">
                            (@p.Images.Count)
                        </span>
                    </h5>
                    <p class="card-text mb-0">Labels: @p.Labels</p>

                    <p class="card-text text-muted" style="font-size: 0.85rem;">
                        Created @GetRelativeTime(p.CreatedAt)
                        @if (isAdmin)
                        {
                            <text> by @p.CreatorUserId</text>
                        }
                    </p>
                    

                    <!-- 카드 우측 상단 Merge 체크박스 -->
                    <div class="position-absolute top-0 end-0 m-2">
                        <input type="checkbox" @bind="p.IsSelectedForMerge" class="form-check-input" id="mergeCheck_@p.Id" />
                    </div>

                    <!-- 버튼 행 -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap mt-2">

                        <!-- 왼쪽: Edit / Delete (간격 좁게) -->
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(p)">Edit</button>
                            @if (HasCameraInfo(p.Name))
                            {
                                <button class="btn btn-sm btn-outline-warning px-0" @onclick="() => ShowCameraInfo(p.Name)">Cam Info</button>
                            }
                            @if (projectHasModelMap.TryGetValue(p.Name, out var hasModels) && hasModels)
                            {
                                <button class="btn btn-sm btn-outline-success px-1" @onclick="() => ShowModelFolders(p.Name)">Models</button>
                            }
                        </div>

                        <!-- 오른쪽: Export / Augment / Train (간격 약간, 우측 정렬) -->
                        <div class="d-flex ms-auto">
                            <button class="btn btn-sm btn-outline-dark me-1" title="Export" @onclick="() => OpenExportModal(p.Id)">
                                <span class="oi oi-data-transfer-download"></span>
                            </button>
                            <button class="btn btn-sm btn-outline-dark" title="Train" @onclick="() => OpenTrainModal(p.Id)">
                                <span class="oi oi-cog"></span>
                            </button>
                        </div>
                    </div>


                </div>
            </div>
        }
    </div>
}

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Create New Project</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="newProjectName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (comma-separated)</label>
                        <input class="form-control" @bind="labelInput" placeholder="e.g., person, car, dog" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Upload Images</label>
                        <InputFile OnChange="HandleImageUpload" multiple MaxFiles="500" />
                        @if (createUploadedFiles.Count > 0)
                        {
                            <ul>
                                @foreach (var file in createUploadedFiles)
                                {
                                    <li>@file.Name</li>
                                }
                            </ul>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateProject">Create</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Project - @selectedProject?.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage2))
                    {
                        <div class="alert alert-danger">@errorMessage2</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="editingProject.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (comma-separated)</label>
                        <input class="form-control" @bind="editingProject.Labels" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Add Images</label>
                        <InputFile OnChange="HandleFileUpload" multiple MaxFiles="500" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showEditModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveProjectEdits">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showMergeModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Merge Selected Projects</h5>
                    <button type="button" class="btn-close" @onclick="() => showMergeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Merged Project Name</label>
                        <input class="form-control" @bind="mergeProjectName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (merged)</label>
                        <textarea class="form-control" rows="3" readonly>@mergeLabels</textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showMergeModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="ExecuteMerge">Merge</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showBulkDeleteConfirm)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Selected Projects</h5>
                    <button type="button" class="btn-close" @onclick="() => showBulkDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the following projects?</p>
                    <ul>
                        @foreach (var p in projects.Where(p => p.IsSelectedForMerge))
                        {
                            <li>@p.Name</li>
                        }
                    </ul>
                    <p class="text-danger">This will delete all associated images and files permanently.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showBulkDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteBulkDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showExportModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Export and Augmentation - @selectedProject?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showExportModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Image Size</label>
                        <select class="form-select" @bind="selectedImageSize">
                            <option value="640">640 x 640</option>
                            <option value="512">512 x 512</option>
                            <option value="416">416 x 416</option>
                            <option value="320">320 x 320</option>
                        </select>
                    </div>

                    <!-- ✅ Validation Ratio -->
                    <div class="mb-3">
                        <label class="form-label">Validation Ratio: @($"{validRatioInt}%")</label>
                        <input type="range" class="form-range" min="10" max="50" step="5" @bind="validRatioInt" />
                    </div>

                    <!-- ✅ Augmentation Multiplier -->
                    <div class="mb-3">
                        <label class="form-label">
                            Augmentation Multiplier
                            @if (selectedProject?.ImageCount > 0)
                            {
                                <span class="text-muted">(recommended ≥ @recommendedAugMultiplier)</span>
                            }
                        </label>
                        <input type="number" class="form-control" @bind="augMultiplier" min="1" max="40" />
                    </div>

                    <!-- ✅ Seed -->
                    <div class="mb-3">
                        <label class="form-label">Seed Value (optional)</label>
                        <input type="number" class="form-control" @bind="augmentSeed" placeholder="e.g. 42" />
                    </div>

                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="autoDownload" @bind="enableAutoDownload" />
                        <label class="form-check-label" for="autoDownload">
                            Automatically download ZIP after export
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(augmentStatusMessage))
                    {
                        <div class="alert alert-info mt-2">@augmentStatusMessage</div>
                    }
                </div>


                @* @if (!string.IsNullOrWhiteSpace(augmentStatusMessage))
                {
                    <div class="alert alert-info">@augmentStatusMessage</div>
                } *@

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showExportModal = false">Close</button>
                    <button class="btn btn-primary" @onclick="() => Export(exportProjectId)">Export</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showTrainModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Train Model - @selectedProject?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showTrainModal = false"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Export Path:</strong> /exports/@selectedProject?.Name</p>
                    <div class="mb-3">
                        <label class="form-label">Model Size</label>
                        <select class="form-select" @bind="trainModelSize">
                            <option value="nano">Nano</option>
                            <option value="small">Small</option>
                            <option value="medium">Medium</option>
                            <option value="large">Large</option>
                            <option value="xlarge">X-Large</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Epochs</label>
                        <input type="number" class="form-control" @bind="trainEpochs" min="1" max="1000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Batch Size</label>
                        <input type="number" class="form-control" @bind="trainBatch" min="1" max="128" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Server</label>
                        <select class="form-select" @bind="selectedTrainServer">
                            <option value="http://localhost:9002">HawkAI</option>
                            <option value="http://ictrobot.hknu.ac.kr:9002" disabled>ICTRobot</option>
                            <option value="http://sons.hknu.ac.kr:9003" disabled>Com3090</option>
                            <option value="http://sons.hknu.ac.kr:9002" disabled>Com4090</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Seed (Optional)</label>
                        <input type="number" class="form-control" @bind="trainSeed" placeholder="e.g. 42" />
                    </div>

                    <div class="alert alert-info" role="alert">
                        @trainStatusMessage
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showTrainModal = false">Close</button>
                    <button class="btn btn-primary" @onclick="TriggerTrain">Start Training</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showCameraModal)
