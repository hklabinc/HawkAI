    {
        var selected = projects.Where(p => p.IsSelectedForMerge).ToList();

        if (selected.Count == 0)
        {
            JS.InvokeVoidAsync("alert", "⚠️ Please select at least one project to copy or merge.");
            return;
        }

        if (selected.Count == 1)
        {
            PrepareCopy(selected.First());
        }
        else
        {
            PrepareMerge();
        }
    }

