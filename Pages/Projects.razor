    private string GetRelativeTime(DateTime createdAt)
    {
        var now = DateTime.Now;
        var span = now - createdAt;

        if (span.TotalSeconds < 60)
            return "just now";
        if (span.TotalMinutes < 60)
            return $"{(int)span.TotalMinutes} minutes ago";
        if (span.TotalHours < 24)
            return $"{(int)span.TotalHours} hours ago";
        if (span.TotalDays < 7)
            return $"{(int)span.TotalDays} days ago";

        return createdAt.ToString("yyyy-MM-dd");
    }


    private void OpenAugmentModal(int projectId)
    {
        selectedProject = projects.FirstOrDefault(p => p.Id == projectId);
        augmentStatusMessage = string.Empty;
        showAugmentModel = true;
    }

    public class ServerResponse
    {
        public string status { get; set; } = "";
        public string session_id { get; set; } = "";
        public string message { get; set; } = "";
    }

    [Inject] private HttpClient Http { get; set; } = default!;
    private async Task TriggerAugment()
    {
        if (selectedProject == null) return;

        var exportDir = Path.Combine(Env.WebRootPath, "exports", selectedProject.Name);
        if (!Directory.Exists(exportDir))
        {
            augmentStatusMessage = "❌ Export folder not found.";
            return;
        }

        var payload = new Dictionary<string, object>
        {
            { "project_name", selectedProject.Name },
            { "base_dir", exportDir },
            { "valid_ratio", validRatio },
            { "n", augMultiplier }
        };

        if (augmentSeed.HasValue)
        {
            payload["seed"] = augmentSeed.Value;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:9001/api/augment", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ServerResponse>();
                augmentStatusMessage = result?.status == "success"
                    ? $"✅ {result.message}"
                    : $"❌ Unexpected response format.";
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ServerResponse>();
                augmentStatusMessage = result != null
                    ? $"❌ {result.message}"
                    : $"❌ Augmentation failed with status code {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            augmentStatusMessage = $"❌ Failed to contact augmentation server: {ex.Message}";
        }
    }


    private void OpenTrainModal(int projectId)
    {
        selectedProject = projects.FirstOrDefault(p => p.Id == projectId);
        trainStatusMessage = string.Empty;
        showTrainModal = true;
    }

    private async Task TriggerTrain()
    {
        if (selectedProject == null)
        {
            trainStatusMessage = "❌ No project selected.";
            return;
        }

        var exportDir = Path.Combine(Env.WebRootPath, "exports", selectedProject.Name);
        if (!Directory.Exists(exportDir))
        {
            trainStatusMessage = $"❌ Export folder not found: {exportDir}";
            return;
        }

        var payload = new Dictionary<string, object>
        {
            { "project_name", selectedProject.Name },
            { "base_dir", exportDir },
            { "model_size", trainModelSize },
            { "epochs", trainEpochs },
            { "batch", trainBatch }
        };

        if (trainSeed.HasValue)
            payload["seed"] = trainSeed.Value;

        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:9002/api/train", payload);

            if (!response.IsSuccessStatusCode)
            {
                trainStatusMessage = $"❌ Training server error: {response.StatusCode}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ServerResponse>();

            if (result?.status == "success" && !string.IsNullOrWhiteSpace(result.session_id))
            {
                var sessionId = result.session_id;

                // Start SSE for progress updates
                sseRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("trainStatusStream.start", sessionId, sseRef);
            }
            else
            {
                trainStatusMessage = result?.message ?? "❌ Unknown error from training server.";
            }
        }
        catch (Exception ex)
        {
            trainStatusMessage = $"❌ Failed to contact training server: {ex.Message}";
        }
    }

