@page "/projects"
@inject HawkAI.Data.ProjectService.IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Env
@inject DataDbContext Db
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client;
@using System.Text.Json
@using System.IO.Compression
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.PixelFormats
@using SixLabors.ImageSharp.Processing
@using HawkAI.Services
@using System.Text.RegularExpressions;

<h4>Project Manager (@projects.Count)</h4>

<div class="d-flex gap-2 mb-3">
    <button @onclick="() => showCreateModal = true" class="btn btn-primary"><span class="oi oi-plus"></span> Create New Project</button>
    <button class="btn btn-success" @onclick="PrepareCopyOrMerge"><span class="oi oi-transfer"></span> Copy / Merge</button>
    <button class="btn btn-danger" @onclick="ConfirmBulkDelete" title="Delete selected projects"><span class="oi oi-trash"></span> Delete Selected</button>
</div>

@if (projects == null)
{
    <p><em>Loading...</em></p>
}
else if (projects.Count == 0)
{
    <p>No projects found.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @{
            string? lastUserId = null;
        }

        @foreach (var p in projects)
        {
            // ✅ 사용자 ID가 바뀌면 <hr /> 삽입 (단, 처음은 제외)
            if (lastUserId != null && lastUserId != p.CreatorUserId)
            {
                <hr class="w-100 my-3 border-top border-3 border-dark" />
            }
            lastUserId = p.CreatorUserId;

            <div class="card" style="width: 320px;">
                @if (p.Images.Count > 0)
                {
                    string displayPath;

                    var labeledImage = p.Images.FirstOrDefault(img => img.LabelStatus == "Labeled");
                    if (labeledImage != null)
                    {
                        // 라벨링된 이미지가 존재하면 annotated 폴더 경로 사용
                        var fileName = Path.GetFileName(labeledImage.RelativePath);
                        displayPath = $"/datasets/{p.Name}/images_annotated/{fileName}";
                    }
                    else
                    {
                        // 아니면 기본 images 폴더의 첫 번째 이미지 사용
                        displayPath = "/" + p.Images.First().RelativePath;
                    }

                    int labeled = p.Images.Count(img => img.LabelStatus == "Labeled");
                    int total = p.Images.Count;
                    int percent = (int)Math.Round((double)labeled / total * 100);

                    <span class="@((percent == 100 ? "badge bg-success" : "badge border border-success text-success bg-white")) position-absolute top-0 start-0 m-2" style="z-index: 1;">
                        @percent%
                    </span>

                    <img src="@displayPath"
                         class="card-img-top"
                         style="height: 180px; object-fit: cover; cursor: pointer;"
                         @onclick="() => OpenProject(p.Id)" />
                }
                <div class="card-body">
                    <h5 class="card-title mb-1">
                        <strong>@p.Name</strong>
                        <span class="text-muted" style="font-size: 0.95rem;">
                            (@p.Images.Count)
                        </span>
                    </h5>
                    <p class="card-text mb-0">Labels: @p.Labels</p>

                    <p class="card-text text-muted" style="font-size: 0.85rem;">
                        Created @GetRelativeTime(p.CreatedAt)
                        @if (isAdmin)
                        {
                            <text> by @p.CreatorUserId</text>
                        }
                    </p>
                    

                    <!-- 카드 우측 상단 Merge 체크박스 -->
                    <div class="position-absolute top-0 end-0 m-2">
                        <input type="checkbox" @bind="p.IsSelectedForMerge" class="form-check-input" id="mergeCheck_@p.Id" />
                    </div>

                    <!-- 버튼 행 -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap mt-2">

                        <!-- 왼쪽: Edit / Delete (간격 좁게) -->
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(p)">Edit</button>
                            @if (HasCameraInfo(p.Name))
                            {
                                <button class="btn btn-sm btn-outline-warning px-0" @onclick="() => ShowCameraInfo(p.Name)">Cam Info</button>
                            }
                            @if (projectHasModelMap.TryGetValue(p.Name, out var hasModels) && hasModels)
                            {
                                <button class="btn btn-sm btn-outline-success px-1" @onclick="() => ShowModelFolders(p.Name)">Models</button>
                            }
                        </div>

                        <!-- 오른쪽: Export / Augment / Train (간격 약간, 우측 정렬) -->
                        <div class="d-flex ms-auto">
                            <button class="btn btn-sm btn-outline-dark me-1" title="Export" @onclick="() => OpenExportModal(p.Id)">
                                <span class="oi oi-data-transfer-download"></span>
                            </button>
                            <button class="btn btn-sm btn-outline-dark" title="Train" @onclick="() => OpenTrainModal(p.Id)">
                                <span class="oi oi-cog"></span>
                            </button>
                        </div>
                    </div>


                </div>
            </div>
        }
    </div>
}

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Create New Project</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="newProjectName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (comma-separated)</label>
                        <input class="form-control" @bind="labelInput" placeholder="e.g., film, good, bad" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Upload Images</label>
                        <InputFile OnChange="HandleImageUpload" multiple MaxFiles="500" />
                        @if (createUploadedFiles.Count > 0)
                        {
                            <ul>
                                @foreach (var file in createUploadedFiles)
                                {
                                    <li>@file.Name</li>
                                }
                            </ul>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateProject">Create</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Project - @editingProject?.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage2))
                    {
                        <div class="alert alert-danger">@errorMessage2</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="editingProject.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (comma-separated)</label>
                        <input class="form-control" @bind="editingProject.Labels" />
                    </div>
                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label">Creator User ID</label>
                            <input class="form-control" @bind="editingProject.CreatorUserId" />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Add Images</label>
                        <InputFile OnChange="HandleFileUpload" multiple MaxFiles="500" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showEditModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveProjectEdits">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showMergeModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">@((isCopyMode ? "Copy Project" : "Merge Selected Projects"))</h5>
                    <button type="button" class="btn-close" @onclick="() => showMergeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Merged Project Name</label>
                        <input class="form-control" @bind="mergeProjectName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (merged)</label>
                        <textarea class="form-control" rows="3" readonly>@mergeLabels</textarea>
                    </div>
                    @if (!isCopyMode)
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="allowDuplicates" @bind="allowDuplicateMerge" />
                            <label class="form-check-label" for="allowDuplicates">
                                Allow merging duplicate filenames (auto rename with _1, _2...)
                            </label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showMergeModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="ExecuteMerge">@((isCopyMode ? "Copy" : "Merge"))</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showBulkDeleteConfirm)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Selected Projects</h5>
                    <button type="button" class="btn-close" @onclick="() => showBulkDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the following projects?</p>
                    <ul>
                        @foreach (var p in projects.Where(p => p.IsSelectedForMerge))
                        {
                            <li>@p.Name</li>
                        }
                    </ul>
                    <p class="text-danger">This will delete all associated images and files permanently.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showBulkDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteBulkDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showExportModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Export and Augmentation - @selectedProject?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showExportModal = false"></button>
                </div>

                <div class="modal-body position-relative">

                    @* ✅ 로딩 중일 때 덮는 오버레이 *@
                    @if (isExporting)
                    {
                        <div style="
                            position: absolute;
                            top: 0; left: 0;
                            width: 100%; height: 100%;
                            background: rgba(255,255,255,0.5);
                            z-index: 10;
                            display: flex;
                            justify-content: center;
                            align-items: center;">
                            <img src="/img/loading.gif" alt="Loading..." style="height: 60px;" />
                        </div>
                    }

                    @* ✅ 실제 입력 폼 내용 (로딩 시 반투명 처리) *@
                    <div style="position: relative; z-index: 1; opacity:@(isExporting ? "0.5" : "1")">

                        <div class="mb-3">
                            <label class="form-label">Image Size</label>
                            <select class="form-select" @bind="selectedImageSize" disabled="@isExporting">
                                <option value="0">Original Size</option>
                                <option value="640">640 x 640</option>
                                <option value="512">512 x 512</option>
                                <option value="416">416 x 416</option>
                                <option value="320">320 x 320</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Validation Ratio: @($"{validRatioInt}%")</label>
                            <input type="range" class="form-range" min="10" max="50" step="5" @bind="validRatioInt" disabled="@isExporting" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Augmentation Multiplier
                                @if (selectedProject?.ImageCount > 0)
                                {
                                    <span class="text-muted">(recommended ≥ @recommendedAugMultiplier, max = @MaxAugMultiplier)</span>
                                }
                            </label>
                            <input type="number" class="form-control" @bind="augMultiplier" min="1" max="@MaxAugMultiplier" disabled="@isExporting" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Seed Value (optional)</label>
                            <input type="number" class="form-control" @bind="augmentSeed" placeholder="e.g. 7" disabled="@isExporting" />
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="exportSeg" @bind="exportAsSegmentation" />
                            <label class="form-check-label" for="exportSeg">
                                Save labels in YOLO segmentation format
                            </label>
                        </div>

                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="autoDownload" @bind="enableAutoDownload" disabled="@isExporting" />
                            <label class="form-check-label" for="autoDownload">
                                Automatically download ZIP after export
                            </label>
                        </div>

                    </div>
                </div>

                @* ✅ 상태 메시지는 항상 바깥에 보여줌 *@
                <div class="px-3 pt-2">
                    <div class="alert alert-info" role="alert">
                        @augmentStatusMessage
                    </div>
                </div>


                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showExportModal = false">Close</button>
                    <button class="btn btn-primary" @onclick="() => Export(exportProjectId)" disabled="@isExporting">Export</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showTrainModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Train Model - @selectedProject?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showTrainModal = false"></button>
                </div>
                <div class="modal-body position-relative">

                    @* ✅ 로딩 오버레이 *@
                    @if (isTraining)
                    {
                        <div style="
                            position: absolute;
                            top: 0; left: 0;
                            width: 100%; height: 100%;
                            background: rgba(255,255,255,0.5);
                            z-index: 10;
                            display: flex;
                            justify-content: center;
                            align-items: center;">
                            <img src="/img/loading.gif" alt="Loading..." style="height: 60px;" />
                        </div>
                    }

                    @* ✅ 입력 내용: 흐림 적용 *@
                    <div style="position: relative; z-index: 1; opacity:@(isTraining ? "0.5" : "1")">

                        <p>
                            <strong>Export Path:</strong>
                            @if (!string.IsNullOrWhiteSpace(latestExportFolderName))
                            {
                                <span class="text-monospace">/exports/@latestExportFolderName</span>
                            }
                            else
                            {
                                <span class="text-muted">No export folder found</span>
                            }
                        </p>

                        <div class="mb-3">
                            <label class="form-label">Model Size</label>
                            <select class="form-select" @bind="trainModelSize" disabled="@isTraining">
                                <option value="nano">Nano</option>
                                <option value="small">Small</option>
                                <option value="medium">Medium</option>
                                <option value="large">Large</option>
                                <option value="xlarge">X-Large</option>
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Epochs</label>
                                <input type="number" class="form-control" @bind="trainEpochs" min="1" max="1000" disabled="@isTraining" />
                            </div>
                            <div class="col">
                                <label class="form-label">Batch Size</label>
                                <input type="number" class="form-control" @bind="trainBatch" min="1" max="128" disabled="@isTraining" />
                            </div>
                            <div class="col">
                                <label class="form-label">Seed (Optional)</label>
                                <input type="number" class="form-control" @bind="trainSeed" placeholder="e.g. 7" disabled="@isTraining" />
                            </div>
                        </div>


                        <div class="mb-3">
                            <label class="form-label">Server</label>
                            <select class="form-select" @bind="selectedTrainServer" disabled="@isTraining">
                                <option value="http://localhost:9002">HawkAI</option>
                                <option value="http://ictrobot.hknu.ac.kr:9002" disabled>ICTRobot</option>
                                <option value="http://sons.hknu.ac.kr:9003" disabled>Com3090</option>
                                <option value="http://sons.hknu.ac.kr:9002" disabled>Com4090</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Notification Email(s)</label>
                            <input class="form-control" @bind="recipientEmails" placeholder="e.g. user1@example.com, user2@example.com" disabled="@isTraining" />                            
                        </div>
                    </div>
                </div>

                @* ✅ 상태 메시지 바깥에 *@
                <div class="px-3 pt-2">
                    <div class="alert alert-info" role="alert">
                        @trainStatusMessage
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showTrainModal = false">Close</button>
                    <button class="btn btn-primary" @onclick="() => TriggerTrain(latestExportFolderName ?? string.Empty)" disabled="@isTraining">Start Training</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showCameraModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Camera Info - @cameraProjectName</h5>
                    <button type="button" class="btn-close" @onclick="() => showCameraModal = false"></button>
                </div>
                @if (isCameraJsonEditable)
                {
                    <textarea class="form-control" style="height: 300px; white-space: pre-wrap;" @bind="editableCameraJsonContent"></textarea>
                }
                else
                {
                    <pre style="white-space: pre-wrap;">@cameraJsonContent</pre>
                }
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCameraModal = false">Close</button>

                    @if (!isCameraJsonEditable)
                    {
                        <button class="btn btn-outline-primary" @onclick="EnableCameraJsonEdit">Edit</button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="SaveCameraJsonEdits">Save</button>
                    }

                    <button class="btn btn-danger" @onclick="DeleteCameraJson">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showModelModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Model Info - @modelProjectName</h5>
                    <button type="button" class="btn-close" @onclick="() => showModelModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (modelFolderNames.Count == 0)
                    {
                        <p>No model folders found for this project.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var folder in modelFolderNames)
                            {
                                <li style="cursor: pointer; color: blue;" @onclick="() => OpenInferenceModal(folder)">
                                    @folder
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showModelModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showInferenceModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Inference Result - @selectedModelName</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showInferenceModal = false"></button>
                </div>
                <div class="modal-body text-center">
                    @if (!string.IsNullOrEmpty(inferImageUrl))
                    {
                        <img src="@inferImageUrl" style="max-width: 100%; height: auto;" />
                    }
                    else
                    {
                        <p class="text-danger">❌ No result image received.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="() => StartInferLoop(selectedModelName)">Start Detection</button>
                    <button class="btn btn-danger" @onclick="StopInferLoop">Stop</button>
                    <button class="btn btn-secondary" @onclick="() => showInferenceModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}



@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private EmailService EmailService { get; set; } = default!;

    private List<ProjectViewModel> projects = new();
    private Dictionary<string, bool> projectHasModelMap = new();

    private string newProjectName = string.Empty;
    private string labelInput = "film, good, bad";
    private bool showCreateModal = false;
    private string errorMessage = string.Empty;
    private string errorMessage2 = string.Empty;
    private string userId = string.Empty;

    private List<IBrowserFile> createUploadedFiles = new();

    private bool showExportModal = false;
    private int exportProjectId;
    private int selectedImageSize = 0;

    private bool showEditModal = false;
    private Project editingProject = new();
    private IBrowserFile[] editUploadedFiles = Array.Empty<IBrowserFile>();
    private bool isAdmin = false;

    private bool showMergeModal = false;
    private string mergeProjectName = string.Empty;
    private string mergeLabels = string.Empty;
    private bool allowDuplicateMerge = false;

    private bool exportAsSegmentation = false;  // Export 시 detection / segmentation 선택용
    private int validRatioInt = 30;  // 기본값 30%
    private float validRatio => validRatioInt / 100f;
    
    private Project? selectedProject = null;
    private int augMultiplier = 3;
    const int MaxAugMultiplier = 40;
    private string augmentStatusMessage = string.Empty;
    private int? augmentSeed = 7;
    private int recommendedAugMultiplier => selectedProject?.ImageCount > 0
        ? (int)Math.Ceiling(10000.0 / (56 * selectedProject.ImageCount) - 1)
        : 1;

    private bool showTrainModal = false;
    private string trainModelSize = "small";
    private string trainStatusMessage = string.Empty;
    private DotNetObjectReference<Projects>? sseRef;
    private int trainEpochs = 600;
    private int trainBatch = 32;
    private int? trainSeed = 7;

    private bool showBulkDeleteConfirm = false;

    private bool showCameraModal = false;
    private string cameraJsonContent = string.Empty;
    private string cameraProjectName = string.Empty;
    private string selectedTrainServer = "http://localhost:9002";
    private bool isCameraJsonEditable = false;
    private string editableCameraJsonContent = string.Empty;

    private bool showModelModal = false;
    private string modelProjectName = string.Empty;
    private List<string> modelFolderNames = new();
