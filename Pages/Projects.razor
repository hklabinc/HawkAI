@page "/projects"
@inject HawkAI.Data.ProjectService.IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Env
@inject DataDbContext Db
@inject IJSRuntime JS
@implements IAsyncDisposable
@using HawkAI.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client;
@using System.Text.Json
@using System.IO.Compression
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.PixelFormats
@using SixLabors.ImageSharp.Processing
@using HawkAI.Services
@using System.Text.RegularExpressions;

<h4>Project Manager (@projects.Count)</h4>

<div class="d-flex gap-2 mb-3">
    <button @onclick="() => showCreateModal = true" class="btn btn-primary"><span class="oi oi-plus"></span> Create New Project</button>
    <button class="btn btn-success" @onclick="PrepareCopyOrMerge"><span class="oi oi-transfer"></span> Copy / Merge</button>
    <button class="btn btn-danger" @onclick="ConfirmBulkDelete" title="Delete selected projects"><span class="oi oi-trash"></span> Delete Selected</button>
</div>

@if (projects == null)
{
    <p><em>Loading...</em></p>
}
else if (projects.Count == 0)
{
    <p>No projects found.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @{
            string? lastUserId = null;
        }

        @foreach (var p in projects)
        {
            // ✅ 사용자 ID가 바뀌면 <hr /> 삽입 (단, 처음은 제외)
            if (lastUserId != null && lastUserId != p.CreatorUserId)
            {
                <hr class="w-100 my-3 border-top border-3 border-dark" />
            }
            lastUserId = p.CreatorUserId;

            <div class="card" style="width: 320px;">
                @if (p.Images.Count > 0)
                {
                    string displayPath;

                    var labeledImage = p.Images.FirstOrDefault(img => img.LabelStatus == "Labeled");
                    if (labeledImage != null)
                    {
                        // 라벨링된 이미지가 존재하면 annotated 폴더 경로 사용
                        var fileName = Path.GetFileName(labeledImage.RelativePath);
                        displayPath = $"/datasets/{p.Name}/images_annotated/{fileName}";
                    }
                    else
                    {
                        // 아니면 기본 images 폴더의 첫 번째 이미지 사용
                        displayPath = "/" + p.Images.First().RelativePath;
                    }

                    int labeled = p.Images.Count(img => img.LabelStatus == "Labeled");
                    int total = p.Images.Count;
                    int percent = (int)Math.Round((double)labeled / total * 100);

                    <span class="@((percent == 100 ? "badge bg-success" : "badge border border-success text-success bg-white")) position-absolute top-0 start-0 m-2" style="z-index: 1;">
                        @percent%
                    </span>

                    <img src="@displayPath"
                         class="card-img-top"
                         style="height: 180px; object-fit: cover; cursor: pointer;"
                         @onclick="() => OpenProject(p.Id)" />
                }
                <div class="card-body">
                    <h5 class="card-title mb-1">
                        <strong>@p.Name</strong>
                        <span class="text-muted" style="font-size: 0.95rem;">
                            (@p.Images.Count)
                        </span>
                    </h5>
                    <p class="card-text mb-0">Labels: @p.Labels</p>

                    <p class="card-text text-muted" style="font-size: 0.85rem;">
                        Created @GetRelativeTime(p.CreatedAt)
                        @if (isAdmin)
                        {
                            <text> by @p.CreatorUserId</text>
                        }
                    </p>
                    

                    <!-- 카드 우측 상단 Merge 체크박스 -->
                    <div class="position-absolute top-0 end-0 m-2">
                        <input type="checkbox" @bind="p.IsSelectedForMerge" class="form-check-input" id="mergeCheck_@p.Id" />
                    </div>

                    <!-- 버튼 행 -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap mt-2">

                        <!-- 왼쪽: Edit / Delete (간격 좁게) -->
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(p)">Edit</button>
                            @if (HasCameraInfo(p.Name))
                            {
                                <button class="btn btn-sm btn-outline-warning px-0" @onclick="() => ShowCameraInfo(p.Name)">Cam Info</button>
                            }
                            @if (projectHasModelMap.TryGetValue(p.Name, out var hasModels) && hasModels)
                            {
                                <button class="btn btn-sm btn-outline-success px-1" @onclick="() => ShowModelFolders(p.Name)">Models</button>
                            }
                        </div>

                        <!-- 오른쪽: Export / Augment / Train (간격 약간, 우측 정렬) -->
                        <div class="d-flex ms-auto">
                            <button class="btn btn-sm btn-outline-dark me-1" title="Export" @onclick="() => OpenExportModal(p.Id)">
                                <span class="oi oi-data-transfer-download"></span>
                            </button>
                            <button class="btn btn-sm btn-outline-dark" title="Train" @onclick="() => OpenTrainModal(p.Id)">
                                <span class="oi oi-cog"></span>
                            </button>
                        </div>
                    </div>


                </div>
            </div>
        }
    </div>
}

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Create New Project</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="newProjectName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (comma-separated)</label>
                        <input class="form-control" @bind="labelInput" placeholder="e.g., film, good, bad" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Upload Images</label>
                        <InputFile OnChange="HandleImageUpload" multiple MaxFiles="500" />
                        @if (createUploadedFiles.Count > 0)
                        {
                            <ul>
                                @foreach (var file in createUploadedFiles)
                                {
                                    <li>@file.Name</li>
                                }
                            </ul>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateProject">Create</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Project - @editingProject?.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage2))
                    {
                        <div class="alert alert-danger">@errorMessage2</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="editingProject.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (comma-separated)</label>
                        <input class="form-control" @bind="editingProject.Labels" />
                    </div>
                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label">Creator User ID</label>
                            <input class="form-control" @bind="editingProject.CreatorUserId" />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Add Images</label>
                        <InputFile OnChange="HandleFileUpload" multiple MaxFiles="500" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showEditModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveProjectEdits">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showMergeModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">@((isCopyMode ? "Copy Project" : "Merge Selected Projects"))</h5>
                    <button type="button" class="btn-close" @onclick="() => showMergeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Merged Project Name</label>
                        <input class="form-control" @bind="mergeProjectName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Labels (merged)</label>
                        <textarea class="form-control" rows="3" readonly>@mergeLabels</textarea>
                    </div>
                    @if (!isCopyMode)
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="allowDuplicates" @bind="allowDuplicateMerge" />
                            <label class="form-check-label" for="allowDuplicates">
                                Allow merging duplicate filenames (auto rename with _1, _2...)
                            </label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showMergeModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="ExecuteMerge">@((isCopyMode ? "Copy" : "Merge"))</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showBulkDeleteConfirm)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Selected Projects</h5>
                    <button type="button" class="btn-close" @onclick="() => showBulkDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the following projects?</p>
                    <ul>
                        @foreach (var p in projects.Where(p => p.IsSelectedForMerge))
                        {
                            <li>@p.Name</li>
                        }
                    </ul>
                    <p class="text-danger">This will delete all associated images and files permanently.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showBulkDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteBulkDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showExportModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Export and Augmentation - @selectedProject?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showExportModal = false"></button>
                </div>

                <div class="modal-body position-relative">

                    @* ✅ 로딩 중일 때 덮는 오버레이 *@
                    @if (isExporting)
                    {
                        <div style="
                            position: absolute;
                            top: 0; left: 0;
                            width: 100%; height: 100%;
                            background: rgba(255,255,255,0.5);
                            z-index: 10;
                            display: flex;
                            justify-content: center;
                            align-items: center;">
                            <img src="/img/loading.gif" alt="Loading..." style="height: 60px;" />
                        </div>
                    }
                    @* ✅ 실제 입력 폼 내용 (로딩 시 반투명 처리) *@
                    <div style="position: relative; z-index: 1; opacity:@(isExporting ? "0.5" : "1")">

                        <!-- 기본 옵션 -->
                        <div class="mb-3">
                            <label class="form-label">Image Size</label>
                            <select class="form-select" @bind="selectedImageSize" disabled="@isExporting">
                                <option value="0">Original Size</option>
                                <option value="640">640 x 640</option>
                                <option value="512">512 x 512</option>
                            </select>
                        </div>

                        <div class="d-flex gap-4 flex-wrap align-items-end mb-3">
                            <div>
                                <div class="form-text mb-1">Validation Ratio</div>
                                <input type="number" class="form-control form-control-sm" style="max-width:90px"
                                       min="0" max="1" step="0.05" @bind="AugCfg.Valid_Ratio" disabled="@isExporting" />
                            </div>
                            <div>
                                <div class="form-text mb-1">n1 (Fixed)</div>
                                <input type="number" class="form-control form-control-sm" style="max-width:90px"
                                       min="0" max="20" @bind="AugCfg.N1" disabled="@isExporting" />
                            </div>
                            <div>
                                <div class="form-text mb-1">n2 (Random)</div>
                                <input type="number" class="form-control form-control-sm" style="max-width:90px"
                                       min="0" max="100" @bind="AugCfg.N2" disabled="@isExporting" />
                            </div>
                            <div>
                                <div class="form-text mb-1">Seed</div>
                                <input type="number" class="form-control form-control-sm" style="max-width:90px"
                                       @bind="AugCfg.Seed" disabled="@isExporting" />
                            </div>
                            <div class="form-check ms-auto">
                                <input class="form-check-input" type="checkbox" id="autoDownload" @bind="enableAutoDownload" disabled="@isExporting" />
                                <label class="form-check-label" for="autoDownload">Download ZIP</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="exportSeg" @bind="exportAsSegmentation" />
                                <label class="form-check-label" for="exportSeg">Segment Label</label>
                            </div>
                        </div>

                        <!-- Fixed Augmentations -->
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <strong>Fixed Augmentations</strong>
                                <span class="badge bg-secondary">
                                    @($"N_img({N_img}) * N_check({N_check}) * n1({AugCfg.N1}) = {TotalFixedAug}")
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row g-2 small">
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.Original" id="fxOriginal" />
                                            <label class="form-check-label" for="fxOriginal">Original</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.Rotate90" id="fxRot90" />
                                            <label class="form-check-label" for="fxRot90">Rot90</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.Rotate180" id="fxRot180" />
                                            <label class="form-check-label" for="fxRot180">Rot180</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.Rotate270" id="fxRot270" />
                                            <label class="form-check-label" for="fxRot270">Rot270</label>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.HFlip" id="fxHFlip" />
                                            <label class="form-check-label" for="fxHFlip">HFlip</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.HFlipRotate90" id="fxHFlipRot90" />
                                            <label class="form-check-label" for="fxHFlipRot90">HFlip+Rot90</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.HFlipRotate180" id="fxHFlipRot180" />
                                            <label class="form-check-label" for="fxHFlipRot180">HFlip+Rot180</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Fixed.HFlipRotate270" id="fxHFlipRot270" />
                                            <label class="form-check-label" for="fxHFlipRot270">HFlip+Rot270</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Random Augmentations (Core) -->
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <strong>Random Augmentations</strong>
                                <span class="badge bg-secondary">
                                    train = floor(@TotalFixedAug × (1 - @AugCfg.Valid_Ratio)) × (@AugCfg.N2 + 1) = @TrainCount
                                </span>
                                <span class="badge bg-secondary ms-2">
                                    valid = ceil(@TotalFixedAug × @AugCfg.Valid_Ratio) × (@AugCfg.N2 + 1) = @ValidCount
                                </span>
                            </div>
                            <div class="card-body small">

                                <!-- Rotate -->
                                <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
                                    <div class="form-check me-2">
                                        <input class="form-check-input" type="checkbox" @bind="AugCfg.Random.Rotate.Enabled" id="rndRotate" />
                                        <label class="form-check-label fw-semibold" for="rndRotate">Rotate</label>
                                    </div>
                                    <div>
                                        <div class="form-text mb-1">limit</div>
                                        <input type="number" class="form-control form-control-sm" style="max-width:90px"
                                               @bind="AugCfg.Random.Rotate.Limit" />
                                    </div>
                                    <div>
                                        <div class="form-text mb-1">p</div>
                                        <input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px"
                                               @bind="AugCfg.Random.Rotate.P" />
                                    </div>
                                </div>

                                <!-- Affine Shear -->
                                <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
                                    <div class="form-check me-2">
                                        <input class="form-check-input" type="checkbox" @bind="AugCfg.Random.Affine_Shear.Enabled" id="rndAffine" />
                                        <label class="form-check-label fw-semibold" for="rndAffine">Affine Shear</label>
                                    </div>
                                    <div><div class="form-text mb-1">x min</div><input type="number" step="0.1" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Affine_Shear.XMin" /></div>
                                    <div><div class="form-text mb-1">x max</div><input type="number" step="0.1" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Affine_Shear.XMax" /></div>
                                    <div><div class="form-text mb-1">y min</div><input type="number" step="0.1" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Affine_Shear.YMin" /></div>
                                    <div><div class="form-text mb-1">y max</div><input type="number" step="0.1" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Affine_Shear.YMax" /></div>
                                    <div><div class="form-text mb-1">p</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Affine_Shear.P" /></div>
                                </div>

                                <!-- Bright/Contrast -->
                                <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
                                    <div class="form-check me-2">
                                        <input class="form-check-input" type="checkbox" @bind="AugCfg.Random.Brightness_Contrast.Enabled" id="rndBC" />
                                        <label class="form-check-label fw-semibold" for="rndBC">Bright/Contrast</label>
                                    </div>
                                    <div><div class="form-text mb-1">bright min</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Brightness_Contrast.BrightnessMin" /></div>
                                    <div><div class="form-text mb-1">bright max</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Brightness_Contrast.BrightnessMax" /></div>
                                    <div><div class="form-text mb-1">cont min</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Brightness_Contrast.ContrastMin" /></div>
                                    <div><div class="form-text mb-1">cont max</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Brightness_Contrast.ContrastMax" /></div>
                                    <div><div class="form-text mb-1">p</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Brightness_Contrast.P" /></div>
                                </div>

                                <!-- Gamma -->
                                <div class="d-flex align-items-end gap-2 flex-wrap">
                                    <div class="form-check me-2">
                                        <input class="form-check-input" type="checkbox" @bind="AugCfg.Random.Gamma.Enabled" id="rndGamma" />
                                        <label class="form-check-label fw-semibold" for="rndGamma">Gamma</label>
                                    </div>
                                    <div><div class="form-text mb-1">min</div><input type="number" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Gamma.Min" /></div>
                                    <div><div class="form-text mb-1">max</div><input type="number" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Gamma.Max" /></div>
                                    <div><div class="form-text mb-1">p</div><input type="number" step="0.05" class="form-control form-control-sm" style="max-width:90px" @bind="AugCfg.Random.Gamma.P" /></div>
                                </div>

                                <!-- Etc Augmentations Toggle -->
                                <button class="btn btn-link p-0 mb-2 mt-3" type="button" data-bs-toggle="collapse" data-bs-target="#etcAug" aria-expanded="false" aria-controls="etcAug">
                                  Show More ▼
                                </button>

                                <div class="collapse" id="etcAug">
                                    <!-- RGBShift -->
                                    <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
                                        <div class="form-check me-2">
                                            <input class="form-check-input" type="checkbox" @bind="AugCfg.Random.Rgb_Shift.Enabled" id="rndRGB" />
                                            <label class="form-check-label fw-semibold" for="rndRGB">RGBShift</label>
                                        </div>
                                        <div><div class="form-text mb-1">R min</div><input type="number" class="form-control form-control-sm" style="max-width:80px" @bind="AugCfg.Random.Rgb_Shift.RMin" /></div>
                                        <div><div class="form-text mb-1">R max</div><input type="number" class="form-control form-control-sm" style="max-width:80px" @bind="AugCfg.Random.Rgb_Shift.RMax" /></div>
                                        <div><div class="form-text mb-1">G min</div><input type="number" class="form-control form-control-sm" style="max-width:80px" @bind="AugCfg.Random.Rgb_Shift.GMin" /></div>
