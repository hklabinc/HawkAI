    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.Identity?.Name ?? "unknown";
        isAdmin = user.IsInRole("Admin");

        var rawProjects = isAdmin
            ? await ProjectService.GetAllProjects()
            : await ProjectService.GetUserProjects(userId);

        // ✅ ViewModel로 변환
        projects = rawProjects
            .OrderBy(p => p.CreatorUserId) // 알파벳 순 정렬
            .ThenBy(p => p.Name)
            .Select(p => new ProjectViewModel
                {
                    Id = p.Id,
                    Name = p.Name,
                    Labels = p.Labels,
                    CreatorUserId = p.CreatorUserId,
                    CreatedAt = p.CreatedAt,
                    ImageCount = p.ImageCount,
                    Images = p.Images,
                    IsSelectedForMerge = false
                }).ToList();

        // 모델 폴더가 있는지 확인
        var runDir = Path.Combine(Env.WebRootPath, "runs");
        var runFolders = Directory.Exists(runDir)
            ? Directory.GetDirectories(runDir).Select(Path.GetFileName).ToList()
            : new List<string>();

        projectHasModelMap = projects.ToDictionary(
            p => p.Name,
            p => runFolders.Any(f => f != null && f.StartsWith(p.Name, StringComparison.OrdinalIgnoreCase))
        );

        // Augment Hub 연결 설정
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri($"/augmentHub?sessionId={sessionId}"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string>("ReceiveAugmentStatus", (msg) =>
        {
            //Console.WriteLine($"[SignalR] ✅ Received message: {msg}");  // ✅ 디버깅 출력 추가
            augmentStatusMessage = msg; // 덮어쓰기
                                        
            // ✅ 모달이 열려 있는 경우에만 UI 업데이트
            if (showExportModal)
            {
                InvokeAsync(StateHasChanged); // 안전한 쓰레드 전환
            }
        });

        try
        {
            await hubConnection.StartAsync();
            Console.WriteLine($"[SignalR] 🔗 Connected to augmentHub with sessionId={sessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ❌ Connection failed: {ex.Message}");
        }


        // Train Hub 연결 설정
        trainHubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/trainHub"))
            .WithAutomaticReconnect()
            .Build();

        trainHubConnection.On<string, string>("ReceiveTrainStatus", (sessionId, msg) =>
        {
            // Console.WriteLine($"[SignalR] ▶️ Train: {sessionId} → {msg}");
            trainStatusMessage = msg;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await trainHubConnection.StartAsync();
            Console.WriteLine($"[SignalR] 🔗 Connected to trainHub with sessionId={sessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ❌ TrainHub connection failed: {ex.Message}");
        }
    }

