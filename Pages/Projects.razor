    private int N_img => selectedProject?.Images?.Count ?? 0;   // 예: 프로젝트에 포함된 이미지 수
    private int N_check => new bool[] {
        AugCfg.Fixed.Original,
        AugCfg.Fixed.Rotate90,
        AugCfg.Fixed.Rotate180,
        AugCfg.Fixed.Rotate270,
        AugCfg.Fixed.HFlip,
        AugCfg.Fixed.HFlipRotate90,
        AugCfg.Fixed.HFlipRotate180,
        AugCfg.Fixed.HFlipRotate270
    }.Count(x => x);  // true인 항목 개수
    private int TotalFixedAug => N_img * N_check * AugCfg.N1;
    private int TrainCount =>
    (int)(Math.Floor(TotalFixedAug * (1 - AugCfg.Valid_Ratio)) * (AugCfg.N2 + 1));
    private int ValidCount =>
        (int)(Math.Ceiling(TotalFixedAug * AugCfg.Valid_Ratio) * (AugCfg.N2 + 1));


    public void Dispose()
    {
        sseRef?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.Identity?.Name ?? "unknown";
        isAdmin = user.IsInRole("Admin");

        var rawProjects = isAdmin
            ? await ProjectService.GetAllProjects()
            : await ProjectService.GetUserProjects(userId);

        // ✅ ViewModel로 변환
        projects = rawProjects
            .OrderBy(p => p.CreatorUserId) // 알파벳 순 정렬
            .ThenBy(p => p.Name)
            .Select(p => new ProjectViewModel
                {
                    Id = p.Id,
                    Name = p.Name,
                    Labels = p.Labels,
                    CreatorUserId = p.CreatorUserId,
                    CreatedAt = p.CreatedAt,
                    ImageCount = p.ImageCount,
                    Images = p.Images,
                    IsSelectedForMerge = false
                }).ToList();

        // 모델 폴더가 있는지 확인
        var runDir = Path.Combine(Env.WebRootPath, "runs");
        var runFolders = Directory.Exists(runDir)
            ? Directory.GetDirectories(runDir).Select(Path.GetFileName).ToList()
            : new List<string>();

        projectHasModelMap = projects.ToDictionary(
            p => p.Name,
            p => runFolders.Any(f => f != null && f.StartsWith(p.Name, StringComparison.OrdinalIgnoreCase))
        );

        // Augment Hub 연결 설정
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri($"/augmentHub?sessionId={sessionId}"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string>("ReceiveAugmentStatus", (msg) =>
        {
            //Console.WriteLine($"[SignalR] ✅ Received message: {msg}");  // ✅ 디버깅 출력 추가
            augmentStatusMessage = msg; // 덮어쓰기
                                        
            // ✅ 모달이 열려 있는 경우에만 UI 업데이트
            if (showExportModal)
            {
                InvokeAsync(StateHasChanged); // 안전한 쓰레드 전환
            }
        });

        try
        {
            await hubConnection.StartAsync();
            Console.WriteLine($"[SignalR] 🔗 Connected to augmentHub with sessionId={sessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ❌ Connection failed: {ex.Message}");
        }


        // Train Hub 연결 설정
        trainHubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/trainHub"))
            .WithAutomaticReconnect()
            .Build();

        trainHubConnection.On<string, string>("ReceiveTrainStatus", (sessionId, msg) =>
        {
            // Console.WriteLine($"[SignalR] ▶️ Train: {sessionId} → {msg}");
            trainStatusMessage = msg;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await trainHubConnection.StartAsync();
            Console.WriteLine($"[SignalR] 🔗 Connected to trainHub with sessionId={sessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ❌ TrainHub connection failed: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName))
        {
            errorMessage = "Project name cannot be empty.";
            return;
        }
        if (projects.Any(p => p.Name == newProjectName))
        {
            errorMessage = "Project name already exists. Please choose a different name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(labelInput))
        {
            errorMessage = "Labels cannot be empty. Please provide at least one label.";
            return;
        }

        var project = new Project
            {
                Name = newProjectName,
                Labels = labelInput,
                CreatorUserId = userId,
                ImageCount = createUploadedFiles.Count
            };

        await ProjectService.CreateProject(project);

        var imagePath = Path.Combine(Env.WebRootPath, "datasets", newProjectName, "images");
        Directory.CreateDirectory(imagePath);

        foreach (var file in createUploadedFiles)
        {
            var filePath = Path.Combine(imagePath, file.Name);
            await using var stream = new FileStream(filePath, FileMode.Create);
            await file.OpenReadStream().CopyToAsync(stream);

            using var image = await SixLabors.ImageSharp.Image.LoadAsync(file.OpenReadStream());

            var imageEntry = new ImageEntry
                {
                    ProjectId = project.Id,
                    FileName = file.Name,
                    RelativePath = $"datasets/{newProjectName}/images/{file.Name}",
                    UploadedAt = DateTime.Now,
                    UploadedByUserId = userId,
                    Width = image.Width,
                    Height = image.Height,
                    LabelStatus = "Unlabeled",
                    LabelData = "{}"
                };

            Db.Images.Add(imageEntry);
        }

        await Db.SaveChangesAsync();

        newProjectName = string.Empty;
        labelInput = string.Empty;
        errorMessage = string.Empty;
        showCreateModal = false;
        createUploadedFiles.Clear();

        await ReloadProjects();
    }

    private void OpenProject(int id)
    {
        Navigation.NavigateTo($"/projects/{id}");
    }

    private async Task ReloadProjects()
    {
        var updated = isAdmin
            ? await ProjectService.GetAllProjects()
            : await ProjectService.GetUserProjects(userId);

        projects = updated
            .OrderBy(p => p.CreatorUserId)
            .ThenBy(p => p.Name)
            .Select(p => new ProjectViewModel
            {
                Id = p.Id,
                Name = p.Name,
                Labels = p.Labels,
                CreatorUserId = p.CreatorUserId,
                CreatedAt = p.CreatedAt,
                ImageCount = p.ImageCount,
                Images = p.Images,
                IsSelectedForMerge = false
            }).ToList();
    }

    private void HandleImageUpload(InputFileChangeEventArgs e)
    {
        createUploadedFiles.Clear();
        var validExtensions = new[] { ".jpg", ".jpeg", ".png", ".bmp" };
        const long maxSize = 5 * 1024 * 1024; // 5MB

        foreach (var file in e.GetMultipleFiles(500))
        {
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!validExtensions.Contains(ext) || file.Size > maxSize)
            {
                errorMessage = "Only image files (.jpg, .png, .bmp) under 5MB are allowed.";
                return;
            }

            createUploadedFiles.Add(file);
        }
    }

    private string GetFriendlyTime(DateTime dt)
    {
        var now = DateTime.Now;
        var elapsed = now - dt;

        if (elapsed.TotalDays >= 1)
        {
            if (elapsed.TotalDays < 7)
                return $"{(int)elapsed.TotalDays} day(s) ago";
            if (elapsed.TotalDays < 30)
                return $"{(int)(elapsed.TotalDays / 7)} week(s) ago";
            return dt.ToString("yyyy-MM-dd HH:mm:ss");
        }
        if (elapsed.TotalHours >= 1)
            return $"{(int)elapsed.TotalHours} hour(s) ago";
        if (elapsed.TotalMinutes >= 1)
            return $"{(int)elapsed.TotalMinutes} minute(s) ago";
        return "just now";
    }

    private void OpenExportModal(int projectId)
    {
        exportProjectId = projectId;
        selectedProject = projects.FirstOrDefault(p => p.Id == projectId);
        augmentStatusMessage = string.Empty;
        showExportModal = true;
    }

    private async Task Export(int projectId)
    {
        isExporting = true;
        StateHasChanged();

        // 임시 설정 JSON 경로 (finally에서 삭제)
        string? cfgPath = null;

        try
        {
            // 1) 프로젝트/이미지 로드 및 검증
            var project = await Db.Projects.Include(p => p.Images).FirstOrDefaultAsync(p => p.Id == projectId);
            if (project == null || project.Images.Count == 0)
            {
                await JS.InvokeVoidAsync("alert", "❌ Project not found or no images.");
                return;
            }

            int labeled = project.Images.Count(img => img.LabelStatus == "Labeled");
            int total = project.Images.Count;
            int percent = (int)Math.Round((double)labeled / total * 100);

            if (percent < 100)
            {
                await JS.InvokeVoidAsync("alert", $"⚠️ Only {percent}% of images are labeled. Please label all images before exporting.");
                return;
            }

            // 2) Export 폴더 준비
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var exportFolderName = $"{project.Name}_{timestamp}";
            var exportDir = Path.Combine(Env.WebRootPath, "exports", exportFolderName);
            Directory.CreateDirectory(exportDir);

            var trainImg = Path.Combine(exportDir, "train", "images");
            var trainLbl = Path.Combine(exportDir, "train", "labels");
            var validImg = Path.Combine(exportDir, "valid", "images");
            var validLbl = Path.Combine(exportDir, "valid", "labels");
            Directory.CreateDirectory(trainImg);
            Directory.CreateDirectory(trainLbl);
            Directory.CreateDirectory(validImg);
            Directory.CreateDirectory(validLbl);

            // 3) 이미지/라벨 내보내기 (모두 train/*로 저장)
            var labelList = project.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).ToList();

            foreach (var image in project.Images)
            {
                var srcImg = Path.Combine(Env.WebRootPath, image.RelativePath);
                var imgDest = Path.Combine(trainImg, image.FileName);

                if (File.Exists(srcImg))
                {
                    using var img = SixLabors.ImageSharp.Image.Load<Rgba32>(srcImg);
                    if (selectedImageSize > 0)
                        img.Mutate(x => x.Resize(selectedImageSize, selectedImageSize));
                    await img.SaveAsJpegAsync(imgDest);
                }

                var labelPath = Path.Combine(trainLbl, Path.ChangeExtension(image.FileName, ".txt"));
                if (!string.IsNullOrWhiteSpace(image.LabelData))
                {
                    var labelLines = new List<string>();
                    using var jsonDoc = JsonDocument.Parse(image.LabelData);
                    foreach (var box in jsonDoc.RootElement.EnumerateArray())
                    {
                        var cls = labelList.IndexOf(box.GetProperty("label").GetString() ?? "");
                        var xMin = box.GetProperty("x").GetDouble();
                        var yMin = box.GetProperty("y").GetDouble();
                        var width = box.GetProperty("w").GetDouble();
                        var height = box.GetProperty("h").GetDouble();

                        if (!exportAsSegmentation)
                        {
                            // YOLO detection (x_center, y_center, w, h) normalized
                            var x_center = (xMin + width / 2.0) / image.Width;
                            var y_center = (yMin + height / 2.0) / image.Height;
                            var w_norm = width / image.Width;
                            var h_norm = height / image.Height;
                            labelLines.Add($"{cls} {x_center:F6} {y_center:F6} {w_norm:F6} {h_norm:F6}");
                        }
                        else
                        {
                            // YOLO segmentation (사각형 4점)
                            var x1 = xMin / image.Width;
                            var y1 = yMin / image.Height;
                            var x2 = (xMin + width) / image.Width;
                            var y2 = yMin / image.Height;
                            var x3 = (xMin + width) / image.Width;
                            var y3 = (yMin + height) / image.Height;
                            var x4 = xMin / image.Width;
                            var y4 = (yMin + height) / image.Height;
                            labelLines.Add($"{cls} {x1:F6} {y1:F6} {x2:F6} {y2:F6} {x3:F6} {y3:F6} {x4:F6} {y4:F6}");
                        }
                    }
                    await File.WriteAllLinesAsync(labelPath, labelLines);
                }
            }

            // 4) Python 증강 스크립트 실행 준비 (UI 값 → AugCfg 반영 및 JSON 생성)
            augmentStatusMessage = "Starting augmentation...";
            if (showExportModal) await InvokeAsync(StateHasChanged);

            // 파이썬이 읽을 설정 JSON 구성
            var pyConfig = new
            {
                valid_ratio = AugCfg.Valid_Ratio,
                n1 = AugCfg.N1,
                n2 = AugCfg.N2,
                seed = AugCfg.Seed,
                fixed_ = new // reserved word 회피를 위해 키명을 fixed_로 사용 (augment_yolo.py에서 fixed로 매핑해 처리해도 됨)
                {
                    original = AugCfg.Fixed.Original,
                    rotate90 = AugCfg.Fixed.Rotate90,
                    rotate180 = AugCfg.Fixed.Rotate180,
                    rotate270 = AugCfg.Fixed.Rotate270,
                    hflip = AugCfg.Fixed.HFlip,
                    hflip_rotate90 = AugCfg.Fixed.HFlipRotate90,
                    hflip_rotate180 = AugCfg.Fixed.HFlipRotate180,
                    hflip_rotate270 = AugCfg.Fixed.HFlipRotate270
                },
                random = new
                {
                    rotate = new { enabled = AugCfg.Random.Rotate.Enabled, limit = AugCfg.Random.Rotate.Limit, p = AugCfg.Random.Rotate.P },
                    affine_shear = new { enabled = AugCfg.Random.Affine_Shear.Enabled, x_min = AugCfg.Random.Affine_Shear.XMin, x_max = AugCfg.Random.Affine_Shear.XMax, y_min = AugCfg.Random.Affine_Shear.YMin, y_max = AugCfg.Random.Affine_Shear.YMax, p = AugCfg.Random.Affine_Shear.P },
                    brightness_contrast = new { enabled = AugCfg.Random.Brightness_Contrast.Enabled, brightness_min = AugCfg.Random.Brightness_Contrast.BrightnessMin, brightness_max = AugCfg.Random.Brightness_Contrast.BrightnessMax, contrast_min = AugCfg.Random.Brightness_Contrast.ContrastMin, contrast_max = AugCfg.Random.Brightness_Contrast.ContrastMax, p = AugCfg.Random.Brightness_Contrast.P },
                    gamma = new { enabled = AugCfg.Random.Gamma.Enabled, min = AugCfg.Random.Gamma.Min, max = AugCfg.Random.Gamma.Max, p = AugCfg.Random.Gamma.P },
                    rgb_shift = new { enabled = AugCfg.Random.Rgb_Shift.Enabled, r_min = AugCfg.Random.Rgb_Shift.RMin, r_max = AugCfg.Random.Rgb_Shift.RMax, g_min = AugCfg.Random.Rgb_Shift.GMin, g_max = AugCfg.Random.Rgb_Shift.GMax, b_min = AugCfg.Random.Rgb_Shift.BMin, b_max = AugCfg.Random.Rgb_Shift.BMax, p = AugCfg.Random.Rgb_Shift.P },
                    gaussian_blur = new { enabled = AugCfg.Random.Gaussian_Blur.Enabled, min = AugCfg.Random.Gaussian_Blur.Min, max = AugCfg.Random.Gaussian_Blur.Max, p = AugCfg.Random.Gaussian_Blur.P },
                    shift_scale_rotate = new { enabled = AugCfg.Random.Shift_Scale_Rotate.Enabled, shift_limit = AugCfg.Random.Shift_Scale_Rotate.ShiftLimit, scale_limit = AugCfg.Random.Shift_Scale_Rotate.ScaleLimit, rotate_limit = AugCfg.Random.Shift_Scale_Rotate.RotateLimit, border_mode = AugCfg.Random.Shift_Scale_Rotate.BorderMode, p = AugCfg.Random.Shift_Scale_Rotate.P },
                    hue_saturation_value = new { enabled = AugCfg.Random.Hue_Saturation_Value.Enabled, hue = AugCfg.Random.Hue_Saturation_Value.Hue, sat = AugCfg.Random.Hue_Saturation_Value.Sat, val = AugCfg.Random.Hue_Saturation_Value.Val, p = AugCfg.Random.Hue_Saturation_Value.P },
                    gauss_noise = new { enabled = AugCfg.Random.Gauss_Noise.Enabled, p = AugCfg.Random.Gauss_Noise.P }
                }
            };

            // 임시 JSON 파일 저장
            var cfgDir = Path.Combine(Env.WebRootPath, "exports");
            Directory.CreateDirectory(cfgDir);
            cfgPath = Path.Combine(cfgDir, $"aug_cfg_{Guid.NewGuid():N}.json");
            await File.WriteAllTextAsync(cfgPath, JsonSerializer.Serialize(pyConfig, new JsonSerializerOptions { WriteIndented = false }));

            // 파이썬 실행
            string pythonExe = Environment.GetEnvironmentVariable("PYTHON_PATH") ?? "python";
            var scriptPath = Path.Combine(Env.ContentRootPath, "PythonScripts", "augment_yolo.py");

            if (!File.Exists(scriptPath))
            {
                augmentStatusMessage = $"❌ Python script not found: {scriptPath}";
                return;
            }

            var args = new List<string>
        {
            $"\"{scriptPath}\"",
            $"--base_dir \"{exportDir}\"",
            $"--config_json \"{cfgPath}\""
        };

            using var proc = new System.Diagnostics.Process();
            proc.StartInfo.FileName = pythonExe;
            proc.StartInfo.Arguments = string.Join(" ", args);
            proc.StartInfo.WorkingDirectory = Env.ContentRootPath;
            proc.StartInfo.UseShellExecute = false;
            proc.StartInfo.RedirectStandardOutput = true;
            proc.StartInfo.RedirectStandardError = true;
            proc.StartInfo.StandardOutputEncoding = System.Text.Encoding.UTF8;
            proc.StartInfo.StandardErrorEncoding = System.Text.Encoding.UTF8;
            proc.StartInfo.Environment["PYTHONIOENCODING"] = "utf-8";
            proc.StartInfo.Environment["PYTHONUTF8"] = "1";

            proc.OutputDataReceived += async (_, e) =>
            {
                if (string.IsNullOrWhiteSpace(e.Data)) return;
                if (e.Data.StartsWith("STATUS:"))
                {
                    augmentStatusMessage = e.Data[7..].Trim();
                    if (showExportModal) await InvokeAsync(StateHasChanged);
                }
                else
                {
                    Console.WriteLine("[PY] " + e.Data);
                }
            };
            proc.ErrorDataReceived += (_, e) =>
            {
                if (!string.IsNullOrWhiteSpace(e.Data))
                    Console.WriteLine("[PY-ERR] " + e.Data);
            };

            proc.Start();
            proc.BeginOutputReadLine();
            proc.BeginErrorReadLine();
            await proc.WaitForExitAsync();

            if (proc.ExitCode != 0)
            {
                augmentStatusMessage = $"❌ Augmentation process exited with code {proc.ExitCode}";
                return;
            }

            // 5) 최종 카운트 계산 → data.yaml 생성
            int CountImgs(string dir) =>
                Directory.Exists(dir)
                    ? Directory.GetFiles(dir).Count(f =>
                        f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                        f.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                        f.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
                    : 0;

            var trainCount = CountImgs(Path.Combine(exportDir, "train", "images"));
            var validCount = CountImgs(Path.Combine(exportDir, "valid", "images"));

            var yamlPath = Path.Combine(exportDir, "data.yaml");

            // augment 섹션용: pyConfig → JsonElement → YAML
            var pyConfigJson = JsonSerializer.Serialize(pyConfig, new JsonSerializerOptions { WriteIndented = false });
            using var cfgDoc = JsonDocument.Parse(pyConfigJson);
            var cfgRoot = cfgDoc.RootElement;

            var sb = new System.Text.StringBuilder();
            sb.AppendLine("train: train/images");
            sb.AppendLine("val: valid/images");
            sb.AppendLine();
            sb.AppendLine($"nc: {labelList.Count}");
            sb.AppendLine($"names: [{string.Join(", ", labelList.Select(x => $"'{x}'"))}]");
            sb.AppendLine();
            sb.AppendLine("hklab:");
            sb.AppendLine($"  project: {project.Name.ToLower().Replace(" ", "-")}");                        
            sb.AppendLine($"  url: https://hawkai.hknu.ac.kr/projects/{projectId}");
            sb.AppendLine($"  task: {(exportAsSegmentation ? "segment" : "detect")}");
            int imgW = selectedImageSize > 0 ? selectedImageSize : (project.Images.FirstOrDefault()?.Width ?? 0);
            int imgH = selectedImageSize > 0 ? selectedImageSize : (project.Images.FirstOrDefault()?.Height ?? 0);
            sb.AppendLine($"  image_width: {imgW}");
            sb.AppendLine($"  image_height: {imgH}");            
            sb.AppendLine($"  trainCount: {trainCount}");
            sb.AppendLine($"  validCount: {validCount}");
            sb.AppendLine();
            sb.AppendLine("augment:"); // ← 여기에 cfg json 내용이 YAML로 붙음
            sb.Append(JsonToYaml(cfgRoot, 2));

            await File.WriteAllTextAsync(yamlPath, sb.ToString());


            // 6) ZIP 생성 및 자동 다운로드(옵션)
            var zipPath = Path.Combine(Env.WebRootPath, "exports", $"{exportFolderName}.zip");
            if (File.Exists(zipPath)) File.Delete(zipPath);
            System.IO.Compression.ZipFile.CreateFromDirectory(exportDir, zipPath);

            if (enableAutoDownload)
            {
                var relativeZip = "/exports/" + Path.GetFileName(zipPath);
                Navigation.NavigateTo(relativeZip, true);
            }

            augmentStatusMessage = $"✅ Export & Augment completed (train: {trainCount}, valid: {validCount})";
        }
        catch (Exception ex)
        {
            augmentStatusMessage = $"❌ Export/Augment failed: {ex.Message}";
        }
        finally
        {
            // 임시 cfg JSON 정리
            try
            {
                if (!string.IsNullOrEmpty(cfgPath) && File.Exists(cfgPath))
                    File.Delete(cfgPath);
            }
            catch { /* ignore */ }

            isExporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string JsonToYaml(JsonElement elem, int indent = 0)
    {
        var sb = new System.Text.StringBuilder();
        string Ind(int i) => new string(' ', i);

        switch (elem.ValueKind)
        {
            case JsonValueKind.Object:
                foreach (var prop in elem.EnumerateObject())
                {
                    var v = prop.Value;
                    sb.Append(Ind(indent)).Append(prop.Name).Append(':');
                    if (v.ValueKind == JsonValueKind.Object || v.ValueKind == JsonValueKind.Array)
                    {
                        sb.AppendLine();
                        sb.Append(JsonToYaml(v, indent + 2));
                    }
                    else
                    {
                        sb.Append(' ').Append(ScalarToYaml(v)).AppendLine();
                    }
                }
                break;

            case JsonValueKind.Array:
                foreach (var item in elem.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.Object || item.ValueKind == JsonValueKind.Array)
                    {
                        sb.Append(Ind(indent)).Append("- ").AppendLine();
                        sb.Append(JsonToYaml(item, indent + 2));
                    }
                    else
                    {
                        sb.Append(Ind(indent)).Append("- ").Append(ScalarToYaml(item)).AppendLine();
                    }
                }
                break;

            default:
                sb.Append(Ind(indent)).Append(ScalarToYaml(elem)).AppendLine();
                break;
        }

        return sb.ToString();
    }

    private static string ScalarToYaml(JsonElement v)
    {
        switch (v.ValueKind)
        {
            case JsonValueKind.Number:
                return v.GetRawText(); // 숫자는 그대로
            case JsonValueKind.True:
                return "true";
            case JsonValueKind.False:
                return "false";
            case JsonValueKind.Null:
                return "null";
            case JsonValueKind.String:
                var s = v.GetString() ?? string.Empty;
                // 특수문자/공백 포함 시 안전하게 쿼팅
                bool needsQuote = string.IsNullOrEmpty(s)
                                  || char.IsWhiteSpace(s[0])
                                  || char.IsWhiteSpace(s[^1])
                                  || s.IndexOfAny(new[] { ':', '{', '}', '[', ']', ',', '#', '&', '*', '!', '|', '>', '%', '@', '`', '\'', '"' }) >= 0;
                if (needsQuote)
                {
                    // 이스케이프 처리 (더 치열하게 하려면 YAML 이스케이프 규칙 적용)
                    s = s.Replace("\\", "\\\\").Replace("\"", "\\\"");
                    return $"\"{s}\"";
                }
                return s;
            default:
                return v.GetRawText();
        }
    }


