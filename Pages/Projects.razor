    private string selectedModelName = "";
    private string inferImageUrl = "";
    private bool showInferenceModal = false;

    private async void OpenInferenceModal(string modelName)
    {
        selectedModelName = modelName;
        showInferenceModal = true;

        // Webcam 캡처 요청
        var base64Image = await JS.InvokeAsync<string>("captureWebcamImage");

        if (!string.IsNullOrWhiteSpace(base64Image))
        {
            var imageBytes = Convert.FromBase64String(base64Image.Split(',')[1]);
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(modelName), "model_name");
            content.Add(new ByteArrayContent(imageBytes), "image", "webcam.jpg");

            var response = await Http.PostAsync("http://localhost:9003/infer", content);
            if (response.IsSuccessStatusCode)
            {
                var imgData = await response.Content.ReadAsByteArrayAsync();
                inferImageUrl = "data:image/jpeg;base64," + Convert.ToBase64String(imgData);
            }
            else
            {
                inferImageUrl = "";
                await JS.InvokeVoidAsync("alert", $"❌ 서버 응답 오류: {response.StatusCode}");
            }
        }
    }

    private bool isInferLoopRunning = false;

    private async Task StartInferLoop(string modelName)
    {
        isInferLoopRunning = true;

        while (isInferLoopRunning)
        {
            await InferFromWebcam(modelName);
            await Task.Delay(200); // 1초 간격 (조절 가능)
        }
    }

    private void StopInferLoop()
    {
        isInferLoopRunning = false;
    }

    private async Task InferFromWebcam(string modelName)
    {
        var base64Image = await JS.InvokeAsync<string>("captureWebcamImage");

        if (!string.IsNullOrWhiteSpace(base64Image))
        {
            var imageBytes = Convert.FromBase64String(base64Image.Split(',')[1]);
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(modelName), "model_name");
            content.Add(new ByteArrayContent(imageBytes), "image", "webcam.jpg");

            var response = await Http.PostAsync("http://localhost:9003/infer", content);
            if (response.IsSuccessStatusCode)
            {
                var imgData = await response.Content.ReadAsByteArrayAsync();
                inferImageUrl = "data:image/jpeg;base64," + Convert.ToBase64String(imgData);
            }
            else
            {
                inferImageUrl = "";
                await JS.InvokeVoidAsync("alert", $"❌ 서버 응답 오류: {response.StatusCode}");
            }

            StateHasChanged();
        }
    }



