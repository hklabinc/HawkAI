    private string GetRelativeTime(DateTime createdAt)
    {
        var now = DateTime.Now;
        var span = now - createdAt;

        if (span.TotalSeconds < 60)
            return "just now";
        if (span.TotalMinutes < 60)
            return $"{(int)span.TotalMinutes} minutes ago";
        if (span.TotalHours < 24)
            return $"{(int)span.TotalHours} hours ago";
        if (span.TotalDays < 7)
            return $"{(int)span.TotalDays} days ago";

        return createdAt.ToString("yyyy-MM-dd");
    }

    public class ServerResponse
    {
        public string status { get; set; } = "";
        public string session_id { get; set; } = "";
        public string message { get; set; } = "";
    }
        
    private void OpenTrainModal(int projectId)
    {
        selectedProject = projects.FirstOrDefault(p => p.Id == projectId);
        trainStatusMessage = string.Empty;
        showTrainModal = true;
    }

    private async Task TriggerTrain()
    {
        if (selectedProject == null)
        {
            trainStatusMessage = "❌ No project selected.";
            return;
        }

        var exportDir = Path.Combine(Env.WebRootPath, "exports", selectedProject.Name);
        if (!Directory.Exists(exportDir))
        {
            trainStatusMessage = $"❌ Export folder not found: {exportDir}";
            return;
        }

        var payload = new Dictionary<string, object>
        {
            { "project_name", selectedProject.Name },
            { "base_dir", exportDir },
            { "model_size", trainModelSize },
            { "epochs", trainEpochs },
            { "batch", trainBatch }
        };

        if (trainSeed.HasValue)
            payload["seed"] = trainSeed.Value;

        try
        {
            var response = await Http.PostAsJsonAsync($"{selectedTrainServer}/api/train", payload);

            if (!response.IsSuccessStatusCode)
            {
                trainStatusMessage = $"❌ Training server error: {response.StatusCode}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ServerResponse>();

            if (result?.status == "success" && !string.IsNullOrWhiteSpace(result.session_id))
            {
                SessionId = result.session_id;
                StartPolling();  // 여기에서 시작
            }
            else
            {
                trainStatusMessage = result?.message ?? "❌ Unknown error from training server.";
            }
        }
        catch (Exception ex)
        {
            trainStatusMessage = $"❌ Failed to contact training server: {ex.Message}";
        }
    }


    public class ProgressStatus
    {
        public string status { get; set; }
    }

    private void StartPolling()
    {
        PollTimer?.Stop();
        PollTimer = new System.Timers.Timer(5000); // 1초마다 polling
        PollTimer.Elapsed += async (_, _) =>
        {
            if (!string.IsNullOrEmpty(SessionId))
            {
                try
                {
                    var result = await Http.GetFromJsonAsync<ProgressStatus>($"{selectedTrainServer}/api/progress/{SessionId}");
                    var statusText = result?.status ?? "⚠️ No status";

                    if (statusText != trainStatusMessage)
                    {
                        // UI 업데이트는 Dispatcher 스레드에서 수행해야 함
                        await InvokeAsync(() =>
                        {
                            trainStatusMessage = statusText;
                            StateHasChanged();  // UI 리렌더링
                        });
                    }

                    if (statusText.StartsWith("✅") || statusText.StartsWith("❌"))
                    {
                        Console.WriteLine("Training completed or failed, stopping polling.");
                        PollTimer?.Stop();
                    }
                }
                catch (Exception ex)
                {
                    await InvokeAsync(() =>
                    {
                        trainStatusMessage = "⚠️ Error during polling";
                        StateHasChanged();
                    });

                    PollTimer?.Stop();
                }
            }
        };
        PollTimer.AutoReset = true;
        PollTimer.Start();
    }



    private void ConfirmBulkDelete()
    {
        var selected = projects.Where(p => p.IsSelectedForMerge).ToList();
        if (selected.Count == 0)
        {
            JS.InvokeVoidAsync("alert", "⚠️ Please select at least one project to delete.");
            return;
        }

        showBulkDeleteConfirm = true;
    }

    private async Task ExecuteBulkDelete()
    {
        var selectedProjects = projects.Where(p => p.IsSelectedForMerge).ToList();

        foreach (var p in selectedProjects)
        {
            var project = await Db.Projects.FindAsync(p.Id);
            if (project == null) continue;

            var images = Db.Images.Where(i => i.ProjectId == project.Id);
            Db.Images.RemoveRange(images);
            Db.Projects.Remove(project);

            var folder = Path.Combine(Env.WebRootPath, "datasets", project.Name);
            if (Directory.Exists(folder))
                Directory.Delete(folder, true);
        }

        await Db.SaveChangesAsync();

        showBulkDeleteConfirm = false;

        // UI 갱신
        await ReloadProjects();
    }

