            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Results Image</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showResultsImageModal = false"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="@resultsImagePath" style="max-width: 100%; height: auto;" alt="Results" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showResultsImageModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}




@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;

    private List<ProjectViewModel> projects = new();
    private Dictionary<string, bool> projectHasModelMap = new();

    private string newProjectName = string.Empty;
    private string labelInput = string.Empty;
    private bool showCreateModal = false;
    private string errorMessage = string.Empty;
    private string errorMessage2 = string.Empty;
    private string userId = string.Empty;

    private List<IBrowserFile> createUploadedFiles = new();

    private bool showDeleteConfirm = false;
    private int projectToDeleteId = -1;
    private string projectToDeleteName = string.Empty;

    private bool showExportModal = false;
    private int exportProjectId;
    private int selectedImageSize = 640;

    private bool showEditModal = false;
    private Project editingProject = new();
    private IBrowserFile[] editUploadedFiles = Array.Empty<IBrowserFile>();
    private bool isAdmin = false;

    private bool showMergeModal = false;
    private string mergeProjectName = string.Empty;
    private string mergeLabels = string.Empty;

    private int validRatioInt = 30;  // 기본값 30%
    private float validRatio => validRatioInt / 100f;

    private Project? selectedProject = null;
    private int augMultiplier = 3;
    private string augmentStatusMessage = string.Empty;
    private int? augmentSeed = null;
    private int recommendedAugMultiplier => selectedProject?.ImageCount > 0
        ? (int)Math.Ceiling(10000.0 / (56 * selectedProject.ImageCount) - 1)
        : 1;

    private bool showTrainModal = false;
    private string trainModelSize = "small";
    private string trainStatusMessage = string.Empty;
    private DotNetObjectReference<Projects>? sseRef;
    private int trainEpochs = 300;
    private int trainBatch = 32;
    private int? trainSeed = null;

    private bool showBulkDeleteConfirm = false;

    private bool showCameraModal = false;
    private string cameraJsonContent = string.Empty;
    private string cameraProjectName = string.Empty;
    private string SessionId;    
    private System.Timers.Timer PollTimer;
    private bool isAugmenting = false;
    private string selectedTrainServer = "http://localhost:9002";

    private bool showModelModal = false;
    private string modelProjectName = string.Empty;
    private List<string> modelFolderNames = new();
    private bool showResultsImageModal = false;
    private string resultsImagePath = string.Empty;

    private bool enableAutoDownload = false;

    private HubConnection? hubConnection;
    private string sessionId = Guid.NewGuid().ToString();  // 새 세션 ID
    private List<string> augmentLogs = new();


    public void Dispose()
    {
        sseRef?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.Identity?.Name ?? "unknown";
        isAdmin = user.IsInRole("Admin");

        var rawProjects = isAdmin
            ? await ProjectService.GetAllProjects()
            : await ProjectService.GetUserProjects(userId);

        // ✅ ViewModel로 변환
        projects = rawProjects
            .OrderBy(p => p.CreatorUserId) // 알파벳 순 정렬
            .ThenBy(p => p.Name)
            .Select(p => new ProjectViewModel
                {
                    Id = p.Id,
                    Name = p.Name,
                    Labels = p.Labels,
                    CreatorUserId = p.CreatorUserId,
                    CreatedAt = p.CreatedAt,
                    ImageCount = p.ImageCount,
                    Images = p.Images,
                    IsSelectedForMerge = false
                }).ToList();

        // 모델 폴더가 있는지 확인
        var runDir = Path.Combine(Env.WebRootPath, "runs");
        var runFolders = Directory.Exists(runDir)
            ? Directory.GetDirectories(runDir).Select(Path.GetFileName).ToList()
            : new List<string>();

        projectHasModelMap = projects.ToDictionary(
            p => p.Name,
            p => runFolders.Any(f => f != null && f.StartsWith(p.Name, StringComparison.OrdinalIgnoreCase))
        );

        // Hub 연결 설정
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri($"/augmentHub?sessionId={sessionId}"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string>("ReceiveAugmentStatus", (msg) =>
        {
            Console.WriteLine($"[SignalR] ✅ Received message: {msg}");  // ✅ 디버깅 출력 추가
            augmentStatusMessage = msg; // 덮어쓰기
            // augmentLogs.Add(msg);
                                        
            // ✅ 모달이 열려 있는 경우에만 UI 업데이트
            if (showExportModal)
            {
                InvokeAsync(StateHasChanged); // 안전한 쓰레드 전환
            }
        });

        try
        {
            await hubConnection.StartAsync();
            Console.WriteLine($"[SignalR] 🔗 Connected to augmentHub with sessionId={sessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ❌ Connection failed: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName))
        {
            errorMessage = "Project name cannot be empty.";
            return;
        }
        if (projects.Any(p => p.Name == newProjectName))
        {
            errorMessage = "Project name already exists. Please choose a different name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(labelInput))
        {
            errorMessage = "Labels cannot be empty. Please provide at least one label.";
            return;
        }

        var project = new Project
            {
                Name = newProjectName,
                Labels = labelInput,
                CreatorUserId = userId,
                ImageCount = createUploadedFiles.Count
            };

        await ProjectService.CreateProject(project);

        var imagePath = Path.Combine(Env.WebRootPath, "datasets", newProjectName, "images");
        Directory.CreateDirectory(imagePath);

        foreach (var file in createUploadedFiles)
        {
            var filePath = Path.Combine(imagePath, file.Name);
            await using var stream = new FileStream(filePath, FileMode.Create);
            await file.OpenReadStream().CopyToAsync(stream);

            using var image = await SixLabors.ImageSharp.Image.LoadAsync(file.OpenReadStream());

            var imageEntry = new ImageEntry
                {
                    ProjectId = project.Id,
                    FileName = file.Name,
                    RelativePath = $"datasets/{newProjectName}/images/{file.Name}",
                    UploadedAt = DateTime.Now,
                    UploadedByUserId = userId,
                    Width = image.Width,
                    Height = image.Height,
                    LabelStatus = "Unlabeled",
                    LabelData = "{}"
                };

            Db.Images.Add(imageEntry);
        }

        await Db.SaveChangesAsync();

        newProjectName = string.Empty;
        labelInput = string.Empty;
        errorMessage = string.Empty;
        showCreateModal = false;
        createUploadedFiles.Clear();

        await ReloadProjects();
    }

    private void OpenProject(int id)
    {
        Navigation.NavigateTo($"/projects/{id}");
    }

    private async Task ReloadProjects()
    {
        var updated = isAdmin
            ? await ProjectService.GetAllProjects()
            : await ProjectService.GetUserProjects(userId);

        projects = updated
            .OrderBy(p => p.CreatorUserId)
            .ThenBy(p => p.Name)
            .Select(p => new ProjectViewModel
            {
                Id = p.Id,
