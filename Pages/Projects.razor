    bool IsValidEmail(string email)
    {
        return Regex.IsMatch(email,
            @"^[^@\s]+@[^@\s]+\.[^@\s]+$",
            RegexOptions.IgnoreCase);
    }

    private async Task TriggerTrain(string exportFolderName)
    {
        if (selectedProject == null)
        {
            trainStatusMessage = "❌ No project selected.";
            return;
        }

        if (string.IsNullOrWhiteSpace(exportFolderName))
        {
            trainStatusMessage = $"❌ No export folder found for project: {selectedProject.Name}";
            return;
        }

        var exportDir = Path.Combine(Env.WebRootPath, "exports", exportFolderName);
        if (!Directory.Exists(exportDir))
        {
            trainStatusMessage = $"❌ Export folder not found: {exportDir}";
            return;
        }

        isTraining = true;
        StateHasChanged(); // UI 즉시 업데이트

        var payload = new Dictionary<string, object>
        {
            { "project_name", selectedProject.Name },
            { "base_dir", exportDir },
            { "model_size", trainModelSize },
            { "epochs", trainEpochs },
            { "batch", trainBatch }
        };

        if (trainSeed.HasValue)
            payload["seed"] = trainSeed.Value;

        try
        {
            var response = await Http.PostAsJsonAsync($"{selectedTrainServer}/api/train", payload);

            if (!response.IsSuccessStatusCode)
            {
                trainStatusMessage = $"❌ Training server error: {response.StatusCode}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ServerResponse>();

            if (result?.status == "success" && !string.IsNullOrWhiteSpace(result.session_id))
            {
                sessionId = result.session_id;

                // ✅ result.message에서 Output 디렉토리 이름 추출
                string sessionFolder = null;
                var match = Regex.Match(result.message, @"Output:\s*runs/([^\s]+)");
                if (match.Success)
                {
                    sessionFolder = match.Groups[1].Value;
                }

                // ✅ 이메일 본문 작성
                var emailSubject = $"[HawkAI] Training Completed - {selectedProject.Name}";
                var emailBody =
                    $"Project '{selectedProject.Name}' training has completed successfully.\n\n" +
                    $"{result.message}\n\n";

                if (!string.IsNullOrWhiteSpace(sessionFolder))
                {
                    emailBody += $"View results: https://hawkai.hknu.ac.kr/runs/{sessionFolder}/results.png";
                }

                // ✅ 사용자 입력 이메일 유효성 확인 후 전송
                if (!string.IsNullOrWhiteSpace(recipientEmails))
                {
                    var emailList = recipientEmails
                        .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                        .Select(email => email.Trim())
                        .Where(IsValidEmail)
                        .Distinct()
                        .ToList();

                    if (emailList.Count > 0)
                    {
                        foreach (var email in emailList)
                        {
                            var sent = await EmailService.SendEmailAsync(email, emailSubject, emailBody);
                            if (!sent)
                            {
                                trainStatusMessage += $"\n⚠️ Failed to send email to {email}";
                            }
                        }
                    }
                    else
                    {
                        trainStatusMessage += "\n⚠️ No valid recipient email(s) provided.";
                    }
                }
                else
                {
                    trainStatusMessage += "\n⚠️ Recipient email input is empty.";
                }

            }
            else
            {
                trainStatusMessage = result?.message ?? "❌ Unknown error from training server.";
            }
        }
        catch (Exception ex)
        {
            trainStatusMessage = $"❌ Failed to contact training server: {ex.Message}";
        }

        isTraining = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ConfirmBulkDelete()
    {
        var selected = projects.Where(p => p.IsSelectedForMerge).ToList();
        if (selected.Count == 0)
        {
            JS.InvokeVoidAsync("alert", "⚠️ Please select at least one project to delete.");
            return;
        }

        showBulkDeleteConfirm = true;
    }

    private async Task ExecuteBulkDelete()
    {
        var selectedProjects = projects.Where(p => p.IsSelectedForMerge).ToList();

        foreach (var p in selectedProjects)
        {
            var project = await Db.Projects.FindAsync(p.Id);
            if (project == null) continue;

            var images = Db.Images.Where(i => i.ProjectId == project.Id);
            Db.Images.RemoveRange(images);
            Db.Projects.Remove(project);

            var folder = Path.Combine(Env.WebRootPath, "datasets", project.Name);
            if (Directory.Exists(folder))
                Directory.Delete(folder, true);
        }

        await Db.SaveChangesAsync();

        showBulkDeleteConfirm = false;

        // UI 갱신
        await ReloadProjects();
    }

