    private async Task Export(int projectId)
    {
        isExporting = true;
        StateHasChanged();

        var project = await Db.Projects.Include(p => p.Images).FirstOrDefaultAsync(p => p.Id == projectId);
        if (project == null || project.Images.Count == 0) return;

        int labeled = project.Images.Count(img => img.LabelStatus == "Labeled");
        int total = project.Images.Count;
        int percent = (int)Math.Round((double)labeled / total * 100);

        if (percent < 100)
        {
            await JS.InvokeVoidAsync("alert", $"⚠️ Only {percent}% of images are labeled. Please label all images before exporting.");
            return;
        }

        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        var exportFolderName = $"{project.Name}_{timestamp}";
        var exportDir = Path.Combine(Env.WebRootPath, "exports", exportFolderName);  // 최종 저장 경로
        Directory.CreateDirectory(exportDir);

        // 📌 중첩 폴더 없이 바로 exportDir 밑에 train/valid 생성
        var trainImg = Path.Combine(exportDir, "train", "images");
        var trainLbl = Path.Combine(exportDir, "train", "labels");
        var validImg = Path.Combine(exportDir, "valid", "images");
        var validLbl = Path.Combine(exportDir, "valid", "labels");

        Directory.CreateDirectory(trainImg);
        Directory.CreateDirectory(trainLbl);
        Directory.CreateDirectory(validImg);
        Directory.CreateDirectory(validLbl);

        var random = new Random();
        var images = project.Images.OrderBy(_ => random.Next()).ToList();
        float validRatio_orignalImages = 0.0f;
        int splitIndex = (int)(images.Count * (1 - validRatio_orignalImages));
        var train = images.Take(splitIndex).ToList();
        var valid = images.Skip(splitIndex).ToList();

        foreach (var image in train.Concat(valid))
        {
            var folderType = train.Contains(image) ? "train" : "valid";
            var imgDest = Path.Combine(exportDir, folderType, "images", image.FileName);
            var srcImg = Path.Combine(Env.WebRootPath, image.RelativePath);

            if (File.Exists(srcImg))
            {
                using var img = SixLabors.ImageSharp.Image.Load<Rgba32>(srcImg);
                if (selectedImageSize > 0)
                {
                    img.Mutate(x => x.Resize(selectedImageSize, selectedImageSize));
                }
                await img.SaveAsJpegAsync(imgDest);
            }

            var labelPath = Path.Combine(exportDir, folderType, "labels", Path.ChangeExtension(image.FileName, ".txt"));
            if (!string.IsNullOrWhiteSpace(image.LabelData))
            {
                var labelLines = new List<string>();
                var labelList = project.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).ToList();
                var json = JsonDocument.Parse(image.LabelData);
                foreach (var box in json.RootElement.EnumerateArray())
                {
                    var cls = labelList.IndexOf(box.GetProperty("label").GetString() ?? "");
                    var xMin = box.GetProperty("x").GetDouble();
                    var yMin = box.GetProperty("y").GetDouble();
                    var width = box.GetProperty("w").GetDouble();
                    var height = box.GetProperty("h").GetDouble();

                    if (!exportAsSegmentation)
                    {
                        // ✅ 기존 YOLO detection 포맷
                        var x_center = (xMin + width / 2.0) / image.Width;
                        var y_center = (yMin + height / 2.0) / image.Height;
                        var w_norm = width / image.Width;
                        var h_norm = height / image.Height;

                        labelLines.Add($"{cls} {x_center:F6} {y_center:F6} {w_norm:F6} {h_norm:F6}");
                    }
                    else
                    {
                        // ✅ YOLO segmentation 포맷 (직사각형 4점 좌표)
                        var x1 = xMin / image.Width;
                        var y1 = yMin / image.Height;
                        var x2 = (xMin + width) / image.Width;
                        var y2 = yMin / image.Height;
                        var x3 = (xMin + width) / image.Width;
                        var y3 = (yMin + height) / image.Height;
                        var x4 = xMin / image.Width;
                        var y4 = (yMin + height) / image.Height;

                        labelLines.Add($"{cls} {x1:F6} {y1:F6} {x2:F6} {y2:F6} {x3:F6} {y3:F6} {x4:F6} {y4:F6}");
                    }
                }
                await File.WriteAllLinesAsync(labelPath, labelLines);
            }
        }

        var yamlPath = Path.Combine(exportDir, "data.yaml");
        var yaml =
            $"train: train/images\n" +
            $"val: valid/images\n\n" +
            $"nc: {project.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).Length}\n" +
            $"names: [{string.Join(", ", project.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => $"'{x.Trim()}'"))}]\n\n" +
            $"hklab:\n" +
            $"  project: {project.Name.ToLower().Replace(" ", "-")}\n" +
            $"  version: 1\n" +
            $"  url: https://hawkai.hknu.ac.kr/projects/{projectId}\n" +
            $"  ratioOfValid: {validRatio}\n" +
            $"  augMultiplier: {augMultiplier}\n" +
            $"  augmentSeed: {(augmentSeed.HasValue ? augmentSeed.Value.ToString() : "null")}\n" + 
            $"  task: {(exportAsSegmentation ? "segment" : "detect")}\n";   

        await File.WriteAllTextAsync(yamlPath, yaml);

        // ✅ Export 완료 후 Augment 수행
        await TriggerAugmentAfterExport(projectId, exportDir, exportFolderName);

        isExporting = false;
        StateHasChanged();
    }

    private async Task TriggerAugmentAfterExport(int projectId, string exportDir, string exportFolderName)
    {
        if (selectedProject == null || selectedProject.Id != projectId)
        {
            augmentStatusMessage = "❌ No project selected.";
            return;
        }

        var payload = new Dictionary<string, object>
            {
                { "project_name", selectedProject.Name },
                { "base_dir", exportDir },
                { "valid_ratio", validRatio },  // 고정값 or 필요시 추후 설정
                { "n", augMultiplier },
                { "session_id", sessionId }     // session ID 추가
            };

        if (augmentSeed.HasValue)
        {
            payload["seed"] = augmentSeed.Value;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:9001/api/augment", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ServerResponse>();
                if (result?.status == "success")
                {
                    // ✅ train/valid 이미지 수 계산
                    var trainImageDir = Path.Combine(exportDir, "train", "images");
                    var validImageDir = Path.Combine(exportDir, "valid", "images");

                    int trainCount = Directory.Exists(trainImageDir)
                        ? Directory.GetFiles(trainImageDir).Count(f => f.EndsWith(".jpg") || f.EndsWith(".jpeg") || f.EndsWith(".png"))
                        : 0;

                    int validCount = Directory.Exists(validImageDir)
                        ? Directory.GetFiles(validImageDir).Count(f => f.EndsWith(".jpg") || f.EndsWith(".jpeg") || f.EndsWith(".png"))
                        : 0;

                    // ✅ data.yaml에 추가 내용 붙이기
                    var yamlPath = Path.Combine(exportDir, "data.yaml");
                    await File.AppendAllTextAsync(yamlPath,
                        $"  trainCount: {trainCount}\n" +
                        $"  validCount: {validCount}\n");

                    // ✅ augment 성공 후 zip 생성
                    var zipPath = Path.Combine(Env.WebRootPath, "exports", $"{exportFolderName}.zip");
                    if (File.Exists(zipPath)) File.Delete(zipPath);
                    ZipFile.CreateFromDirectory(exportDir, zipPath);

                    // 브라우저에서 자동 다운로드를 위해
                    if (enableAutoDownload)
                    {
                        var relativeZip = "/exports/" + Path.GetFileName(zipPath);
                        Navigation.NavigateTo(relativeZip, true);
                    }
                }
                else
                {
                    augmentStatusMessage = "❌ Unexpected response format.";
                }
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ServerResponse>();
                if (result == null)
                    augmentStatusMessage = $"❌ Augmentation failed with status code {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            augmentStatusMessage = $"❌ Failed to contact augmentation server: {ex.Message}";
        }
    }



