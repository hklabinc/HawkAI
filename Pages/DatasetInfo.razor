@page "/dataset-info"
@using System.Globalization
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject HawkAI.Data.ProjectService.IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Exported Datasets</h3>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>No</th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.ModelName))">
                Model
                @if (exportSortColumn == nameof(ExportRow.ModelName))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.CreatedAt))">
                Date
                @if (exportSortColumn == nameof(ExportRow.CreatedAt))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.ImageWidth))">
                Size (W×H)
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.Nc))">
                nc
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.ValidRatio))">
                valid_ratio
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.N1))">
                n1
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.N2))">
                n2
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.Seed))">
                seed
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.TrainCount))">
                Train Count
                @if (exportSortColumn == nameof(ExportRow.TrainCount))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.ValidCount))">
                Valid Count
                @if (exportSortColumn == nameof(ExportRow.ValidCount))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < SortedExportInfos.Count(); i++)
        {
            var row = SortedExportInfos.ElementAt(i);
            <tr>
                <td>@(i + 1)</td>
                <td>@row.ModelName</td>
                <td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@($"{row.ImageWidth}×{row.ImageHeight}")</td>
                <td>@row.Nc</td>
                <td>@(row.ValidRatio?.ToString("0.##") ?? "")</td>
                <td>@(row.N1?.ToString() ?? "")</td>
                <td>@(row.N2?.ToString() ?? "")</td>
                <td>@(row.Seed?.ToString() ?? "")</td>
                <td>@row.TrainCount</td>
                <td>@row.ValidCount</td>
                <td>
                    <button class="btn btn-sm btn-secondary me-1" @onclick="() => OpenViewExport(row.FolderName)">보기</button>
                    <a class="btn btn-sm btn-info me-1" href="@($"/exports/{row.FolderName}.zip")" download>다운로드</a>
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteExport(row.FolderName)">삭제</button>
                </td>
            </tr>
        }
    </tbody>
</table>


<!-- View Export Modal -->
<div class="modal fade" id="viewExportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Export Viewer
                    @if (selectedExportFolder is not null)
                    {
                        <span class="text-muted">(@selectedExportFolder)</span>
                    }
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                        @onclick="CloseViewExport"></button>
            </div>

            <div class="modal-body">
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "yaml" ? "active" : null)"
                                @onclick="@(() => SwitchTab("yaml"))">
                            data.yaml
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "train-images" ? "active" : null)"
                                @onclick="@(() => SwitchTab("train-images"))">
                            train/images (@(trainImages?.Count ?? 0))
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "train-labels" ? "active" : null)"
                                @onclick="@(() => SwitchTab("train-labels"))">
                            train/labels (@(trainLabels?.Count ?? 0))
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "valid-images" ? "active" : null)"
                                @onclick="@(() => SwitchTab("valid-images"))">
                            valid/images (@(validImages?.Count ?? 0))
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(activeTab == "valid-labels" ? "active" : null)"
                                @onclick="@(() => SwitchTab("valid-labels"))">
                            valid/labels (@(validLabels?.Count ?? 0))
                        </button>
                    </li>
                </ul>

                @if (activeTab == "yaml")
                {
                    <pre class="p-3 bg-light border rounded" style="max-height:70vh; overflow:auto">@yamlText</pre>
                }
                else if (activeTab == "train-images")
                {
                    @* 이미지 썸네일 그리드 *@
                    @if (trainImages?.Any() == true)
                    {
                        <div class="thumb-grid">
                            @foreach (var url in trainImages)
                            {
                                <img src="@url" class="thumb" @onclick="() => OpenLightbox(url)" loading="lazy" />
                            }
                        </div>
                    }
                    else
                    {

                        <div class="text-muted">No images.</div>
                    }
                }
                else if (activeTab == "valid-images")
                {
                    @if (validImages?.Any() == true)
                    {
                        <div class="thumb-grid">
                            @foreach (var url in validImages)
                            {
                                <img src="@url" class="thumb" @onclick="() => OpenLightbox(url)" loading="lazy" />
                            }
                        </div>
                    }
                    else
                    {

                        <div class="text-muted">No images.</div>
                    }
                }
                else if (activeTab == "train-labels")
                {
                    if (trainLabels?.Any() == true)
                    {
                        <ul class="list-group list-group-flush file-list">
                            @foreach (var url in trainLabels)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center"
                                    style="cursor:pointer"
                                    title="클릭하여 미리보기"
                                    @onclick="@(() => OpenTxtPreview(url))">
                                    <span class="text-truncate" style="max-width: 100%;">
                                        @System.IO.Path.GetFileName(System.Net.WebUtility.UrlDecode(url))
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {

                        <div class="text-muted">No labels.</div>
                    }
                }

                @* valid-labels 탭도 동일하게 *@
                else if (activeTab == "valid-labels")
                {
                    if (validLabels?.Any() == true)
                    {
                        <ul class="list-group list-group-flush file-list">
                            @foreach (var url in validLabels)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center"
                                    style="cursor:pointer"
                                    title="클릭하여 미리보기"
                                    @onclick="@(() => OpenTxtPreview(url))">
                                    <span class="text-truncate" style="max-width: 100%;">
                                        @System.IO.Path.GetFileName(System.Net.WebUtility.UrlDecode(url))
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {

                        <div class="text-muted">No labels.</div>
                    }
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseViewExport">닫기</button>
            </div>
        </div>
    </div>
</div>

@* 기존 style 토글 방식 말고, DOM 자체를 조건부로 *@
@if (_lightboxVisible)
{
    <div class="lightbox-backdrop" @onclick="CloseLightbox">
        <img src="@_lightboxSrc"
             class="lightbox-image"
             @onclick:stopPropagation="true" />
    </div>
}

<style>
    .thumb-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 10px;
        max-height: 70vh;
        overflow: auto;
    }

    .thumb {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: zoom-in;
    }

    .file-list {
        max-height: 70vh;
        overflow: auto;
    }

    /* Bootstrap: .modal-backdrop 1050, .modal 1055 */
    .lightbox-backdrop {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,.85);
        z-index: 2000; /* 🚀 모달보다 위로 */
        cursor: zoom-out;
    }

    .lightbox-image {
        max-width: 95vw;
        max-height: 95vh;
        object-fit: contain;
        border-radius: 6px;
        cursor: default;
    }
</style>


@if (_txtPreviewVisible)
{
    <div class="topmodal-backdrop" @onclick="CloseTxtPreview">
        <div class="topmodal-dialog" @onclick:stopPropagation>
            <div class="topmodal-header">
                <div class="fw-bold">@_txtPreviewTitle</div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseTxtPreview"></button>
            </div>
            <div class="topmodal-body">
                <pre class="topmodal-pre">@_txtPreviewContent</pre>
            </div>
        </div>
    </div>
}

<style>
    /* 기존 모달(1055), 라이트박스(2000)보다 더 높게 */
    .topmodal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2200; /* 제일 위 */
    }

    .topmodal-dialog {
        width: min(900px, 95vw);
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,.35);
        display: flex;
        flex-direction: column;
        max-height: 85vh;
    }

    .topmodal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        border-bottom: 1px solid #eee;
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 1;
    }

    .topmodal-body {
        padding: 0;
    }

    .topmodal-pre {
        margin: 0;
        padding: 14px;
        max-height: 80vh;
        overflow: auto;
        background: #f8f9fa;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        font-size: .9rem;
        line-height: 1.45;
        white-space: pre-wrap; /* 길면 줄바꿈 */
        word-break: break-all; /* 긴 토큰 강제 줄바꿈 */
    }
</style>




@code {
    string exportSortColumn = "CreatedAt";
    bool exportSortAscending = false;  // 최신순 정렬

    List<string> userProjectNames = new();
    bool isAdmin = false;

    IEnumerable<ExportRow> SortedExportInfos =>
    exportSortAscending
        ? exportInfos.OrderBy(e => e.GetType().GetProperty(exportSortColumn)?.GetValue(e, null))
        : exportInfos.OrderByDescending(e => e.GetType().GetProperty(exportSortColumn)?.GetValue(e, null));


    class ExportRow
    {
        public string ModelName { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public int TrainCount { get; set; }
        public int ValidCount { get; set; }
        public string FolderName { get; set; } = string.Empty;
        public int ImageWidth { get; set; }
        public int ImageHeight { get; set; }
        public int Nc { get; set; }
        public double? ValidRatio { get; set; }
        public int? N1 { get; set; }
        public int? N2 { get; set; }
        public int? Seed { get; set; }
    }

    List<ExportRow> exportInfos = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.Identity?.Name ?? "unknown";
        isAdmin = user.IsInRole("Admin");

        if (!isAdmin)
        {
            var rawProjects = await ProjectService.GetUserProjects(userId);
            userProjectNames = rawProjects.Select(p => p.Name).ToList();
        }

        LoadExportInfo();
    }


    void SortExportBy(string column)
    {
        if (exportSortColumn == column)
            exportSortAscending = !exportSortAscending;
        else
        {
            exportSortColumn = column;
            exportSortAscending = true;
        }
    }

    void LoadExportInfo()
    {
        var expDir = Path.Combine(Env.WebRootPath, "exports");
        if (!Directory.Exists(expDir)) return;

        var folders = Directory.GetDirectories(expDir);
        exportInfos.Clear();

        foreach (var folder in folders)
        {
            var folderName = Path.GetFileName(folder);
            var parts = folderName.Split('_');
            if (parts.Length < 3) continue;

            var modelName = string.Join('_', parts[..^2]);

            // Admin 아닌 경우 필터링
            if (!isAdmin && !userProjectNames.Any(p => modelName.Equals(p, StringComparison.OrdinalIgnoreCase)))
                continue;

            var yaml = Path.Combine(folder, "data.yaml");
            if (!File.Exists(yaml)) continue;

            int train = 0, valid = 0;
            int imageWidth = 0, imageHeight = 0, nc = 0;
            double? validRatio = null;
            int? n1 = null, n2 = null, seed = null;

            var lines = File.ReadAllLines(yaml);
            foreach (var line in lines)
            {
                var trimmed = line.Trim();

                if (trimmed.StartsWith("trainCount"))
                    train = int.Parse(trimmed.Split(':')[1].Trim());
                if (trimmed.StartsWith("validCount"))
                    valid = int.Parse(trimmed.Split(':')[1].Trim());

                if (trimmed.StartsWith("image_width"))
                    imageWidth = int.Parse(trimmed.Split(':')[1].Trim());
                if (trimmed.StartsWith("image_height"))
                    imageHeight = int.Parse(trimmed.Split(':')[1].Trim());
                if (trimmed.StartsWith("nc"))
                    nc = int.Parse(trimmed.Split(':')[1].Trim());

                if (trimmed.StartsWith("valid_ratio"))
                    validRatio = double.Parse(trimmed.Split(':')[1].Trim(), CultureInfo.InvariantCulture);
                if (trimmed.StartsWith("n1"))
                    n1 = int.Parse(trimmed.Split(':')[1].Trim());
                if (trimmed.StartsWith("n2"))
                    n2 = int.Parse(trimmed.Split(':')[1].Trim());
                if (trimmed.StartsWith("seed"))
                    seed = int.Parse(trimmed.Split(':')[1].Trim());
            }

                // parts 예: ["L1825-03", "20250801", "035619"]
            var dateStr = parts[^2] + "_" + parts[^1];
            DateTime createdAt;
            if (!DateTime.TryParseExact(dateStr, "yyyyMMdd_HHmmss", null, DateTimeStyles.None, out createdAt))
            {
                // 파싱 실패 시 fallback → 파일 시스템 생성 시각
                createdAt = Directory.GetCreationTime(folder);
            }

            exportInfos.Add(new ExportRow
            {
                ModelName = modelName,
                CreatedAt = createdAt,   // ✅ 폴더명 기반 timestamp 사용
                TrainCount = train,
                ValidCount = valid,
                FolderName = folderName,
                ImageWidth = imageWidth,
                ImageHeight = imageHeight,
                Nc = nc,
                ValidRatio = validRatio,
                N1 = n1,
                N2 = n2,
                Seed = seed
            });
        }
    }

    async Task ConfirmDeleteExport(string folderName)
    {
        var folder = Path.Combine(Env.WebRootPath, "exports", folderName);
        var zipFile = Path.Combine(Env.WebRootPath, "exports", folderName + ".zip");

        if (Directory.Exists(folder))
        {
            if (await JS.InvokeAsync<bool>("confirm", $"Export 폴더를 삭제할까요?\n{folderName}"))
            {
                try
                {
                    Directory.Delete(folder, true);
                    if (File.Exists(zipFile))
                    {
                        File.Delete(zipFile);
                    }
                    exportInfos.RemoveAll(x => x.FolderName == folderName);
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("alert", $"삭제 실패: {ex.Message}");
                }
            }
        }
    }



    // === Viewer state ===
    ExportRow? selectedExport;
    string? selectedExportFolder;
    string activeTab = "yaml";

    string yamlText = "";
    List<string>? trainImages, validImages, trainLabels, validLabels;

    // Lightbox
    bool _lightboxVisible = false;
    string? _lightboxSrc = null;

    void SwitchTab(string tab) => activeTab = tab;

    void OpenLightbox(string url)
    {
        _lightboxSrc = url;
        _lightboxVisible = true;
        StateHasChanged();
    }
    void CloseLightbox()
    {
        _lightboxVisible = false;
        _lightboxSrc = null;
    }

    // 파일 URL 유틸: wwwroot 기준 상대경로를 브라우저 경로로 변환
    static List<string> ToUrls(string folderAbsPath, string webBase)
    {
        if (!Directory.Exists(folderAbsPath)) return new();
        // 확장 필터를 이미지/라벨 별로 분기하지 않고, 호출부에서 폴더로 구분
        var files = Directory.GetFiles(folderAbsPath);
        // 정렬(자연스러운 이름순)
        Array.Sort(files, StringComparer.OrdinalIgnoreCase);
        return files.Select(f => $"{webBase}/{Path.GetFileName(f)}").ToList();
    }


    static readonly string[] ImgExts = new[] { ".jpg", ".jpeg", ".png", ".bmp", ".gif", ".webp" };

    static List<string> ToFileUrls(string folderAbsPath, string webBase, string[]? allowExts = null)
    {
        var list = new List<string>();
        if (!Directory.Exists(folderAbsPath)) return list;

        var files = Directory.GetFiles(folderAbsPath);
        Array.Sort(files, StringComparer.OrdinalIgnoreCase);

        foreach (var f in files)
        {
            var ext = Path.GetExtension(f);
            if (allowExts != null && !allowExts.Any(e => string.Equals(e, ext, StringComparison.OrdinalIgnoreCase)))
                continue;

            var name = Path.GetFileName(f);
            var encoded = System.Net.WebUtility.UrlEncode(name); // 🔒 한글/공백 대비
            list.Add($"{webBase}/{encoded}");
        }
        return list;
    }

    // 보기 열기
    async Task OpenViewExport(string folderName)
    {
        selectedExportFolder = folderName;

        var baseFolder = Path.Combine(Env.WebRootPath, "exports", folderName);
        var webBase = $"/exports/{folderName}";

        // YAML
        var yamlPath = Path.Combine(baseFolder, "data.yaml");
        yamlText = File.Exists(yamlPath) ? await File.ReadAllTextAsync(yamlPath) : "(data.yaml not found)";

        // 이미지/라벨 경로
        var trainImgDir = Path.Combine(baseFolder, "train", "images");
        var trainLblDir = Path.Combine(baseFolder, "train", "labels");
        var validImgDir = Path.Combine(baseFolder, "valid", "images");
        var validLblDir = Path.Combine(baseFolder, "valid", "labels");

        trainImages = ToFileUrls(trainImgDir, $"{webBase}/train/images", ImgExts);
        validImages = ToFileUrls(validImgDir, $"{webBase}/valid/images", ImgExts);
        trainLabels = ToFileUrls(trainLblDir, $"{webBase}/train/labels", new[] { ".txt" });
        validLabels = ToFileUrls(validLblDir, $"{webBase}/valid/labels", new[] { ".txt" });

        // 기본 탭은 YAML로
        activeTab = "yaml";

        // 모달 열기
        await JS.InvokeVoidAsync("bootstrapModalShow", "#viewExportModal");
        StateHasChanged();
    }

    async Task CloseViewExport()
    {
        await JS.InvokeVoidAsync("bootstrapModalHide", "#viewExportModal");
        // 필요 시 상태 초기화
        // selectedExportFolder = null; yamlText = "";
        // trainImages = validImages = trainLabels = validLabels = null;
    }


    bool _txtPreviewVisible = false;
    string? _txtPreviewTitle = null;
    string? _txtPreviewContent = null;

    async Task OpenTxtPreview(string webUrl)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedExportFolder))
                return;

            var decodedUrl = System.Net.WebUtility.UrlDecode(webUrl);
            var fileName = Path.GetFileName(decodedUrl);

            var isTrain = decodedUrl.Contains("/train/labels/", StringComparison.OrdinalIgnoreCase);
            var isValid = decodedUrl.Contains("/valid/labels/", StringComparison.OrdinalIgnoreCase);
            if (!isTrain && !isValid) return;

            var labelsDir = Path.Combine(
                Env.WebRootPath, "exports", selectedExportFolder!,
                isTrain ? "train" : "valid", "labels"
            );
            var absPath = Path.Combine(labelsDir, fileName);

            if (!System.IO.File.Exists(absPath))
            {
                _txtPreviewTitle = fileName;
                _txtPreviewContent = "(파일을 찾을 수 없습니다)";
            }
            else
            {
                using var fs = new FileStream(absPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                using var sr = new StreamReader(fs, detectEncodingFromByteOrderMarks: true);
                _txtPreviewTitle = fileName;
                _txtPreviewContent = await sr.ReadToEndAsync();
            }

            _txtPreviewVisible = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _txtPreviewTitle = "미리보기 오류";
            _txtPreviewContent = ex.Message;
            _txtPreviewVisible = true;
            StateHasChanged();
        }
    }

    void CloseTxtPreview()
    {
        _txtPreviewVisible = false;
        _txtPreviewTitle = null;
        _txtPreviewContent = null;
    }
}
