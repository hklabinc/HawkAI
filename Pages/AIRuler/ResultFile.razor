@page "/airuler/results/{ModelName}/{FileName}"
@page "/airuler/results/{ModelName}/device/{DeviceId}/{FileName}"

@using HawkAI.Data
@using HawkAI.Data.AirulerResultService
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web

@inject DataDbContext Db
@inject IWebHostEnvironment Env


<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="mb-0">
        <strong>@ModelName</strong>
        @if (!string.IsNullOrWhiteSpace(DeviceId))
        {
            <span class="text-muted" style="font-size: 0.95rem;"> · device: @DeviceId</span>
        }
        <span class="text-muted" style="font-size: 0.95rem;">@("/" + FileName)</span>
    </h4>

    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/airuler/results">List</a>
        @if (!string.IsNullOrWhiteSpace(ModelName))
        {
            <a class="btn btn-sm btn-outline-secondary" href="@BackUrl">Back</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-warning mt-3">@_loadError</div>
}
else if (_record == null)
{
    <div class="text-muted mt-3">Record not found.</div>
}
else
{
    <div class="mt-3">
        <div class="airuler-resultfile-viewer"
             tabindex="0"
             @ref="_viewerRef"
             title="Click to focus · Ctrl+'+'/'-' zoom · Ctrl+Arrow pan"
             @onclick="FocusViewerAsync"
             @onkeydown="OnViewerKeyDown"
             @onkeydown:preventDefault="true">
            <div class="airuler-resultfile-transform" style="@TransformStyle">
                <img class="airuler-resultfile-image" src="@_imageUrl" alt="@FileName" />
            </div>
        </div>

        <div class="mt-2 small text-muted">
            <b>Time</b>: @_record.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            <span class="text-muted"> · </span>
            <b>Device</b>: @_record.DeviceId
            <span class="text-muted"> · </span>
            <b>Size</b>: @_record.ImageSize
            <span class="text-muted"> · </span>
            <b>Method</b>: @_record.MeasureMethod
        </div>
    </div>

    <hr class="my-4" />

    <h6><strong>Raw JSON (EXIF UserComment)</strong></h6>
    <pre style="max-height: 70vh; overflow: auto; background: #fafafa; border: 1px solid #eee; padding: 8px;">@_jsonText</pre>
}

@code {
    [Parameter] public string? ModelName { get; set; }
    [Parameter] public string? DeviceId { get; set; }
    [Parameter] public string? FileName { get; set; }

    private AirulerFilmMeasureResult? _record;
    private string? _loadError;
    private string _jsonText = string.Empty;
    private string _imageUrl = string.Empty;

    // ✅ viewer focus
    private ElementReference _viewerRef;
    private async Task FocusViewerAsync()
    {
        // 클릭하면 키보드 입력이 바로 먹도록 포커스
        await _viewerRef.FocusAsync();
    }

    // ✅ Image viewer transform (Ctrl+'+'/'-' zoom, Ctrl+Arrow pan)
    private double _zoomFactor = 1.0;
    private int _panX = 0;
    private int _panY = 0;

    private string TransformStyle
        => string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "transform: translate({0}px, {1}px) scale({2});",
            _panX, _panY, _zoomFactor
        );

    private Task OnViewerKeyDown(KeyboardEventArgs e)
    {
        if (!e.CtrlKey)
            return Task.CompletedTask;

        var handled = false;

        // Ctrl + '+' / '=' : zoom in
        if (e.Key == "+" || e.Key == "=" || e.Key == "Add")
        {
            _zoomFactor = Math.Min(10.0, _zoomFactor * 1.1);
            handled = true;
        }
        // Ctrl + '-' : zoom out
        else if (e.Key == "-" || e.Key == "Subtract")
        {
            _zoomFactor = Math.Max(0.1, _zoomFactor / 1.1);
            handled = true;
        }
        // Ctrl + Arrow : pan
        else if (!string.IsNullOrWhiteSpace(e.Key) && e.Key.StartsWith("Arrow", StringComparison.Ordinal))
        {
            const int step = 20;

            if (e.Key == "ArrowLeft") _panX += step;
            if (e.Key == "ArrowRight") _panX -= step;
            if (e.Key == "ArrowUp") _panY += step;
            if (e.Key == "ArrowDown") _panY -= step;

            handled = true;
        }

        if (handled)
            StateHasChanged();

        return Task.CompletedTask;
    }

    private string BackUrl
        => string.IsNullOrWhiteSpace(ModelName)
            ? "/airuler/results"
            : string.IsNullOrWhiteSpace(DeviceId)
                ? $"/airuler/results/{Uri.EscapeDataString(ModelName)}"
                : $"/airuler/results/{Uri.EscapeDataString(ModelName)}/device/{Uri.EscapeDataString(DeviceId)}";

    protected override async Task OnParametersSetAsync()
    {
        _record = null;
        _loadError = null;
        _jsonText = string.Empty;
        _imageUrl = string.Empty;

        // ✅ 리셋: 기본은 “창에 맞춰 보이는 상태” (img width:100% 덕분에 너무 크게 안 나옴)
        _zoomFactor = 1.0;
        _panX = 0;
        _panY = 0;

        if (string.IsNullOrWhiteSpace(ModelName) || string.IsNullOrWhiteSpace(FileName))
        {
            _loadError = "Invalid route.";
            return;
        }

        try
        {
            var query = Db.AirulerFilmMeasureResults
                .AsNoTracking()
                .Where(x => x.ModelName == ModelName && x.FileName == FileName);

            if (!string.IsNullOrWhiteSpace(DeviceId))
                query = query.Where(x => x.DeviceId == DeviceId);

            _record = await query.FirstOrDefaultAsync();

            if (_record == null)
                return;

            _imageUrl = ImageUrl(_record.ModelName, _record.FileName);

            var jsonPath = JsonFilePath(_record.ModelName, _record.FileName);
            if (System.IO.File.Exists(jsonPath))
                _jsonText = await System.IO.File.ReadAllTextAsync(jsonPath);
            else
                _jsonText = "(JSON file not found on server.)";
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private string ResultsRoot => Path.Combine(Env.WebRootPath, "airuler", "results");

    private static string ImageUrl(string modelName, string fileName)
        => $"/airuler/results/{Uri.EscapeDataString(modelName)}/image/{Uri.EscapeDataString(fileName)}";

    private string JsonFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName), "json", Path.GetFileNameWithoutExtension(fileName) + ".json");
}
