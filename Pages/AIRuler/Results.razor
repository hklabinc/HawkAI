@page "/airuler/results"

@using HawkAI.Data
@using HawkAI.Data.AirulerResultService
@using HawkAI.Helper
@using Microsoft.EntityFrameworkCore

@inject DataDbContext Db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject NavigationManager Nav

<h4><strong>AIRuler Result</strong> (@_modelCards.Count)</h4>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <button class="btn btn-outline-primary" @onclick="ReloadAsync">
        <span class="oi oi-reload"></span>
        Refresh
    </button>

    <button class="btn btn-danger" @onclick="ConfirmDeleteSelectedModelsAsync" disabled="@(!_modelCards.Any(x => x.IsSelectedForDelete))">
        <span class="oi oi-trash"></span>
        Delete Selected
    </button>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <span class="text-danger small">@_loadError</span>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <span class="text-muted small">@_statusMessage</span>
    }
</div>

@if (_modelCards.Count == 0)
{
    <div class="text-muted">No results found. Upload results via <code>/api/airuler/upload-results</code>.</div>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var m in _modelCards)
        {
            <div class="card" style="width: 320px; position: relative;">
                <img src="@m.RepresentativeThumbnailUrl"
                     class="card-img-top"
                     style="height: 180px; object-fit: contain; object-position: center; background: #f8f9fa; cursor: pointer;"
                     @onclick="() => GoToModel(m.ModelName)" />

                <div class="card-body" style="cursor:pointer;" @onclick="() => GoToModel(m.ModelName)">
                    <h5 class="card-title mb-1 d-flex align-items-center gap-2">
                        <strong class="text-truncate" style="max-width: 180px;">@m.ModelName</strong>
                        <span class="text-muted" style="font-size: 0.95rem;">(@m.FileCount)</span>

                        <button class="btn btn-sm btn-outline-secondary ms-auto"
                                type="button"
                                @onclick:stopPropagation="true"
                                @onclick="() => OpenRenameModal(m.ModelName)">
                            Edit
                        </button>
                    </h5>
                    <p class="card-text text-muted" style="font-size: 0.85rem;">
                        Updated @m.LatestTimestampLocal
                    </p>
                </div>

                <!-- 카드 우측 상단 Delete Selected 체크박스 -->
                <div class="position-absolute top-0 end-0 m-2">
                    <input type="checkbox" class="form-check-input" @bind="m.IsSelectedForDelete" />
                </div>
            </div>
        }
    </div>
}

@if (_showRenameModal)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>

    <!-- Modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.2);">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 420px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><b>Rename Model</b></h6>
                    <button type="button" class="btn-close" @onclick="CloseRenameModal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Current</label>
                        <input class="form-control" value="@_renameOldName" disabled />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">New model name</label>
                        <input class="form-control" @bind="_renameNewName" placeholder="e.g. M2379-00" />
                        <div class="form-text">Allowed: A-Z, a-z, 0-9, '_' '-'</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_renameError))
                    {
                        <div class="text-danger small">@_renameError</div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseRenameModal" disabled="@_renaming">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmAndRenameModelAsync" disabled="@_renaming">
                        @(_renaming ? "Renaming..." : "Rename")
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    // ---- Rename Modal State ----
    private bool _showRenameModal = false;
    private bool _renaming = false;
    private string _renameOldName = "";
    private string _renameNewName = "";
    private string? _renameError;

    private sealed class ModelCardVm
    {
        public string ModelName { get; init; } = string.Empty;
        public int FileCount { get; init; }
        public DateTime LatestTimestampUtc { get; init; }
        public string RepresentativeThumbnailUrl { get; init; } = string.Empty;
        public bool IsSelectedForDelete { get; set; }

        public string LatestTimestampLocal => LatestTimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private List<ModelCardVm> _modelCards = new();
    private string? _loadError;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private static string ThumbUrl(string modelName, string fileName)
        => $"/airuler/results/{Uri.EscapeDataString(modelName)}/thumbnail/{Uri.EscapeDataString(fileName)}";

    private async Task ReloadAsync()
    {
        _loadError = null;
        _statusMessage = null;

        try
        {
            // 체크 상태 보존용
            var prev = _modelCards.ToDictionary(x => x.ModelName, x => x.IsSelectedForDelete, StringComparer.OrdinalIgnoreCase);

            var all = await Db.AirulerFilmMeasureResults
                .AsNoTracking()
                .ToListAsync();

            _modelCards = all
                .GroupBy(x => x.ModelName, StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var latest = g.OrderByDescending(x => x.TimestampUtc).First();
                    return new ModelCardVm
                    {
                        ModelName = latest.ModelName,
                        FileCount = g.Count(),
                        LatestTimestampUtc = latest.TimestampUtc,
                        RepresentativeThumbnailUrl = ThumbUrl(latest.ModelName, latest.FileName),
                        IsSelectedForDelete = prev.TryGetValue(latest.ModelName, out var sel) && sel
                    };
                })
                .OrderByDescending(x => x.LatestTimestampUtc)
                .ThenBy(x => x.ModelName)
                .ToList();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _modelCards = new();
        }
    }

    private void GoToModel(string modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
            return;

        Nav.NavigateTo($"/airuler/results/{Uri.EscapeDataString(modelName)}");
    }

    private string ResultsRoot => Path.Combine(Env.WebRootPath, "airuler", "results");

    private string ModelDirPath(string modelName)
        => Path.Combine(ResultsRoot, modelName);

    private async Task ConfirmDeleteSelectedModelsAsync()
    {
        var selected = _modelCards.Where(x => x.IsSelectedForDelete).Select(x => x.ModelName).ToList();
        if (selected.Count == 0) return;

        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete selected model(s): {selected.Count}?\nThis will remove all DB rows and files under /airuler/results/{{model}}.");
        if (!ok) return;

        await DeleteModelsAsync(selected);
    }

    private async Task DeleteModelsAsync(List<string> modelNames)
    {
        try
        {
            var rows = await Db.AirulerFilmMeasureResults
                .Where(x => modelNames.Contains(x.ModelName))
                .ToListAsync();

            Db.AirulerFilmMeasureResults.RemoveRange(rows);
            await Db.SaveChangesAsync();

            // 폴더 삭제
            foreach (var m in modelNames)
            {
                var dir = ModelDirPath(m);
                SafeDeleteDirectory(dir);
            }

            _statusMessage = $"Deleted models: {string.Join(", ", modelNames)}";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Delete models failed: {ex.Message}";
        }
    }

    private void SafeDeleteDirectory(string path)
    {
        try
        {
            var full = Path.GetFullPath(path);
            var root = Path.GetFullPath(ResultsRoot);
            if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase)) return;

            if (Directory.Exists(full))
                Directory.Delete(full, recursive: true);
        }
        catch
        {
            // ignore
        }
    }

    private void OpenRenameModal(string modelName)
    {
        _renameOldName = modelName;
        _renameNewName = modelName; // 디폴트로 현재 이름
        _renameError = null;
        _showRenameModal = true;
    }

    private void CloseRenameModal()
    {
        _showRenameModal = false;
        _renaming = false;
        _renameError = null;
    }

    private async Task ConfirmAndRenameModelAsync()
    {
        if (_renaming) return;

        var oldName = (_renameOldName ?? "").Trim();
        var newNameRaw = (_renameNewName ?? "").Trim();

        if (string.IsNullOrWhiteSpace(oldName))
        {
            _renameError = "Invalid current name.";
            return;
        }

        var newName = AirulerNameHelper.SanitizeModelName(newNameRaw);
        if (string.IsNullOrWhiteSpace(newName))
        {
            _renameError = "New model name is empty.";
            return;
        }

        if (string.Equals(oldName, newName, StringComparison.OrdinalIgnoreCase))
        {
            // 이름이 사실상 동일하면 그냥 닫기
            CloseRenameModal();
            return;
        }

        // 이미 존재하는지(카드 목록 기준)
        if (_modelCards.Any(x => string.Equals(x.ModelName, newName, StringComparison.OrdinalIgnoreCase)))
        {
            _renameError = $"Model '{newName}' already exists.";
            return;
        }

        var ok = await JS.InvokeAsync<bool>(
            "confirm",
            $"Rename model?\n\nFrom: {oldName}\nTo: {newName}\n\nThis will update DB rows and rename folder under /airuler/results/."
        );

        if (!ok) return;

        _renaming = true;
        _renameError = null;

        try
        {
            await RenameModelAsync(oldName, newName);
            CloseRenameModal();
            _statusMessage = $"Renamed: {oldName} → {newName}";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
        }
        finally
        {
            _renaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RenameModelAsync(string oldName, string newName)
    {
        // 1) 폴더 rename (가능하면 먼저 시도해서 충돌/권한 문제를 빨리 감지)
        var oldDir = ModelDirPath(oldName);
        var newDir = ModelDirPath(newName);

        if (!Directory.Exists(oldDir))
            throw new Exception($"Folder not found: {oldDir}");

        if (Directory.Exists(newDir))
            throw new Exception($"Target folder already exists: {newDir}");

        // 경로 안전성 체크
        EnsureUnderResultsRoot(oldDir);
        EnsureUnderResultsRoot(newDir);

        Directory.Move(oldDir, newDir);

        // 2) DB 업데이트
        var rows = await Db.AirulerFilmMeasureResults
            .Where(x => x.ModelName == oldName)
            .ToListAsync();

        foreach (var r in rows)
            r.ModelName = newName;

        await Db.SaveChangesAsync();
    }

    private void EnsureUnderResultsRoot(string path)
    {
        var full = Path.GetFullPath(path);
        var root = Path.GetFullPath(ResultsRoot);
        if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase))
            throw new Exception("Invalid path (outside results root).");
    }
}
