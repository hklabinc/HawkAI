@page "/airuler/results"

@using System.Text
@using System.Text.Json
@using System.Text.Encodings.Web
@using HawkAI.Data
@using HawkAI.Data.AirulerResultService
@using HawkAI.Helper
@using Microsoft.EntityFrameworkCore

@inject DataDbContext Db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject NavigationManager Nav

<h4><strong>AIRuler Result</strong> (@_modelCards.Count)</h4>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <button class="btn btn-outline-primary" @onclick="ReloadAsync">
        <span class="oi oi-reload"></span>
        Refresh
    </button>

    <button class="btn btn-success"
            @onclick="PrepareCopyOrMerge"
            disabled="@(!_modelCards.Any(x => x.IsSelectedForDelete))">
        <span class="oi oi-transfer"></span>
        Copy / Merge
    </button>

    <button class="btn btn-danger" @onclick="ConfirmDeleteSelectedModelsAsync" disabled="@(!_modelCards.Any(x => x.IsSelectedForDelete))">
        <span class="oi oi-trash"></span>
        Delete Selected
    </button>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <span class="text-danger small">@_loadError</span>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <span class="text-muted small">@_statusMessage</span>
    }
</div>

@if (_modelCards.Count == 0)
{
    <div class="text-muted">No results found. Upload results via <code>/api/airuler/upload-results</code>.</div>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var m in _modelCards)
        {
            <div class="card" style="width: 320px; position: relative;">
                <img src="@m.RepresentativeImageUrl"
                     class="card-img-top"
                     style="height: 180px; object-fit: contain; object-position: center; background: #f8f9fa; cursor: pointer;"
                     @onclick="() => GoToModel(m.ModelName, m.DeviceId)" />

                <div class="card-body" style="cursor:pointer;" @onclick="() => GoToModel(m.ModelName, m.DeviceId)">
                    <h5 class="card-title mb-1 d-flex align-items-center gap-2">
                        <strong class="text-truncate" style="max-width: 180px;">@m.ModelName</strong>
                        <span class="text-muted" style="font-size: 0.95rem;">(@m.FileCount)</span>

                        <button class="btn btn-sm btn-outline-secondary ms-auto"
                                type="button"
                                @onclick:stopPropagation="true"
                                @onclick="() => OpenRenameModal(m.ModelName)">
                            Edit
                        </button>
                    </h5>
                    <p class="card-text text-muted mb-0" style="font-size: 0.85rem;">
                        Updated @m.LatestTimestampLocal
                    </p>
                    <p class="card-text text-muted mb-0" style="font-size: 0.85rem;">
                        Created by @m.DeviceId
                    </p>
                </div>

                <!-- 카드 우측 상단 Delete Selected 체크박스 -->
                <div class="position-absolute top-0 end-0 m-2">
                    <input type="checkbox" class="form-check-input" @bind="m.IsSelectedForDelete" />
                </div>
            </div>
        }
    </div>
}

@if (_showRenameModal)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>

    <!-- Modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.2);">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 420px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><b>Rename Model</b></h6>
                    <button type="button" class="btn-close" @onclick="CloseRenameModal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Current</label>
                        <input class="form-control" value="@_renameOldName" disabled />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">New model name</label>
                        <input class="form-control" @bind="_renameNewName" placeholder="e.g. M2379-00" />
                        <div class="form-text">Allowed: A-Z, a-z, 0-9, '_' '-'</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_renameError))
                    {
                        <div class="text-danger small">@_renameError</div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseRenameModal" disabled="@_renaming">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmAndRenameModelAsync" disabled="@_renaming">
                        @(_renaming ? "Renaming..." : "Rename")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCopyMergeModal)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>

    <!-- Modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.2);">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 460px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <b>@(_copyMergeIsCopyMode ? "Copy Model" : "Merge Models")</b>
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseCopyMergeModal"></button>
                </div>

                <div class="modal-body">
                    @if (_copyMergeIsCopyMode)
                    {
                        <div class="small text-muted mb-2">
                            Copy model: <b>@(_copyMergeSources.FirstOrDefault() ?? "")</b>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">
                            Merge models (@_copyMergeSources.Count):
                        </div>
                        <div class="border rounded p-2" style="max-height: 120px; overflow:auto;">
                            <ul class="mb-0 small">
                                @foreach (var s in _copyMergeSources)
                                {
                                    <li>@s</li>
                                }
                            </ul>
                        </div>

                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="allowDup" @bind="_copyMergeAllowDuplicates" />
                            <label class="form-check-label small" for="allowDup">
                                Allow duplicate filenames (auto rename with _1, _2...)
                            </label>
                        </div>
                    }

                    <div class="mt-3">
                        <label class="form-label">Target model name</label>
                        <input class="form-control" @bind="_copyMergeTargetName" placeholder="e.g. M2379-00" />
                        <div class="form-text">Allowed: A-Z, a-z, 0-9, '_' '-'</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_copyMergeError))
                    {
                        <div class="text-danger small mt-2">@_copyMergeError</div>
                    }
            </div>

            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseCopyMergeModal" disabled="@_copyMergeWorking">Cancel</button>
                <button class="btn btn-sm btn-success"
                        @onclick="ExecuteCopyOrMergeAsync"
                        disabled="@_copyMergeWorking">
                    @(_copyMergeWorking
                                        ? (_copyMergeIsCopyMode ? "Copying..." : "Merging...")
                                        : (_copyMergeIsCopyMode ? "Copy" : "Merge"))
                </button>
            </div>
        </div>
    </div>
</div>
}


@code {
    // ---- Rename Modal State ----
    private bool _showRenameModal = false;
    private bool _renaming = false;
    private string _renameOldName = "";
    private string _renameNewName = "";
    private string? _renameError;

    // ---- Copy/Merge Modal State ----
    private bool _showCopyMergeModal = false;
    private bool _copyMergeIsCopyMode = true;
    private bool _copyMergeWorking = false;
    private bool _copyMergeAllowDuplicates = true;
    private string _copyMergeTargetName = "";
    private string? _copyMergeError;
    private List<string> _copyMergeSources = new();

    private sealed class ModelCardVm
    {
        public string ModelName { get; init; } = string.Empty;
        public string DeviceId { get; init; } = string.Empty;   // ✅ 추가
        public int FileCount { get; init; }
        public DateTime LatestTimestampUtc { get; init; }
        public string RepresentativeImageUrl { get; init; } = string.Empty;
        public bool IsSelectedForDelete { get; set; }

        public string LatestTimestampLocal => LatestTimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private List<ModelCardVm> _modelCards = new();
    private string? _loadError;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private static string ImageUrl(string modelName, string fileName)
        => $"/airuler/results/{Uri.EscapeDataString(modelName)}/image/{Uri.EscapeDataString(fileName)}";

    private async Task ReloadAsync()
    {
        _loadError = null;
        _statusMessage = null;

        try
        {
                // 체크 상태 보존용 (ModelName + DeviceId 기준)
            var prev = _modelCards.ToDictionary(
                x => $"{x.ModelName}||{x.DeviceId}",
                x => x.IsSelectedForDelete,
                StringComparer.OrdinalIgnoreCase);

            var all = await Db.AirulerFilmMeasureResults
                .AsNoTracking()
                .ToListAsync();

            _modelCards = all
                .GroupBy(x => $"{x.ModelName}||{x.DeviceId}", StringComparer.OrdinalIgnoreCase) // ✅ 변경
                .Select(g =>
                {
                    var latest = g.OrderByDescending(x => x.TimestampUtc).First();
                    var key = $"{latest.ModelName}||{latest.DeviceId}";

                    return new ModelCardVm
                    {
                        ModelName = latest.ModelName,
                        DeviceId = latest.DeviceId ?? string.Empty, // ✅
                        FileCount = g.Count(),
                        LatestTimestampUtc = latest.TimestampUtc,
                        RepresentativeImageUrl = ImageUrl(latest.ModelName, latest.FileName),
                        IsSelectedForDelete = prev.TryGetValue(key, out var sel) && sel
                    };
                })
                .OrderByDescending(x => x.LatestTimestampUtc)
                .ThenBy(x => x.ModelName)
                .ThenBy(x => x.DeviceId)
                .ToList();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _modelCards = new();
        }
    }

    private void GoToModel(string modelName, string deviceId)
    {
        if (string.IsNullOrWhiteSpace(modelName))
            return;

        if (string.IsNullOrWhiteSpace(deviceId))
        {
            Nav.NavigateTo($"/airuler/results/{Uri.EscapeDataString(modelName)}");
            return;
        }

        Nav.NavigateTo($"/airuler/results/{Uri.EscapeDataString(modelName)}/device/{Uri.EscapeDataString(deviceId)}");
    }

    private string ResultsRoot => Path.Combine(Env.WebRootPath, "airuler", "results");

    private string ModelDirPath(string modelName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName));

    private string ImageFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName), "image", Path.GetFileName(fileName));

    private string JsonFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName), "json", Path.GetFileNameWithoutExtension(fileName) + ".json");

    private void SafeDeleteFile(string path)
    {
        try
        {
            var full = Path.GetFullPath(path);
            var root = Path.GetFullPath(ResultsRoot);
            if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase)) return;

            if (System.IO.File.Exists(full))
                System.IO.File.Delete(full);
        }
        catch
        {
            // ignore
        }
    }

    private async Task ConfirmDeleteSelectedModelsAsync()
    {
        var selected = _modelCards
            .Where(x => x.IsSelectedForDelete)
            .Select(x => (ModelName: x.ModelName, DeviceId: x.DeviceId))
            .ToList();

        if (selected.Count == 0) return;

        var ok = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete selected card(s): {selected.Count}?\nThis will remove DB rows and files for the selected (model, device) groups."
        );
        if (!ok) return;

        await DeleteModelsAsync(selected);
    }

    private async Task DeleteModelsAsync(List<(string ModelName, string DeviceId)> modelDeviceKeys)
    {
        try
        {
            var rowsToDelete = new List<AirulerFilmMeasureResult>();
            var affectedModels = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var (modelName, deviceId) in modelDeviceKeys)
            {
                if (string.IsNullOrWhiteSpace(modelName))
                    continue;

                affectedModels.Add(modelName);

                var rows = await Db.AirulerFilmMeasureResults
                    .Where(x => x.ModelName == modelName && x.DeviceId == deviceId)
                    .ToListAsync();

                // 파일 삭제(실패해도 계속)
                foreach (var r in rows)
                {
                    SafeDeleteFile(ImageFilePath(r.ModelName, r.FileName));
                    SafeDeleteFile(JsonFilePath(r.ModelName, r.FileName));
                }

                rowsToDelete.AddRange(rows);
            }

            if (rowsToDelete.Count > 0)
            {
                Db.AirulerFilmMeasureResults.RemoveRange(rowsToDelete);
                await Db.SaveChangesAsync();
            }

            // 모델에 남은 row가 하나도 없으면 폴더 삭제
            foreach (var modelName in affectedModels)
            {
                var stillExists = await Db.AirulerFilmMeasureResults
                    .AsNoTracking()
                    .AnyAsync(x => x.ModelName == modelName);

                if (!stillExists)
                    SafeDeleteDirectory(ModelDirPath(modelName));
            }

            _statusMessage = $"Deleted: {modelDeviceKeys.Count} card(s), {rowsToDelete.Count} file(s)";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Delete models failed: {ex.Message}";
        }
    }

    private void SafeDeleteDirectory(string path)
    {
        try
        {
            var full = Path.GetFullPath(path);
            var root = Path.GetFullPath(ResultsRoot);
            if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase)) return;

            if (Directory.Exists(full))
                Directory.Delete(full, recursive: true);
        }
        catch
        {
            // ignore
        }
    }

    private void OpenRenameModal(string modelName)
    {
        _renameOldName = modelName;
        _renameNewName = modelName; // 디폴트로 현재 이름
        _renameError = null;
        _showRenameModal = true;
    }

    private void CloseRenameModal()
    {
        _showRenameModal = false;
        _renaming = false;
        _renameError = null;
    }

    private async Task ConfirmAndRenameModelAsync()
    {
        if (_renaming) return;

        var oldName = (_renameOldName ?? "").Trim();
        var newNameRaw = (_renameNewName ?? "").Trim();

        if (string.IsNullOrWhiteSpace(oldName))
        {
            _renameError = "Invalid current name.";
            return;
        }

        var newName = AirulerNameHelper.SanitizeModelName(newNameRaw);
        if (string.IsNullOrWhiteSpace(newName))
        {
            _renameError = "New model name is empty.";
            return;
        }

        if (string.Equals(oldName, newName, StringComparison.OrdinalIgnoreCase))
        {
            // 이름이 사실상 동일하면 그냥 닫기
            CloseRenameModal();
            return;
        }

        // 이미 존재하는지(카드 목록 기준)
        if (_modelCards.Any(x => string.Equals(x.ModelName, newName, StringComparison.OrdinalIgnoreCase)))
        {
            _renameError = $"Model '{newName}' already exists.";
            return;
        }

        _renaming = true;
        _renameError = null;

        try
        {
            await RenameModelAsync(oldName, newName);
            CloseRenameModal();
            _statusMessage = $"Renamed: {oldName} → {newName}";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
        }
        finally
        {
            _renaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RenameModelAsync(string oldName, string newName)
    {
        // 1) 폴더 rename (가능하면 먼저 시도해서 충돌/권한 문제를 빨리 감지)
        var oldDir = ModelDirPath(oldName);
        var newDir = ModelDirPath(newName);

        if (!Directory.Exists(oldDir))
            throw new Exception($"Folder not found: {oldDir}");

        if (Directory.Exists(newDir))
            throw new Exception($"Target folder already exists: {newDir}");

        // 경로 안전성 체크
        EnsureUnderResultsRoot(oldDir);
        EnsureUnderResultsRoot(newDir);

        Directory.Move(oldDir, newDir);

        // 2) DB 업데이트
        var rows = await Db.AirulerFilmMeasureResults
            .Where(x => x.ModelName == oldName)
            .ToListAsync();

        foreach (var r in rows)
            r.ModelName = newName;

        await Db.SaveChangesAsync();
    }

    private void EnsureUnderResultsRoot(string path)
    {
        var full = Path.GetFullPath(path);
        var root = Path.GetFullPath(ResultsRoot);
        if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase))
            throw new Exception("Invalid path (outside results root).");
    }

    // =========================
    // Copy / Merge
    // =========================
    private async Task PrepareCopyOrMerge()
    {
        var selected = _modelCards
            .Where(x => x.IsSelectedForDelete)
            .Select(x => x.ModelName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (selected.Count == 0)
        {
            await JS.InvokeVoidAsync("alert", "⚠️ Please select at least one model.");
            return;
        }

        // Rename modal이 켜져있으면 닫아주기(중복 모달 방지)
        _showRenameModal = false;

        if (selected.Count == 1)
            OpenCopyModal(selected[0]);
        else
            OpenMergeModal(selected);
    }

    private void OpenCopyModal(string sourceModel)
    {
        _copyMergeIsCopyMode = true;
        _copyMergeSources = new List<string> { sourceModel };
        _copyMergeAllowDuplicates = true; // copy 모드에서는 의미 없음
        _copyMergeTargetName = $"{sourceModel}_Copy_{DateTime.Now:yyyyMMdd_HHmmss}";
        _copyMergeError = null;
        _showCopyMergeModal = true;
    }

    private void OpenMergeModal(List<string> sources)
    {
        _copyMergeIsCopyMode = false;
        _copyMergeSources = sources
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        _copyMergeAllowDuplicates = true;

        // 기본값은 선택한 모델명들을 '-'로 연결(너무 길면 fallback)
        var joined = string.Join("-", _copyMergeSources);
        _copyMergeTargetName = joined.Length <= 80 ? joined : $"Merged_{DateTime.Now:yyyyMMdd_HHmmss}";

        _copyMergeError = null;
        _showCopyMergeModal = true;
    }

    private void CloseCopyMergeModal()
    {
        _showCopyMergeModal = false;
        _copyMergeWorking = false;
        _copyMergeError = null;
        _copyMergeSources = new();
        _copyMergeTargetName = "";
        _copyMergeAllowDuplicates = true;
    }

    private async Task ExecuteCopyOrMergeAsync()
    {
        if (_copyMergeWorking)
            return;

        _copyMergeError = null;

        var sources = _copyMergeSources
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (sources.Count == 0)
        {
            _copyMergeError = "No source model selected.";
            return;
        }

        var targetRaw = (_copyMergeTargetName ?? "").Trim();
        var target = AirulerNameHelper.SanitizeModelName(targetRaw);
        if (string.IsNullOrWhiteSpace(target))
        {
            _copyMergeError = "Target model name is empty.";
            return;
        }

        if (sources.Any(s => string.Equals(s, target, StringComparison.OrdinalIgnoreCase)))
        {
            _copyMergeError = "Target model name must be different from selected model(s).";
            return;
        }

        if (await ModelExistsAsync(target))
        {
            _copyMergeError = $"Model '{target}' already exists.";
            return;
        }

        _copyMergeWorking = true;

        try
        {
            int copiedCount;
            if (_copyMergeIsCopyMode)
            {
                copiedCount = await CopyModelAsync(sources[0], target);
                _statusMessage = $"Copied: {sources[0]} → {target} ({copiedCount} file(s))";
            }
            else
            {
                copiedCount = await MergeModelsAsync(sources, target, _copyMergeAllowDuplicates);
                _statusMessage = $"Merged: {string.Join(", ", sources)} → {target} ({copiedCount} file(s))";
            }

            // ✅ 작업 후 선택 해제(실수 방지)
            foreach (var c in _modelCards)
                c.IsSelectedForDelete = false;

            CloseCopyMergeModal();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _copyMergeError = ex.Message;
        }
        finally
        {
            _copyMergeWorking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> ModelExistsAsync(string modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
            return false;

        // 1) 폴더 존재
        var dir = ModelDirPath(modelName);
        EnsureUnderResultsRoot(dir);
        if (Directory.Exists(dir))
            return true;

        // 2) DB 존재
        return await Db.AirulerFilmMeasureResults
            .AsNoTracking()
            .AnyAsync(x => x.ModelName == modelName);
    }

    private async Task<int> CopyModelAsync(string sourceModel, string targetModel)
    {
        // copy는 merge의 special case (source 1개)
        return await CopyOrMergeCoreAsync(new List<string> { sourceModel }, targetModel, allowDuplicateRename: true);
    }

    private async Task<int> MergeModelsAsync(List<string> sourceModels, string targetModel, bool allowDuplicateRename)
    {
        if (sourceModels is null || sourceModels.Count < 2)
            throw new Exception("Select at least 2 models to merge.");

        return await CopyOrMergeCoreAsync(sourceModels, targetModel, allowDuplicateRename);
    }

    private string ModelImageDirPath(string modelName) => Path.Combine(ModelDirPath(modelName), "image");
    private string ModelJsonDirPath(string modelName) => Path.Combine(ModelDirPath(modelName), "json");

    private string ModelImageFilePath(string modelName, string fileName)
        => Path.Combine(ModelImageDirPath(modelName), Path.GetFileName(fileName));

    private string ModelJsonFilePath(string modelName, string fileName)
        => Path.Combine(ModelJsonDirPath(modelName), Path.GetFileNameWithoutExtension(fileName) + ".json");

    private async Task<int> CopyOrMergeCoreAsync(List<string> sourceModels, string targetModel, bool allowDuplicateRename)
    {
        var sources = sourceModels
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (sources.Count == 0)
            throw new Exception("No source models.");

        // Target folders
        Directory.CreateDirectory(ResultsRoot);
        var targetDir = ModelDirPath(targetModel);
        var targetImgDir = ModelImageDirPath(targetModel);
        var targetJsonDir = ModelJsonDirPath(targetModel);

        EnsureUnderResultsRoot(targetDir);
        EnsureUnderResultsRoot(targetImgDir);
        EnsureUnderResultsRoot(targetJsonDir);

        if (Directory.Exists(targetDir))
            throw new Exception($"Target folder already exists: {targetDir}");

        Directory.CreateDirectory(targetImgDir);
        Directory.CreateDirectory(targetJsonDir);

        var usedFileNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var newEntities = new List<AirulerFilmMeasureResult>();

        try
        {
            // 1) 파일 복사 + 엔티티 준비
            foreach (var srcModel in sources)
            {
                var rows = await Db.AirulerFilmMeasureResults
                    .AsNoTracking()
                    .Where(x => x.ModelName == srcModel)
                    .OrderByDescending(x => x.TimestampUtc)
                    .ThenByDescending(x => x.Id)
                    .ToListAsync();

                foreach (var r in rows)
                {
                    var srcFileName = Path.GetFileName(r.FileName);
                    if (string.IsNullOrWhiteSpace(srcFileName))
                        continue;

                    var targetFileName = MakeUniqueFileName(srcFileName, usedFileNames, allowDuplicateRename);
                    if (string.IsNullOrWhiteSpace(targetFileName))
                    {
                        // allowDuplicateRename=false 인 경우 중복은 skip
                        continue;
                    }

                    // image copy (필수)
                    var srcImagePath = ModelImageFilePath(srcModel, srcFileName);
                    var dstImagePath = ModelImageFilePath(targetModel, targetFileName);
                    EnsureUnderResultsRoot(srcImagePath);
                    EnsureUnderResultsRoot(dstImagePath);

                    if (!System.IO.File.Exists(srcImagePath))
                        throw new Exception($"Source image not found: /airuler/results/{srcModel}/image/{srcFileName}");

                    System.IO.File.Copy(srcImagePath, dstImagePath, overwrite: false);

                    // json copy (없으면 fallback 생성)
                    var srcJsonPath = ModelJsonFilePath(srcModel, srcFileName);
                    var dstJsonPath = ModelJsonFilePath(targetModel, targetFileName);
                    EnsureUnderResultsRoot(srcJsonPath);
                    EnsureUnderResultsRoot(dstJsonPath);

                    if (System.IO.File.Exists(srcJsonPath))
                    {
                        System.IO.File.Copy(srcJsonPath, dstJsonPath, overwrite: false);
                    }
                    else
                    {
                        var fallback = BuildFallbackUserCommentJson(r, targetModel);
                        await System.IO.File.WriteAllTextAsync(dstJsonPath, fallback, new UTF8Encoding(false));
                    }

                    // DB row copy
                    newEntities.Add(new AirulerFilmMeasureResult
                    {
                        FileName = targetFileName,
                        TimestampUtc = r.TimestampUtc,
                        DeviceId = r.DeviceId,
                        ModelName = targetModel,
                        ImageSize = r.ImageSize,
                        MeasureMethod = r.MeasureMethod,
                        DetectedFilms = r.DetectedFilms,
                        ResultsJson = r.ResultsJson
                    });
                }
            }

            // 2) DB insert (transaction)
            await using var tx = await Db.Database.BeginTransactionAsync();
            Db.AirulerFilmMeasureResults.AddRange(newEntities);
            await Db.SaveChangesAsync();
            await tx.CommitAsync();

            return newEntities.Count;
        }
        catch
        {
            // 실패 시 폴더 정리
            SafeDeleteDirectory(targetDir);
            throw;
        }
    }

    private static string MakeUniqueFileName(string desired, HashSet<string> used, bool allowDuplicateRename)
    {
        desired = Path.GetFileName(desired);
        if (string.IsNullOrWhiteSpace(desired))
            return string.Empty;

        var baseName = Path.GetFileNameWithoutExtension(desired);
        var ext = Path.GetExtension(desired);
        if (string.IsNullOrWhiteSpace(baseName)) baseName = "result";
        if (string.IsNullOrWhiteSpace(ext)) ext = ".jpg";

        var candidate = $"{baseName}{ext}";
        var i = 1;
        while (!used.Add(candidate))
        {
            if (!allowDuplicateRename)
                return string.Empty;

            candidate = $"{baseName}_{i}{ext}";
            i++;
        }

        return candidate;
    }

    private static (int w, int h) ParseImageSize(string? imageSize)
    {
        if (string.IsNullOrWhiteSpace(imageSize))
            return (0, 0);

        var s = imageSize.Trim();
        var parts = s.Split('*', 'x', 'X');
        if (parts.Length < 2)
            return (0, 0);

        if (int.TryParse(parts[0].Trim(), out var w) && int.TryParse(parts[1].Trim(), out var h))
            return (w, h);

        return (0, 0);
    }

    private static string BuildFallbackUserCommentJson(AirulerFilmMeasureResult row, string modelName)
    {
        // 원본 json 파일이 없어도, 최소한 detail 페이지에서 볼 수 있도록 대체 JSON 생성
        JsonElement resultsEl;
        try
        {
            using var d = JsonDocument.Parse(string.IsNullOrWhiteSpace(row.ResultsJson) ? "[]" : row.ResultsJson);
            resultsEl = d.RootElement.Clone();
        }
        catch
        {
            using var d = JsonDocument.Parse("[]");
            resultsEl = d.RootElement.Clone();
        }

        var (w, h) = ParseImageSize(row.ImageSize);

        var obj = new Dictionary<string, object?>
        {
            ["modelName"] = modelName,
            ["deviceId"] = row.DeviceId,
            ["measureMethod"] = row.MeasureMethod,
            ["detectedFilms"] = row.DetectedFilms,
            ["timestampMs"] = new DateTimeOffset(row.TimestampUtc).ToUnixTimeMilliseconds(),
            ["timestamp"] = row.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"),
            ["image"] = (w > 0 && h > 0) ? new Dictionary<string, object?> { ["width"] = w, ["height"] = h } : null,
            ["results"] = resultsEl
        };

        // null 제거(깨끗하게)
        var cleaned = obj.Where(kv => kv.Value is not null)
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        return JsonSerializer.Serialize(cleaned, new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
