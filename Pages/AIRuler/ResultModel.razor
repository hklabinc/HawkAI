            _calibrationPreview = JsonSerializer.Deserialize<CalibrationPreviewResponse>(raw, CalibrationJsonOpts);

            if (_calibrationPreview == null)
                _calibrationError = "Preview response parse failed.";
        }
        catch (Exception ex)
        {
            _calibrationError = ex.Message;
        }
        finally
        {
            _calibrationPreviewLoading = false;
        }
