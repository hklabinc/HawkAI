@page "/airuler/results/{ModelName}"
@page "/airuler/results/{ModelName}/device/{DeviceId}"

@using System.Text.Json
@using System.Globalization
@using System.Text.RegularExpressions
@using HawkAI.Data
@using HawkAI.Data.AirulerResultService
@using Microsoft.EntityFrameworkCore

@inject DataDbContext Db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="mb-0">
        <strong>@ModelName</strong>
        @if (!string.IsNullOrWhiteSpace(DeviceId))
        {
            <span class="text-muted" style="font-size: 0.95rem;"> · device: @DeviceId</span>
        }
        <span class="text-muted" style="font-size: 0.95rem;">(@_records.Count)</span>
    </h4>

    <div class="d-flex align-items-center gap-3 flex-wrap">

        <button class="btn btn-sm btn-outline-secondary"
                type="button"
                @onclick="OpenSpecModalAsync"
                disabled="@(!CanShowSpec)">
            Show Spec
        </button>

        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="showErrSwitch" @bind="_showError" />
            <label class="form-check-label small" for="showErrSwitch">Show error</label>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted mb-0" for="pageSizeInput">Rows</label>
            <input id="pageSizeInput"
                   class="form-control form-control-sm"
                   style="width: 84px;"
                   type="number"
                   min="1"
                   max="200"
                   step="1"
                   @bind="PageSize"
                   @bind:event="oninput" />
        </div>

        <a class="btn btn-sm btn-outline-secondary" href="/airuler/results">Back</a>
        <button class="btn btn-sm btn-outline-primary" @onclick="ReloadAsync">Refresh</button>

        <!-- ✅ Refresh 와 Save 사이에 Delete Selected 추가 -->
        <button class="btn btn-sm btn-danger"
                disabled="@(!CanDeleteSelected)"
                @onclick="ConfirmDeleteSelectedAsync">
            <span class="oi oi-trash"></span>
            Delete Selected
        </button>

        <!-- ✅ Calibration (Preview → Apply) -->
        <button class="btn btn-sm btn-warning"
                type="button"
                disabled="@(!CanCalibrate || _calibrationPreviewLoading || _calibrationApplying)"
                @onclick="OpenCalibrationPreviewModalAsync">
            @(_calibrationPreviewLoading ? "Calibration..." : "Calibration")
        </button>

        <a class="btn btn-sm btn-success @(!CanExport ? "disabled" : "")"
           href="@ExportUrl"
           target="_blank"
           aria-disabled="@(!CanExport)"
           tabindex="@(!CanExport ? "-1" : null)">
            Save to CSV
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-warning mt-2">@_loadError</div>
}
@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="text-muted small mt-2">@_statusMessage</div>
}

@if (string.IsNullOrWhiteSpace(ModelName))
{
    <div class="text-muted mt-3">Invalid model name.</div>
}
else if (_records.Count == 0 && string.IsNullOrWhiteSpace(_loadError))
{
    <div class="text-muted mt-3">No records for this model.</div>
}
else if (_records.Count > 0)
{
    <div class="table-responsive mt-3" style="max-height: 75vh; overflow:auto;">
        <table class="table table-sm table-hover align-middle airuler-result-table">
            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                <tr>
                    <!-- ✅ No 컬럼 헤더에 전체선택(Select All) 체크 -->
                    <th style="min-width: 60px;">
                        <div class="d-flex align-items-center" style="gap:8px;">
                            <input class="form-check-input m-0" type="checkbox" @bind="SelectAll" title="Select all" />
                            <strong>No</strong>
                        </div>
                    </th>

                    <th style="min-width: 210px;"><strong>Info</strong></th>
                    <th style="min-width: 50px;"><strong>Film</strong></th>

                    @foreach (var col in _measureColumns)
                    {
                        <th style="min-width: 80px; cursor:pointer;"
                            role="button"
                            tabindex="0"
                            title="Show statistics"
                            @onclick="() => OpenStatsModalAsync(col)">
                            <div style="line-height: 1.05;">
                                <div><strong>@col.Index</strong></div>
                                @if (!string.IsNullOrWhiteSpace(col.Gt))
                                {
                                    <div class="text-muted" style="font-size: 0.85rem;">(@col.Gt)</div>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @{
                    var page = Math.Clamp(_page, 1, TotalPages);
                    var pageSize = Math.Max(1, PageSize);
                    var baseNo = (page - 1) * pageSize;
                    var pageRecords = PagedRecords.ToList();
                }

                @for (var recIdx = 0; recIdx < pageRecords.Count; recIdx++)
                {
                    var r = pageRecords[recIdx];
                    var no = baseNo + recIdx + 1;

                    var filmRows = r.Films.Count > 0 ? r.Films : new List<FilmRowVm> { new FilmRowVm { Film = 0 } };
                    var rowspan = filmRows.Count;

                    for (var i = 0; i < filmRows.Count; i++)
                    {
                        var film = filmRows[i];

                        <tr>
                            @if (i == 0)
                            {
                                <!-- ✅ No 컬럼에 체크박스 + 번호 -->
                                <td rowspan="@rowspan" style="vertical-align: top;">
                                    <div class="d-flex align-items-start" style="gap:8px;">
                                        <input class="form-check-input mt-1" type="checkbox" @bind="r.IsSelected" />
                                        <span>@no</span>
                                    </div>
                                </td>

                                <td rowspan="@rowspan" style="vertical-align: top;">
                                    <div class="small">
                                        <div>
                                            <a href="@r.DetailPageUrl" style="text-decoration:none;">
                                                <b>@r.Entity.FileName</b>
                                            </a>
                                        </div>
                                        <div><b>Time</b>: @r.TimestampLocal</div>
                                        <div><b>Device</b>: @r.Entity.DeviceId</div>
                                        <div><b>Size</b>: @r.Entity.ImageSize</div>
                                        <div><b>Method</b>: @r.Entity.MeasureMethod</div>
                                    </div>
                                </td>
                            }

                            <td>
                                @if (film.Film > 0)
                                {
                                    <span>@($"#{film.Film}")</span>
                                }
                            </td>

                            @foreach (var col in _measureColumns)
                            {
                                if (film.Cells.TryGetValue(col.Index, out var cell)
                                && (!string.IsNullOrWhiteSpace(cell.Value) || (_showError && !string.IsNullOrWhiteSpace(cell.Err))))
                                {
                                    <td>
                                        <div style="line-height: 1.05;">
                                            @if (!string.IsNullOrWhiteSpace(cell.Value))
                                            {
                                                <div class="@(cell.IsFail ? "text-danger" : "")">@cell.Value</div>
                                            }
                                            @if (_showError && !string.IsNullOrWhiteSpace(cell.Err))
                                            {
                                                <div class="@(cell.IsFail ? "text-danger" : "text-muted")" style="font-size: 0.85rem;">(@cell.Err)</div>
                                            }
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_records.Count > 0)
    {
        <div class="d-flex justify-content-center mt-2">
            <div class="btn-group" role="group" aria-label="Pagination">
                <button class="btn btn-sm btn-outline-secondary"
                        disabled="@(_page <= 1)"
                        @onclick="() => GoToPage(_page - 1)">
                    Prev
                </button>

                @foreach (var p in GetPageNumbers())
                {
                    if (p == -1)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled>…</button>
                    }
                    else
                    {
                        <button class="btn btn-sm @(_page == p ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => GoToPage(p)">
                            @p
                        </button>
                    }
                }

                <button class="btn btn-sm btn-outline-secondary"
                        disabled="@(_page >= TotalPages)"
                        @onclick="() => GoToPage(_page + 1)">
                    Next
                </button>
            </div>
        </div>
    }
}

@if (_showSpecModal)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show" @onclick="CloseSpecModal"></div>

    <!-- Modal -->
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background: rgba(0,0,0,0.2);"
         @onclick="CloseSpecModal">
        <div class="modal-dialog modal-dialog-centered modal-xl"
             role="document"
             style="max-width:80vw; width:80vw;"
             @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <b>Spec</b>
                        @if (!string.IsNullOrWhiteSpace(_specModelName))
                        {
                            <span class="text-muted" style="font-size: 0.95rem;">(@_specModelName)</span>
                        }
                    </h6>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseSpecModal"></button>
                </div>

                <div class="modal-body p-0" style="background:#fff; max-height:85vh; overflow:auto;">
                    @if (!string.IsNullOrWhiteSpace(_specLoadError))
                    {
                        <div class="p-3 text-muted">@_specLoadError</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_specImageUrl))
                    {
                        <img src="@_specImageUrl"
                             style="width:100%; height:auto; display:block; cursor:pointer;"
                             @onclick="CloseSpecModal" />
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_showCalibrationModal)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show" @onclick="CloseCalibrationModal"></div>

    <!-- Modal -->
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background: rgba(0,0,0,0.2);"
         @onclick="CloseCalibrationModal">
        <div class="modal-dialog modal-dialog-centered"
             role="document"
             style="max-width:70vw; width:70vw;"
             @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <b>Calibration Preview</b>
                        @if (!string.IsNullOrWhiteSpace(ModelName))
                        {
                            <span class="text-muted" style="font-size: 0.95rem;">(@ModelName)</span>
                        }
                    </h6>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseCalibrationModal"></button>
                </div>

                <div class="modal-body" style="background:#fff;">
                    @if (_calibrationPreviewLoading)
                    {
                        <div class="text-muted">Loading preview...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_calibrationError))
                    {
                        <div class="alert alert-warning" style="white-space: pre-wrap;">@_calibrationError</div>
                    }
                    else if (_calibrationPreview == null)
                    {
                        <div class="text-muted">No preview data.</div>
                    }
                    else
                    {
                        <div class="small mb-2">
                            <div><b>Target JSON</b>: @_calibrationPreview.SavedPath</div>
                            <div><b>DB rows used</b>: @_calibrationPreview.DbRows</div>

                            @if ((_calibrationPreview.FilmOrder?.Count ?? 0) > 0)
                            {
                                <div><b>Films</b>: @string.Join(", ", _calibrationPreview.FilmOrder!)</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_calibrationPreview.Message))
                            {
                                <div class="text-muted mt-1">@_calibrationPreview.Message</div>
                            }

                            @if ((_calibrationPreview.NotFoundKeys?.Count ?? 0) > 0)
                            {
                                <div class="text-warning mt-1">
                                    <b>Not found in model json</b>: @_calibrationPreview.NotFoundKeys!.Count
                                </div>
                            }
                        </div>

                        @if ((_calibrationPreview.Changes?.Count ?? 0) > 0)
                        {
                            <div class="table-responsive" style="max-height:60vh; overflow:auto;">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                        <tr>
                                            <th style="min-width:200px;">Measure</th>
                                            <th style="min-width:260px;">Old adjust</th>
                                            <th style="min-width:260px;">Delta (add)</th>
                                            <th style="min-width:260px;">New adjust</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ch in _calibrationPreview.Changes!)
                                        {
                                            <tr>
                                                <td class="small">
                                                    <div><b>@ch.Key</b></div>
                                                    <div class="text-muted">@ch.MeasureProp</div>
                                                </td>
                                                <td style="@MonoCellStyle">@DisplayAdjust(ch.OldAdjust)</td>
                                                <td style="@MonoCellStyle">@DisplayAdjust(ch.DeltaAdjust)</td>
                                                <td style="@MonoCellStyle">@DisplayAdjust(ch.NewAdjust)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No adjust changes.</div>
                        }
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary"
                            type="button"
                            @onclick="CloseCalibrationModal"
                            disabled="@_calibrationApplying">
                        Cancel
                    </button>

                    <button class="btn btn-sm btn-warning"
                            type="button"
                            @onclick="ApplyCalibrationAsync"
                            disabled="@(!CanApplyCalibration)">
                        @(_calibrationApplying ? "Applying..." : "Apply")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showStatsModal)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show" @onclick="CloseStatsModalAsync"></div>

    <!-- Modal -->
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background: rgba(0,0,0,0.2);"
         @onclick="CloseStatsModalAsync">
        <div class="modal-dialog modal-dialog-centered modal-lg"
             role="document"
             style="max-width:70vw; width:70vw;"
             @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <b>Stats</b>
                        @if (!string.IsNullOrWhiteSpace(_statsMeasureIndex))
                        {
                            <span class="text-muted" style="font-size: 0.95rem;">(@_statsMeasureIndex)</span>
                        }
                    </h6>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseStatsModalAsync"></button>
                </div>

                <div class="modal-body" style="background:#fff;">
                    @if (!string.IsNullOrWhiteSpace(_statsError))
                    {
                        <div class="alert alert-warning" style="white-space: pre-wrap;">@_statsError</div>
                    }
                    else
                    {
                        <div class="small mb-2">
                            <div>
                                <b>Scope</b>:
                                @if (_statsUsingSelection)
                                {
                                    <span>Selected No only (@_statsRecordCount records)</span>
                                }
                                else
                                {
                                    <span>All data (@_statsRecordCount records)</span>
                                }
                            </div>

                            @if (_statsGt.HasValue)
                            {
                                <div>
                                    <b>GT</b>: @_statsGt.Value.ToString("0.###", CultureInfo.InvariantCulture)
                                    @if (_statsTol.HasValue)
                                    {
                                        <span class="text-muted"> (± @_statsTol.Value.ToString("0.###", CultureInfo.InvariantCulture))</span>
                                    }
                                </div>
                            }
                        </div>

                        <div id="airuler-stats-plot" style="width:100%; height:55vh;"></div>

                        @if ((_statsRows?.Count ?? 0) > 0)
                        {
                            <div class="table-responsive mt-2">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="min-width:80px;">Film</th>
                                            <th style="min-width:80px;">N</th>
                                            <th style="min-width:120px;">Mean</th>
                                            <th style="min-width:120px;">Median</th>
                                            <th style="min-width:120px;">Min</th>
                                            <th style="min-width:120px;">Max</th>
                                            <th style="min-width:120px;">Diff</th>
                                            <th style="min-width:120px;">Std</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in _statsRows!)
                                        {
                                            <tr>
                                                <td>@(s.Film > 0 ? $"#{s.Film}" : "")</td>
                                                <td>@s.N</td>
                                                <td>@Fmt(s.Mean)</td>
                                                <td>@Fmt(s.Median)</td>
                                                <td>@Fmt(s.Min)</td>
                                                <td>@Fmt(s.Max)</td>
                                                <td>@Fmt(s.Diff)</td>
                                                <td>@Fmt(s.Std)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No numeric data.</div>
                        }

                        <div class="text-muted small">
                            * Std is population standard deviation (divide by N).
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CloseStatsModalAsync">Close</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public string? ModelName { get; set; }
    [Parameter] public string? DeviceId { get; set; }

    private bool _showError = true;

    // Pagination (records per page)
    private int _pageSize = 50;   // default
    private int PageSize
    {
        get => _pageSize;
        set
        {
            var v = value;
            if (v < 1) v = 1;
            if (v > 200) v = 200;

            if (_pageSize != v)
            {
                _pageSize = v;
                _page = 1; // ✅ 페이지 크기 바꾸면 1페이지로
            }
        }
    }
    private int _page = 1;        // 1-based

    private int TotalPages
    {
        get
        {
            var size = Math.Max(1, PageSize);
            var total = _records.Count;
            return Math.Max(1, (int)Math.Ceiling(total / (double)size));
        }
    }

    private IEnumerable<RecordVm> PagedRecords
    {
        get
        {
            var size = Math.Max(1, PageSize);
            var page = Math.Clamp(_page, 1, TotalPages);
            var skip = (page - 1) * size;
            return _records.Skip(skip).Take(size);
        }
    }

    private void NormalizePaging()
    {
        if (PageSize < 1) PageSize = 1;
        if (PageSize > 200) PageSize = 200; // 과도한 렌더 방지
        _page = Math.Clamp(_page, 1, TotalPages);
    }

    private sealed class MeasureColumnVm
    {
        public string Index { get; init; } = string.Empty;
        public string Gt { get; init; } = string.Empty;
    }

    private sealed class MeasureCellVm
    {
        public string Value { get; init; } = string.Empty;
        public string Err { get; init; } = string.Empty;
        public bool IsFail { get; init; }
    }

    private sealed class FilmRowVm
    {
        public int Film { get; init; }
        public Dictionary<string, MeasureCellVm> Cells { get; init; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private sealed class RecordVm
    {
        public AirulerFilmMeasureResult Entity { get; init; } = default!;
        public string ThumbnailUrl { get; init; } = string.Empty;
        public string DetailPageUrl { get; init; } = string.Empty;
        public string TimestampLocal => Entity.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
        public List<FilmRowVm> Films { get; init; } = new();

        // ✅ 선택 상태
        public bool IsSelected { get; set; }
    }

    private sealed class CalibrationPreviewResponse
    {
        public bool Success { get; set; }
        public string? ModelName { get; set; }
        public string? SavedPath { get; set; }
        public int DbRows { get; set; }
        public List<int>? FilmOrder { get; set; }
        public int UpdatedMeasures { get; set; }
        public List<CalibrationPreviewChange>? Changes { get; set; }
        public List<string>? NotFoundKeys { get; set; }
        public string? Message { get; set; }
    }

    private sealed class CalibrationPreviewChange
    {
        public string? Key { get; set; }
        public string? Index { get; set; }
        public string? MeasureProp { get; set; }
        public string? OldAdjust { get; set; }
        public string? DeltaAdjust { get; set; }
        public string? NewAdjust { get; set; }
    }

    private sealed class CalibrationApplyResponse
    {
        public bool Success { get; set; }
        public string? ModelName { get; set; }
        public string? SavedPath { get; set; }
        public int DbRows { get; set; }
        public int UpdatedMeasures { get; set; }
        public List<string>? UpdatedKeys { get; set; }
        public List<string>? NotFoundKeys { get; set; }
        public string? Message { get; set; }
    }

    private List<RecordVm> _records = new();
    private List<MeasureColumnVm> _measureColumns = new();
    private string? _loadError;
    private string? _statusMessage;

    // ---- Spec modal ----
    private bool _showSpecModal = false;
    private string? _specModelName;
    private string? _specImageUrl;
    private string? _specLoadError;

    // ---- Calibration preview modal ----
    private bool _showCalibrationModal = false;
    private bool _calibrationPreviewLoading = false;
    private bool _calibrationApplying = false;
    private CalibrationPreviewResponse? _calibrationPreview;
    private string? _calibrationError;

    private bool CanExport => !string.IsNullOrWhiteSpace(ModelName) && _records.Count > 0;
    private bool CanDeleteSelected => _records.Any(r => r.IsSelected);
    private bool CanShowSpec => !string.IsNullOrWhiteSpace(ModelName) || _records.Count > 0;

    private bool CanCalibrate => !string.IsNullOrWhiteSpace(ModelName) && _records.Count > 0;

    private bool CanApplyCalibration
        => !_calibrationPreviewLoading
           && !_calibrationApplying
           && (_calibrationPreview?.Success ?? false)
           && ((_calibrationPreview?.Changes?.Count ?? 0) > 0);

    private static readonly JsonSerializerOptions CalibrationJsonOpts = new() { PropertyNameCaseInsensitive = true };

    private string MonoCellStyle
        => "font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace; font-size: 0.85rem; white-space: pre-wrap; word-break: break-word;";

    // ✅ 헤더 "전체 선택" 체크박스 바인딩
    private bool SelectAll
    {
        get => _records.Count > 0 && _records.All(r => r.IsSelected);
        set
        {
            foreach (var r in _records)
                r.IsSelected = value;
        }
    }

    private string ExportUrl
        => CanExport
            ? $"/api/airuler/export/{Uri.EscapeDataString(ModelName!)}?showError={_showError.ToString().ToLowerInvariant()}" +
              (string.IsNullOrWhiteSpace(DeviceId)
                  ? string.Empty
                  : $"&deviceId={Uri.EscapeDataString(DeviceId)}")
            : "#";

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private string ResultsRoot => Path.Combine(Env.WebRootPath, "airuler", "results");

    private static string ThumbUrl(string modelName, string fileName)
        => $"/airuler/results/{Uri.EscapeDataString(modelName)}/thumbnail/{Uri.EscapeDataString(fileName)}";

    private static string DetailUrl(string modelName, string fileName, string? deviceId)
    {
        if (!string.IsNullOrWhiteSpace(deviceId))
        {
            return $"/airuler/results/{Uri.EscapeDataString(modelName)}/device/{Uri.EscapeDataString(deviceId)}/{Uri.EscapeDataString(fileName)}";
        }

        return $"/airuler/results/{Uri.EscapeDataString(modelName)}/{Uri.EscapeDataString(fileName)}";
    }

    private string JsonFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName), "json", Path.GetFileNameWithoutExtension(fileName) + ".json");

    private string ImageFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName), "image", Path.GetFileName(fileName));

    private string ThumbnailFilePath(string modelName, string fileName)
        => Path.Combine(ResultsRoot, Path.GetFileName(modelName), "thumbnail", Path.GetFileName(fileName));

    private async Task ReloadAsync()
    {
        _loadError = null;
        _statusMessage = null;

        // ✅ Reload 시 기존 선택 유지(가능하면)
        var selectedIds = _records.Where(r => r.IsSelected).Select(r => r.Entity.Id).ToHashSet();

        _records = new();
        _measureColumns = new();

        if (string.IsNullOrWhiteSpace(ModelName))
            return;

        try
        {
            IQueryable<AirulerFilmMeasureResult> query = Db.AirulerFilmMeasureResults
                .AsNoTracking()
                .Where(x => x.ModelName == ModelName);

            // ✅ /device/{DeviceId} 경로로 접근한 경우 해당 DeviceId 결과만 표시
            if (!string.IsNullOrWhiteSpace(DeviceId))
                query = query.Where(x => x.DeviceId == DeviceId);

            var rows = await query
                .OrderByDescending(x => x.TimestampUtc)
                .ThenByDescending(x => x.Id)
                .ToListAsync();

            var cols = new List<MeasureColumnVm>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            var vms = new List<RecordVm>(rows.Count);
            foreach (var e in rows)
            {
                var films = ParseFilms(e.ResultsJson, cols, seen);
                vms.Add(new RecordVm
                {
                    Entity = e,
                    ThumbnailUrl = ThumbUrl(e.ModelName, e.FileName),
                    DetailPageUrl = DetailUrl(e.ModelName, e.FileName, e.DeviceId),
                    Films = films,
                    IsSelected = selectedIds.Contains(e.Id)
                });
            }

            _measureColumns = cols;
            _records = vms;

            NormalizePaging();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private static List<FilmRowVm> ParseFilms(string resultsJson, List<MeasureColumnVm> cols, HashSet<string> seen)
    {
        var films = new List<FilmRowVm>();

        if (string.IsNullOrWhiteSpace(resultsJson))
            return films;

        try
        {
            using var doc = JsonDocument.Parse(resultsJson);
            if (doc.RootElement.ValueKind != JsonValueKind.Array)
                return films;

            foreach (var filmEl in doc.RootElement.EnumerateArray())
            {
                var filmNo = 0;
                if (filmEl.TryGetProperty("film", out var fno) && fno.ValueKind == JsonValueKind.Number)
                    fno.TryGetInt32(out filmNo);

                var row = new FilmRowVm { Film = filmNo };

                if (filmEl.TryGetProperty("measures", out var meas) && meas.ValueKind == JsonValueKind.Array)
                {
                    foreach (var m in meas.EnumerateArray())
                    {
                        var idx = GetString(m, "index");
                        if (string.IsNullOrWhiteSpace(idx)) continue;

                        var gtStr = GetNumberAsString(m, "gt");
                        if (!seen.Contains(idx))
                        {
                            cols.Add(new MeasureColumnVm { Index = idx, Gt = gtStr });
                            seen.Add(idx);
                        }

                        var valueStr = GetNumberAsString(m, "value");
                        var errStr = GetNumberAsString(m, "err");
                        var result = GetString(m, "result");
                        var isFail = string.Equals(result, "FAIL", StringComparison.OrdinalIgnoreCase);

                        row.Cells[idx] = new MeasureCellVm
                        {
                            Value = valueStr,
                            Err = errStr,
                            IsFail = isFail
                        };
                    }
                }

                films.Add(row);
            }
        }
        catch
        {
            // ignore parse error
        }

        return films;
    }

    private static string GetString(JsonElement e, string name)
    {
        if (e.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String)
            return p.GetString() ?? string.Empty;
        return string.Empty;
    }

    private static string GetNumberAsString(JsonElement e, string name)
    {
        if (!e.TryGetProperty(name, out var p)) return string.Empty;

        if (p.ValueKind == JsonValueKind.Number)
        {
            if (p.TryGetDouble(out var d))
                return d.ToString("0.###");
        }
        else if (p.ValueKind == JsonValueKind.String)
        {
            return p.GetString() ?? string.Empty;
        }

        return string.Empty;
    }

