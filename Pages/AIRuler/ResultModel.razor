        => string.IsNullOrWhiteSpace(s) ? "0" : s;

    private async Task ApplyCalibrationAsync()
    {
        if (string.IsNullOrWhiteSpace(ModelName))
            return;

        if (_calibrationApplying)
            return;

        _calibrationError = null;
        _calibrationApplying = true;

        try
        {
            var raw = await JS.InvokeAsync<string>("hkAiruler.calibrationApply", ModelName);
            var res = JsonSerializer.Deserialize<CalibrationApplyResponse>(raw, CalibrationJsonOpts);

            if (res != null && res.Success)
            {
                if (!string.IsNullOrWhiteSpace(res.Message))
                {
                    _statusMessage = res.Message;
                }
                else
                {
                    var updated = res.UpdatedMeasures;
                    var notFound = res.NotFoundKeys?.Count ?? 0;
                    _statusMessage = $"Calibration applied: {res.SavedPath} (updated {updated}, notFound {notFound})";
                }

                CloseCalibrationModal();
            }
            else
            {
                _calibrationError = $"Calibration apply failed or unexpected response:\n{raw}";
            }
        }
        catch (Exception ex)
        {
            _calibrationError = ex.Message;
        }
        finally
        {
            _calibrationApplying = false;
        }
    }

    private async Task ConfirmDeleteSelectedAsync()
    {
        if (string.IsNullOrWhiteSpace(ModelName))
            return;

        var selected = _records.Where(r => r.IsSelected).ToList();
        if (selected.Count == 0)
            return;

        var ok = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete selected {selected.Count} file(s)?\nThis will remove DB rows and image/thumbnail/json files."
        );

        if (!ok)
            return;

        await DeleteSelectedAsync(selected.Select(r => r.Entity.Id).ToList());
    }

    private async Task DeleteSelectedAsync(List<long> ids)
    {
        try
        {
            if (ids.Count == 0 || string.IsNullOrWhiteSpace(ModelName))
                return;

            // tracking 필요(삭제)
            var ents = await Db.AirulerFilmMeasureResults
                .Where(x => x.ModelName == ModelName && ids.Contains(x.Id))
                .ToListAsync();

            // 파일 삭제 먼저 시도 (실패해도 계속)
            foreach (var ent in ents)
            {
                SafeDeleteFile(ImageFilePath(ent.ModelName, ent.FileName));
                SafeDeleteFile(ThumbnailFilePath(ent.ModelName, ent.FileName));
                SafeDeleteFile(JsonFilePath(ent.ModelName, ent.FileName));
            }

            Db.AirulerFilmMeasureResults.RemoveRange(ents);
            await Db.SaveChangesAsync();

            _statusMessage = $"Deleted: {ents.Count} file(s)";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Delete selected failed: {ex.Message}";
        }
    }

    private void SafeDeleteFile(string path)
    {
        try
        {
            var full = Path.GetFullPath(path);
            var root = Path.GetFullPath(ResultsRoot);
            if (!full.StartsWith(root, StringComparison.OrdinalIgnoreCase)) return;

            if (System.IO.File.Exists(full))
                System.IO.File.Delete(full);
        }
        catch
        {
            // ignore
        }
    }

    private void GoToPage(int p)
    {
        _page = Math.Clamp(p, 1, TotalPages);
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var total = TotalPages;
        var cur = Math.Clamp(_page, 1, total);

        if (total <= 12)
        {
            for (int i = 1; i <= total; i++) yield return i;
            yield break;
        }

        yield return 1;
        yield return 2;

        var start = Math.Max(3, cur - 2);
        var end = Math.Min(total - 2, cur + 2);

        if (start > 3) yield return -1; // ...
        for (int i = start; i <= end; i++) yield return i;
        if (end < total - 2) yield return -1; // ...

        yield return total - 1;
        yield return total;
    }

    // ---- Stats modal (Measure column) ----
    private bool _showStatsModal = false;
    private bool _statsUsingSelection = false;
    private string? _statsMeasureIndex;
    private int _statsRecordCount = 0;
    private double? _statsGt;
    private double? _statsTol;
    private string? _statsError;

    private bool _statsPendingRender = false;
    private StatsPlotPayload? _statsPlot;
    private List<StatsRowVm>? _statsRows;

    private sealed class StatsRowVm
    {
        public int Film { get; init; }
        public int N { get; init; }
        public double Mean { get; init; }
        public double Median { get; init; }
        public double Min { get; init; }
        public double Max { get; init; }
        public double Diff { get; init; }
        public double Std { get; init; }
    }

    private sealed class StatsPlotPayload
    {
        public string? Title { get; init; }
        public double? Gt { get; init; }
        public double? Tol { get; init; }
        public List<StatsFilmSeries> Films { get; init; } = new();
    }

    private sealed class StatsFilmSeries
    {
        public int Film { get; init; }
        public string Label { get; init; } = string.Empty;
        public double[] Values { get; init; } = Array.Empty<double>();
    }

    private async Task OpenStatsModalAsync(MeasureColumnVm col)
    {
        _statsError = null;
        _statsMeasureIndex = col.Index;
        _statsPlot = null;
        _statsRows = null;
        _statsGt = null;
        _statsTol = null;

        // ✅ 선택된 No가 있으면 그것만, 없으면 전체
        var selected = _records.Where(r => r.IsSelected).ToList();
        _statsUsingSelection = selected.Count > 0;
        var scope = _statsUsingSelection ? selected : _records;
        _statsRecordCount = scope.Count;

        // 1) 값 수집(필름별)
        var byFilm = new SortedDictionary<int, List<double>>();

        foreach (var r in scope)
        {
            foreach (var film in r.Films)
            {
                if (film.Film <= 0) continue; // film=0 placeholder ignore

                if (!film.Cells.TryGetValue(col.Index, out var cell))
                    continue;

                if (!TryParseDouble(cell.Value, out var v))
                    continue;

                if (!byFilm.TryGetValue(film.Film, out var list))
                {
                    list = new List<double>();
                    byFilm[film.Film] = list;
                }
                list.Add(v);
            }
        }

        if (byFilm.Count == 0)
        {
            _statsError = $"No numeric values found for '{col.Index}'.";
            _showStatsModal = true;
            return;
        }

        // 2) GT / 허용오차(=margin) 읽기
        var (gtFromModel, marginFromModel) = await TryReadGtMarginFromModelJsonAsync(col.Index);

        // fallback: header GT string
        var (gtFromHeader, tolFromHeader) = TryParseGtTol(col.Gt);

        _statsGt = gtFromModel ?? gtFromHeader;
        _statsTol = marginFromModel ?? tolFromHeader;

        // 3) 통계 계산
        var rows = new List<StatsRowVm>();
        foreach (var (filmNo, values) in byFilm)
        {
            var arr = values.ToArray();
            Array.Sort(arr);

            var n = arr.Length;
            var mean = arr.Average();
            var median = ComputeMedianSorted(arr);
            var min = arr.First();
            var max = arr.Last();
            var diff = max - min;
            var std = ComputeStdPopulation(arr, mean);

            rows.Add(new StatsRowVm
            {
                Film = filmNo,
                N = n,
                Mean = mean,
                Median = median,
                Min = min,
                Max = max,
                Diff = diff,
                Std = std
            });
        }
        _statsRows = rows;

        // 4) Plot payload
        _statsPlot = new StatsPlotPayload
        {
            Title = $"{col.Index}",
            Gt = _statsGt,
            Tol = _statsTol,
            Films = byFilm.Select(kvp => new StatsFilmSeries
            {
                Film = kvp.Key,
                Label = kvp.Key > 0 ? $"Film #{kvp.Key}" : "Film",
                Values = kvp.Value.ToArray()
            }).ToList()
        };

        _showStatsModal = true;
        _statsPendingRender = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseStatsModalAsync()
    {
        _showStatsModal = false;
        _statsPendingRender = false;

        try
        {
            await JS.InvokeVoidAsync("hkAirulerStats.purge", "airuler-stats-plot");
        }
        catch
        {
            // ignore
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_statsPendingRender && _showStatsModal && _statsPlot != null)
        {
            _statsPendingRender = false;

            try
            {
                await JS.InvokeVoidAsync("hkAirulerStats.renderBoxPlot", "airuler-stats-plot", _statsPlot);
            }
            catch (Exception ex)
            {
                _statsError = $"Plot render failed: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static string Fmt(double v)
        => v.ToString("0.###", CultureInfo.InvariantCulture);

    private static bool TryParseDouble(string? s, out double v)
    {
        v = 0;
        if (string.IsNullOrWhiteSpace(s)) return false;
        s = s.Trim();

        // 1) invariant
        if (double.TryParse(s, NumberStyles.Float | NumberStyles.AllowThousands, CultureInfo.InvariantCulture, out v))
            return true;

        // 2) current culture fallback
        if (double.TryParse(s, NumberStyles.Float | NumberStyles.AllowThousands, CultureInfo.CurrentCulture, out v))
            return true;

        return false;
    }

    /// <summary>
    /// Parse GT string. Supports:
    /// - "12.3"
    /// - "12.3±0.2" / "12.3 +/- 0.2" / "12.3+-0.2"
    /// Returns (gt, tol). tol is null if not found.
    /// </summary>
    private static (double? gt, double? tol) TryParseGtTol(string? gtText)
    {
        if (string.IsNullOrWhiteSpace(gtText))
            return (null, null);

        var s = gtText.Trim();
        s = s.Trim('(', ')');

        // normalize
        s = s.Replace("+/-", "±").Replace("+-", "±");

        // capture numbers (gt and optional tol)
        // ex) 12.3±0.2
        var m = Regex.Match(s, @"(?<gt>[+-]?(?:\d+\.?\d*|\d*\.?\d+))(?:\s*±\s*(?<tol>[+-]?(?:\d+\.?\d*|\d*\.?\d+)))?");
        if (!m.Success)
            return (null, null);

        double? gt = null;
        double? tol = null;

        if (TryParseDouble(m.Groups["gt"].Value, out var g))
            gt = g;

        if (m.Groups["tol"].Success && TryParseDouble(m.Groups["tol"].Value, out var t))
            tol = Math.Abs(t);

        return (gt, tol);
    }

    private static double ComputeMedianSorted(double[] sorted)
    {
        if (sorted.Length == 0) return 0;
        var mid = sorted.Length / 2;
        if (sorted.Length % 2 == 1)
            return sorted[mid];
        return (sorted[mid - 1] + sorted[mid]) / 2.0;
    }

    private static double ComputeStdPopulation(double[] values, double mean)
    {
        if (values.Length == 0) return 0;
        double sum = 0;
        foreach (var v in values)
        {
            var d = v - mean;
            sum += d * d;
        }
        return Math.Sqrt(sum / values.Length);
    }

    /// <summary>
    /// Try read gt/margin from model json file: wwwroot/airuler/models/{model}.json
    /// </summary>
    private async Task<(double? gt, double? margin)> TryReadGtMarginFromModelJsonAsync(string measureIndex)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ModelName))
                return (null, null);

            // Try exact ModelName first, then fallback to prefix before '_'
            var candidates = new List<string>();
            var m0 = ModelName.Trim();
            if (!string.IsNullOrWhiteSpace(m0)) candidates.Add(m0);

            var under = m0.IndexOf('_');
            if (under > 0)
            {
                var baseName = m0.Substring(0, under);
                if (!string.IsNullOrWhiteSpace(baseName) && !candidates.Contains(baseName, StringComparer.OrdinalIgnoreCase))
                    candidates.Add(baseName);
            }

            foreach (var model in candidates)
            {
                var path = Path.Combine(Env.WebRootPath, "airuler", "models", $"{Path.GetFileName(model)}.json");
                if (!System.IO.File.Exists(path))
                    continue;

                var txt = await System.IO.File.ReadAllTextAsync(path);
                using var doc = JsonDocument.Parse(txt);
                if (doc.RootElement.ValueKind != JsonValueKind.Object)
                    continue;

                var key = $"measure_{measureIndex}";

                // direct
                if (doc.RootElement.TryGetProperty(key, out var meas) && meas.ValueKind == JsonValueKind.Object)
                    return (ReadNullableDouble(meas, "gt"), ReadNullableDouble(meas, "margin"));

                // case-insensitive fallback
                foreach (var prop in doc.RootElement.EnumerateObject())
                {
                    if (!string.Equals(prop.Name, key, StringComparison.OrdinalIgnoreCase))
                        continue;

                    if (prop.Value.ValueKind == JsonValueKind.Object)
                        return (ReadNullableDouble(prop.Value, "gt"), ReadNullableDouble(prop.Value, "margin"));
                }
            }
        }
        catch
        {
            // ignore
        }

        return (null, null);
    }

    private static double? ReadNullableDouble(JsonElement obj, string prop)
    {
        if (obj.TryGetProperty(prop, out var p))
        {
            if (p.ValueKind == JsonValueKind.Number && p.TryGetDouble(out var d))
                return d;
            if (p.ValueKind == JsonValueKind.String && TryParseDouble(p.GetString(), out var s))
                return s;
        }
        return null;
    }

