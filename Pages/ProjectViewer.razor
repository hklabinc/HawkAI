@page "/projects/{projectId:int}"
@inject DataDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@using Microsoft.EntityFrameworkCore
@using System.IO;
@using System.Text.Json;
@using SixLabors.ImageSharp;
@using SixLabors.ImageSharp.PixelFormats;
@using SixLabors.ImageSharp.Processing;
@using SixLabors.Fonts;
@using SixLabors.ImageSharp.Drawing.Processing;
@using SixLabors.ImageSharp.Drawing;
@using System.Runtime.InteropServices;
@using System.Diagnostics


@if (isLoading)
{
    <p><em>Loading project...</em></p>
}
else if (project == null)
{
    <p class="text-danger">Project not found.</p>
}
else
{
    <div class="mb-3" style="max-width: 1000px;">
        <!-- 이름 및 통계 -->
        <p class="card-text mb-2">
            <strong style="font-size: 1.5rem;">@project!.Name</strong>
            @{
                int labeledCount = images.Count(i => i.LabelStatus == "Labeled");
            }
            <span class="text-muted ms-2" style="font-size: 0.95rem;">
                (@labeledCount labeled / @images.Count images) |
                Labels: @project!.Labels |
                Created at @project.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
            </span>
        </p>

        <!-- 다음 줄 왼쪽에 Download 및 Delete 버튼 -->
        <div class="mt-1">
            <button class="btn btn-primary" @onclick="DownloadAllImages">
                <span class="oi oi-cloud-download"></span> Download Images
            </button>
            <button class="btn btn-danger me-2" @onclick="ConfirmBulkDeleteImages">
                <span class="oi oi-trash"></span> Delete Images
            </button>
            <button class="btn btn-outline-success" @onclick="RunAutoLabeling">
                <span class="oi oi-flash"></span> Auto Labeling
            </button>
            <button class="btn btn-outline-warning" @onclick="AdjustLabels">
                <span class="oi oi-wrench"></span> Adjust Labels
            </button>
            <button class="btn btn-outline-danger" @onclick="DeleteAllLabels">
                <span class="oi oi-trash"></span> Delete Labels
            </button>
        </div>
    </div>



    @if (images.Count == 0)
    {
        <p>No images uploaded for this project.</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3">
            @foreach (var image in images)
            {
                <div class="card position-relative" style="width: 320px;">
                    <!-- ✅ 체크박스 오른쪽 위에 표시 -->
                    <input type="checkbox"
                           class="form-check-input position-absolute top-0 end-0 m-2"
                           @bind="image.IsSelected"
                           style="z-index: 1;" />

                    @if (image.LabelStatus == "Labeled")
                    {
                        <span class="badge bg-success position-absolute top-0 start-0 m-2" style="z-index: 1;">
                            ✔ Labeled
                        </span>
                    }

                    <img class="card-img-top"
                         src="@GetDisplayImagePath(image)"
                         @onclick="() => OpenLabelingModal(image.RelativePath, image.Id)"
                         style="cursor: pointer; width: 320px; height: 240px; object-fit: contain;" />

                    <div class="card-body">
                        <p class="card-text">
                            @image.FileName <span class="text-muted" style="font-size: 0.75rem;">(@image.Width x @image.Height)</span>
                        </p>
                    </div>
                </div>
            }

        </div>
    }
}

@if (showLabelingModal)
{
    var currentIndex = images.FindIndex(i => i.Id == selectedImageId);
    var hasPrev = currentIndex > 0;
    var hasNext = currentIndex < images.Count - 1;

    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-xl" style="max-height: 95vh;">
            <div class="modal-content" style="max-height: 95vh; display: flex; flex-direction: column;">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Label Image - @GetFileNameById(selectedImageId)
                    </h5>
                    
                    <div class="d-flex align-items-center" style="gap: 8px;">
                        <button class="btn btn-outline-dark" @onclick="() => showHelpModal = true">❔ 도움말</button>
                        <button type="button" class="btn-close" @onclick="() => showLabelingModal = false" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body" style="overflow: auto; max-height: 80vh;">
                    <div style="position: relative; width: 100%; max-height: 100%;">
                                <!-- 이미지와 캔버스 -->
                        <img id="targetImage"
                             src="@selectedImagePath"
                             style="width: 100%; height: auto; max-height: 100%; display: block; object-fit: contain;" />
                        <canvas id="labelCanvas"
                                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></canvas>

                                    <!-- Prev 버튼 (왼쪽) -->
                        @if (hasPrev)
                        {
                            <button @onclick="GoToPreviousImage"
                                    class="btn btn-outline-secondary"
                                    style="
                                        position: absolute;
                                        top: 50%;
                                        left: 10px;
                                        transform: translateY(-50%);
                                        z-index: 2;
                                        font-size: 3rem;
                                        padding: 0.5rem 1rem;
                                        line-height: 1;
                                    ">
                                &lt;
                            </button>
                        }

                                     <!-- Next 버튼: 다음 이미지가 있을 때만 -->
                        @if (hasNext)
                        {
                            <button @onclick="GoToNextImage"
                                    class="btn btn-outline-secondary"
                                    style="
                                    position: absolute;
                                    top: 50%;
                                    right: 10px;
                                    transform: translateY(-50%);
                                    z-index: 2;
                                    font-size: 3rem;
                                    padding: 0.5rem 1rem;
                                    line-height: 1;
                                ">
                            &gt;
                            </button>
                        }
                    </div>
                </div>


                <div class="modal-footer d-flex align-items-center justify-content-between" style="flex-wrap: nowrap; gap: 8px; overflow-x: auto;">

                    <!-- 좌측 그룹 -->
                    <div class="d-flex align-items-center" style="gap: 6px; flex-shrink: 0;">
                        <button class="btn btn-danger" onclick="if (confirm('⚠️ 모든 박스를 삭제하시겠습니까?')) clearBoxes();">
                            <span class="oi oi-trash"></span> Clear
                        </button>
                        <button class="btn btn-info" @onclick="ImportLabelsFromPreviousAsync">
                            <span class="oi oi-reload"></span> Import
                        </button>
                        <input type="number" min="1" class="form-control" style="width: 60px;" @bind="importOffset" />
                        <button class="btn btn-info" onclick="applyLabelToSelectedBox()">Apply</button>
                        <select id="labelSelector" class="form-select" style="width: 90px;">
                            @foreach (var label in selectedLabels.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <option value="@label.Trim()">@label.Trim()</option>
                            }
                        </select>
                    </div>

                    <!-- 우측 그룹 -->
                    <div class="d-flex align-items-center" style="gap: 6px; flex-shrink: 0;">
                        <button class="btn btn-outline-dark" @onclick="ToggleLabelJsonModal">Show Label</button>
                        <button class="btn btn-secondary" @onclick="() => showLabelingModal = false">Close</button>
                        <button class="btn btn-primary" onclick="saveLabelData()">Save</button>
                    </div>
                </div>


            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Selected Images</h5>
                    <button type="button" class="btn-close" @onclick="() => showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the selected images?</p>
                    <p class="text-danger">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteBulkDeleteImages">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showJsonModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Label JSON Preview</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showJsonModal = false"></button>
                </div>
                <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                    @if (!isEditingJson)
                    {
                        <pre style="white-space: pre-wrap;">@labelJsonPreview</pre>
                    }
                    else
                    {
                        <textarea class="form-control" style="height: 300px;" @bind="editedLabelJson"></textarea>
                    }
                </div>
                <div class="modal-footer">
                    @if (!isEditingJson)
                    {
                        <button class="btn btn-warning" @onclick="() => StartEditingJson()">Edit</button>
                        <button class="btn btn-secondary" @onclick="() => showJsonModal = false">Close</button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="SaveEditedJsonAsync">Save</button>
                        <button class="btn btn-secondary" @onclick="() => isEditingJson = false">Cancel</button>
                    }
                </div>
            </div>
        </div>
    </div>
}


@if (showHelpModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">단축키 도움말</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showHelpModal = false"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr><th>단축키</th><th>기능 설명</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><kbd>Delete</kbd></td><td>선택된 박스 삭제</td></tr>
                            <tr><td><kbd>Ctrl + Z</kbd></td><td>실행 취소 (Undo)</td></tr>
                            <tr><td><kbd>Ctrl + Y</kbd></td><td>다시 실행 (Redo)</td></tr>
                            <tr><td><kbd>Ctrl + C</kbd></td><td>박스 복사</td></tr>
                            <tr><td><kbd>Ctrl + V</kbd></td><td>복사된 박스 붙여넣기 (10px 이동)</td></tr>
                            <tr><td><kbd>Ctrl + X</kbd></td><td>선택된 박스 잘라내기</td></tr>
                            <tr><td><kbd>C</kbd></td><td>선택된 박스의 라벨 변경</td></tr>
                            <tr><td><kbd>← / ↑ / → / ↓</kbd></td><td>선택된 박스 이동 (1px)</td></tr>
                            <tr><td><kbd>Shift + ← / ↑ / → / ↓</kbd></td><td>선택된 박스 크기 조절 (1px)</td></tr>
                            <tr><td><kbd>Shift + 마우스 드래그</kbd></td><td>여러 개의 박스를 선택</td></tr>
                            <tr><td><kbd>Shift + 바탕 클릭</kbd></td><td>선택된 박스를 해제</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showHelpModal = false">닫기</button>
                </div>
            </div>
        </div>
    </div>
}



@code {
    [Parameter] public int projectId { get; set; }

    private Project? project;
    private List<ImageEntry> images = new();
    private bool isLoading = true;
    private bool showLabelingModal = false;
    private string selectedImagePath = string.Empty;
    private int selectedImageId;
    private string selectedLabels = string.Empty;
    private bool pendingInitJS = false;
    private DotNetObjectReference<ProjectViewer>? dotNetRef;
    private int importOffset = 1;
    private bool showJsonModal = false;
    private string labelJsonPreview = string.Empty;
    private bool isEditingJson = false;
    private string editedLabelJson = string.Empty;
    private bool showHelpModal = false;

    protected override async Task OnInitializedAsync()
    {
        project = await Db.Projects.FindAsync(projectId);
        if (project == null)
        {
            Navigation.NavigateTo("/projects");
            return;
        }

        await LoadImages();
        isLoading = false;
        selectedLabels = project!.Labels;
    }

    private async Task LoadImages()
    {
        images = await Db.Images
            .Where(i => i.ProjectId == projectId)
            .OrderBy(i => i.FileName)
            .ToListAsync();
        StateHasChanged();
    }

    private string GetFileNameById(int imageId)
    {
        var image = images.FirstOrDefault(i => i.Id == imageId);
        return image?.FileName ?? "";
    }

    private void OpenLabelingModal(string imagePath, int imageId)
    {
        selectedImagePath = "/" + imagePath;
        selectedImageId = imageId;
        showLabelingModal = true;
        pendingInitJS = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showLabelingModal && pendingInitJS)
        {
            var image = await Db.Images.FindAsync(selectedImageId);
            var labelDataRaw = image?.LabelData;
            var labelData = string.IsNullOrWhiteSpace(labelDataRaw) || labelDataRaw == "{}" ? "[]" : labelDataRaw!;

            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initLabelingCanvas", dotNetRef, labelData);
            pendingInitJS = false;
        }
    }

    private string GetDisplayImagePath(ImageEntry image)
    {
        var folder = System.IO.Path.GetDirectoryName(image.RelativePath) ?? "";
        var filename = System.IO.Path.GetFileName(image.RelativePath);
        var annotatedPath = image.LabelStatus == "Labeled"
            ? folder.Replace("images", "images_annotated")
            : folder;

        return "/" + System.IO.Path.Combine(annotatedPath, filename).Replace("\\", "/") + $"?t={DateTime.UtcNow.Ticks}";    // ✅ 캐시 방지용 timestamp 추가
    }

    [JSInvokable]
    public async Task SaveLabelWrapper(string labelJson)
    {
        var image = await Db.Images.FindAsync(selectedImageId);
        if (image == null) return;

        image.LabelData = labelJson;
        image.LabelStatus = string.IsNullOrWhiteSpace(labelJson) || labelJson == "[]" ? "Unlabeled" : "Labeled";
        await Db.SaveChangesAsync();

        var sourcePath = System.IO.Path.Combine(Env.WebRootPath, image.RelativePath);
        var imagesFolder = System.IO.Path.GetDirectoryName(sourcePath)!;
        var parentFolder = System.IO.Path.GetDirectoryName(imagesFolder)!;
        var annotatedFolder = System.IO.Path.Combine(parentFolder, "images_annotated");
        var annotatedPath = System.IO.Path.Combine(annotatedFolder, image.FileName);

        try
        {
            if (image.LabelStatus == "Labeled")
            {
                Directory.CreateDirectory(annotatedFolder);

                using var srcImage = await Image.LoadAsync<Rgba32>(sourcePath);
                var font = RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
                    ? SystemFonts.CreateFont("Arial", 16)
                    : SystemFonts.CreateFont("DejaVu Sans", 16);
                var colorMap = new[] { Color.Blue, Color.Green, Color.Red, Color.Orange, Color.Purple };
                var labelList = project!.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).ToList();
                var labelBoxes = JsonDocument.Parse(labelJson).RootElement;

                foreach (var box in labelBoxes.EnumerateArray())
                {
                    var x = (float)box.GetProperty("x").GetDouble();
                    var y = (float)box.GetProperty("y").GetDouble();
                    var w = (float)box.GetProperty("w").GetDouble();
                    var h = (float)box.GetProperty("h").GetDouble();
                    var label = box.GetProperty("label").GetString() ?? "";
                    var index = labelList.IndexOf(label);
                    var labelColor = colorMap[index % colorMap.Length];

                    srcImage.Mutate(ctx =>
                    {
                        var rect = new RectangleF(x, y, w, h);
                        ctx.Draw(labelColor, 1, rect);
                        ctx.DrawText(label, font, labelColor, new PointF(x + 4, y - 16));
                    });
                }

                await srcImage.SaveAsJpegAsync(annotatedPath);
            }
            else if (File.Exists(annotatedPath))
            {
                File.Delete(annotatedPath);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] Error handling annotated image: {ex.Message}");
        }

        showLabelingModal = false;
        await LoadImages(); // ✅ 이미지 목록 다시 로딩
    }

    private async Task DeleteCurrentImage()
    {
        // JavaScript confirm 창 실행
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this image? This action cannot be undone.");
        if (!confirmed)
            return;

        var image = await Db.Images.FindAsync(selectedImageId);
        if (image == null) return;

        try
        {
            // 파일 경로 생성
            var sourcePath = System.IO.Path.Combine(Env.WebRootPath, image.RelativePath);
            var imagesFolder = System.IO.Path.GetDirectoryName(sourcePath)!;
            var parentFolder = System.IO.Path.GetDirectoryName(imagesFolder)!;
            var annotatedFolder = System.IO.Path.Combine(parentFolder, "images_annotated");
            var annotatedPath = System.IO.Path.Combine(annotatedFolder, image.FileName);

            // 원본 이미지 삭제
            if (File.Exists(sourcePath))
            {
                File.Delete(sourcePath);
            }

            // 어노테이션 이미지 삭제
            if (File.Exists(annotatedPath))
            {
                File.Delete(annotatedPath);
            }

            // DB에서 삭제
            Db.Images.Remove(image);
            await Db.SaveChangesAsync();

            // 이미지 목록 새로고침
            showLabelingModal = false;
            await LoadImages();

            // 이미지 수 등 프로젝트 관련 정보 업데이트 (예: image count 감소 등)
            project!.ImageCount = await Db.Images.CountAsync(i => i.ProjectId == projectId);
            await Db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] Error deleting image: {ex.Message}");
        }
    }

    private bool showDeleteConfirm = false;

    private void ConfirmBulkDeleteImages()
    {
        var selected = images.Where(i => i.IsSelected).ToList();
        if (selected.Count == 0)
        {
            _ = JS.InvokeVoidAsync("alert", "⚠️ Please select at least one image to delete.");
            return;
        }

        showDeleteConfirm = true;
    }

    private async Task ExecuteBulkDeleteImages()
    {
        var selectedImages = images.Where(i => i.IsSelected).ToList();

        foreach (var image in selectedImages)
        {
            try
            {
                var sourcePath = System.IO.Path.Combine(Env.WebRootPath, image.RelativePath);
                var imagesFolder = System.IO.Path.GetDirectoryName(sourcePath)!;
                var parentFolder = System.IO.Path.GetDirectoryName(imagesFolder)!;
                var annotatedPath = System.IO.Path.Combine(parentFolder, "images_annotated", image.FileName);

                if (File.Exists(sourcePath))
                    File.Delete(sourcePath);
                if (File.Exists(annotatedPath))
                    File.Delete(annotatedPath);

                Db.Images.Remove(image);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[❌] Failed to delete image {image.FileName}: {ex.Message}");
            }
        }

        await Db.SaveChangesAsync();

        showDeleteConfirm = false;
        await LoadImages();

        project!.ImageCount = await Db.Images.CountAsync(i => i.ProjectId == projectId);
        await Db.SaveChangesAsync();
    }


    private async Task DownloadAllImages()
    {
        try
        {
            var imagesFolder = System.IO.Path.Combine(Env.WebRootPath, "datasets", project!.Name, "images");
            if (!Directory.Exists(imagesFolder))
            {
                await JS.InvokeVoidAsync("alert", "Images folder not found.");
                return;
            }

            var zipFileName = $"{project!.Name}.zip";
            var zipPath = System.IO.Path.Combine(Env.WebRootPath, "temp", zipFileName);

            // 임시 폴더 생성
            Directory.CreateDirectory(System.IO.Path.GetDirectoryName(zipPath)!);

            // 기존 zip 파일 삭제
            if (File.Exists(zipPath))
                File.Delete(zipPath);

            // zip 파일 생성
            System.IO.Compression.ZipFile.CreateFromDirectory(imagesFolder, zipPath);

            // 다운로드 트리거
            var downloadUrl = $"/temp/{zipFileName}";
            await JS.InvokeVoidAsync("open", downloadUrl, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] Error zipping images: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "❌ Failed to create ZIP file.");
        }
    }


    private async Task RunAutoLabeling()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "⚠️ Auto Labeling을 실행하시겠습니까?\n이 작업은 기존 라벨이 사라집니다.");
        if (!confirmed)
            return;

        try
        {
            var imageDir = System.IO.Path.Combine(Env.WebRootPath, "datasets", project!.Name, "images");
            var annotatedDir = System.IO.Path.Combine(Env.WebRootPath, "datasets", project!.Name, "images_annotated");
            var scriptPath = System.IO.Path.Combine(Env.ContentRootPath, "PythonScripts", "auto_labeling.py");

            Directory.CreateDirectory(annotatedDir); // ✅ Ensure annotated folder exists

            // ✅ Labels에서 첫 번째 라벨만 사용
            var firstLabel = project!.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? "film";

            var startInfo = new ProcessStartInfo
            {
                FileName = "python",
                // Arguments = $"\"{scriptPath}\" \"{imageDir}\" \"{project!.Name}\"",
                // Arguments = $"\"{scriptPath}\" \"{imageDir}\" \"film\"",
                Arguments = $"\"{scriptPath}\" \"{imageDir}\" \"{firstLabel}\"",
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            var process = new Process { StartInfo = startInfo };
            process.Start();

            string output = await process.StandardOutput.ReadToEndAsync();
            string error = await process.StandardError.ReadToEndAsync();
            await process.WaitForExitAsync();

            if (!string.IsNullOrWhiteSpace(error))
            {
                Console.WriteLine($"[❌] Auto labeling error: {error}");
                await JS.InvokeVoidAsync("alert", "❌ Auto labeling failed.\n" + error);
                return;
            }

            var jsonResult = JsonDocument.Parse(output).RootElement;
            var labelList = project!.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).ToList();
            var colors = new[] { Color.Blue, Color.Green, Color.Red, Color.Orange, Color.Purple };
            var font = RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
                ? SystemFonts.CreateFont("Arial", 16)
                : SystemFonts.CreateFont("DejaVu Sans", 16);

            foreach (var kvp in jsonResult.EnumerateObject())
            {
                var fileName = kvp.Name;
                var image = images.FirstOrDefault(i => i.FileName == fileName);
                if (image == null) continue;

                var labelDataJson = kvp.Value.GetRawText();
                image.LabelData = labelDataJson;
                image.LabelStatus = "Labeled";

                // ✅ Annotated image 생성
                var imagePath = System.IO.Path.Combine(imageDir, image.FileName);
                var annotatedPath = System.IO.Path.Combine(annotatedDir, image.FileName);

                try
                {
                    using var srcImage = await Image.LoadAsync<Rgba32>(imagePath);
                    var labelBoxes = JsonDocument.Parse(labelDataJson).RootElement;

                    foreach (var box in labelBoxes.EnumerateArray())
                    {
                        float x = (float)box.GetProperty("x").GetDouble();
                        float y = (float)box.GetProperty("y").GetDouble();
                        float w = (float)box.GetProperty("w").GetDouble();
                        float h = (float)box.GetProperty("h").GetDouble();
                        string label = box.GetProperty("label").GetString() ?? "";
                        int idx = labelList.IndexOf(label);
                        var color = colors[idx % colors.Length];

                        srcImage.Mutate(ctx =>
                        {
                            ctx.Draw(color, 1, new RectangleF(x, y, w, h));
                            ctx.DrawText(label, font, color, new PointF(x + 4, y - 16));
                        });
                    }

                    await srcImage.SaveAsJpegAsync(annotatedPath);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[❌] Annotated image error for {fileName}: {ex.Message}");
                }
            }

            await Db.SaveChangesAsync();
            await LoadImages();

            await JS.InvokeVoidAsync("alert", "✅ Auto labeling completed and annotated images saved!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] Auto labeling exception: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "❌ Failed to run auto labeling.\n" + ex.Message);
        }
    }

    private async Task ImportLabelsFromPreviousAsync()
    {
        int currentId = selectedImageId;
        int offset = importOffset < 1 ? 1 : importOffset;

        var previous = await Db.Images
            .Where(i => i.ProjectId == projectId && i.Id < currentId && i.LabelStatus == "Labeled")
            .OrderByDescending(i => i.Id)
            .Skip(offset - 1)
            .FirstOrDefaultAsync();

        if (previous == null)
        {
            await JS.InvokeVoidAsync("alert", $"❗ {offset}번째 이전의 라벨링된 이미지가 없습니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(previous.LabelData) || previous.LabelData == "[]")
        {
            await JS.InvokeVoidAsync("alert", "⚠️ 이전 이미지에 라벨 정보가 없습니다.");
            return;
        }

        var current = await Db.Images.FindAsync(selectedImageId);
        string currentLabelData = current?.LabelData ?? "[]";

        try
        {
            var prevArray = JsonDocument.Parse(previous.LabelData).RootElement.EnumerateArray().ToList();
            var currentArray = JsonDocument.Parse(currentLabelData).RootElement.EnumerateArray().ToList();

            var mergedList = new List<JsonElement>();
            mergedList.AddRange(currentArray);
            mergedList.AddRange(prevArray);

            string mergedJson = JsonSerializer.Serialize(mergedList);

            // JS에서 initLabelingCanvas 호출
            await JS.InvokeVoidAsync("initLabelingCanvas", dotNetRef, mergedJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] ImportLabelsFromPreviousAsync Error: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "❌ 이전 라벨 가져오기 중 오류가 발생했습니다.");
        }
    }


    private async Task AdjustLabels()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "⚠️ Adjust Labels를 실행하시겠습니까?\n이 작업은 기존 라벨을 수정할 수 있습니다.");
        if (!confirmed)
            return;

        try
        {
            foreach (var image in images)
            {
                if (string.IsNullOrWhiteSpace(image.LabelData) || image.LabelData == "[]")
                    continue;

                var labelArray = JsonDocument.Parse(image.LabelData).RootElement;
                var updatedBoxes = new List<Dictionary<string, object>>();

                var filmBoxes = new List<Dictionary<string, object>>();
                var nonFilmBoxes = new List<Dictionary<string, object>>();

                foreach (var box in labelArray.EnumerateArray())
                {
                    var label = box.GetProperty("label").GetString();
                    var x = box.GetProperty("x").GetDouble();
                    var y = box.GetProperty("y").GetDouble();
                    var w = box.GetProperty("w").GetDouble();
                    var h = box.GetProperty("h").GetDouble();

                    // 분리 저장
                    var boxDict = new Dictionary<string, object>
                    {
                        ["x"] = x,
                        ["y"] = y,
                        ["w"] = w,
                        ["h"] = h,
                        ["label"] = label ?? string.Empty
                    };

                    if (label == "film")
                        filmBoxes.Add(boxDict);
                    else
                        nonFilmBoxes.Add(boxDict);
                }

                // 기본은 모두 유지
                updatedBoxes.AddRange(filmBoxes);

                if (project!.Name == "L2017-07")
                {
                    foreach (var box in filmBoxes)
                    {
                        double x = Convert.ToDouble(box["x"]);
                        double y = Convert.ToDouble(box["y"]);
                        double w = Convert.ToDouble(box["w"]);
                        double h = Convert.ToDouble(box["h"]);

                        double leftW = w * 0.33;
                        double midW = w * 0.31;
                        double rightW = w * 0.36;
                        double subH = h * 0.48;
                        double baseY = y + h - subH;

                        updatedBoxes.Add(new Dictionary<string, object> { ["x"] = x, ["y"] = baseY, ["w"] = leftW, ["h"] = subH, ["label"] = "good" });
                        updatedBoxes.Add(new Dictionary<string, object> { ["x"] = x + leftW, ["y"] = baseY, ["w"] = midW, ["h"] = subH, ["label"] = "good" });
                        updatedBoxes.Add(new Dictionary<string, object> { ["x"] = x + leftW + midW, ["y"] = baseY, ["w"] = rightW, ["h"] = subH, ["label"] = "good" });
                    }
                }
                else if (project!.Name == "L2018-07" && nonFilmBoxes.Count == 2)
                {
                    // 왼쪽 박스: x 작은 값 기준
                    var sorted = nonFilmBoxes.OrderBy(b => Convert.ToDouble(b["x"])).ToList();
                    var leftBox = sorted[0];
                    var rightBox = sorted[1];

                    {
                        double x = Convert.ToDouble(leftBox["x"]);
                        double y = Convert.ToDouble(leftBox["y"]);
                        double w = Convert.ToDouble(leftBox["w"]);
                        double h = Convert.ToDouble(leftBox["h"]);

                        double newH = h * 0.53;
                        double newY = y + h - newH;

                        updatedBoxes.Add(new Dictionary<string, object>
                        {
                            ["x"] = x,
                            ["y"] = newY,
                            ["w"] = w,
                            ["h"] = newH,
                            ["label"] = leftBox["label"]
                        });
                    }

                    {
                        double x = Convert.ToDouble(rightBox["x"]);
                        double y = Convert.ToDouble(rightBox["y"]);
                        double w = Convert.ToDouble(rightBox["w"]);
                        double h = Convert.ToDouble(rightBox["h"]);

                        double newH = h * 0.449;
                        double newY = y + h - newH - 7;  // 추가로 7픽셀 위로 이동

                        updatedBoxes.Add(new Dictionary<string, object>
                        {
                            ["x"] = x,
                            ["y"] = newY,
                            ["w"] = w,
                            ["h"] = newH,
                            ["label"] = rightBox["label"]
                        });
                    }
                }
                else if (project!.Name == "L0625-12" && nonFilmBoxes.Count == 3)
                {
                    // y값 기준으로 위-중간-아래 순으로 정렬
                    var sortedByY = nonFilmBoxes.OrderBy(b => Convert.ToDouble(b["y"])).ToList();

                    double[] widthFactors = { 0.5, 0.48, 0.47 };

                    for (int i = 0; i < 3; i++)
                    {
                        var box = sortedByY[i];

                        double x = Convert.ToDouble(box["x"]);
                        double y = Convert.ToDouble(box["y"]);
                        double w = Convert.ToDouble(box["w"]);
                        double h = Convert.ToDouble(box["h"]);
                        string label = box["label"].ToString() ?? "";

                        double newW = w * widthFactors[i];

                        updatedBoxes.Add(new Dictionary<string, object>
                        {
                            ["x"] = x,
                            ["y"] = y,
                            ["w"] = newW,
                            ["h"] = h,
                            ["label"] = label ?? string.Empty
                        });
                    }
                }
                else if (project!.Name == "L1570-07" && nonFilmBoxes.Count == 3)
                {
                    // y 기준 정렬 (위 → 중간 → 아래)
                    var sortedByY = nonFilmBoxes.OrderBy(b => Convert.ToDouble(b["y"])).ToList();

                    for (int i = 0; i < 3; i++)
                    {
                        var box = sortedByY[i];

                        double x = Convert.ToDouble(box["x"]);
                        double y = Convert.ToDouble(box["y"]);
                        double w = Convert.ToDouble(box["w"]);
                        double h = Convert.ToDouble(box["h"]);
                        string label = box["label"].ToString() ?? "";

                        // 맨 아래 박스만 width 줄임
                        if (i == 2)
                            w *= 0.55;

                        updatedBoxes.Add(new Dictionary<string, object>
                        {
                            ["x"] = x,
                            ["y"] = y,
                            ["w"] = w,
                            ["h"] = h,
                            ["label"] = label ?? string.Empty
                        });
                    }
                }
                else
                {
                    // film 외 박스 그대로 유지
                    updatedBoxes.AddRange(nonFilmBoxes);
                }

                image.LabelData = JsonSerializer.Serialize(updatedBoxes);
                image.LabelStatus = "Labeled";
            }

            await Db.SaveChangesAsync();
            await LoadImages();
            await JS.InvokeVoidAsync("alert", "✅ Labels successfully adjusted!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] Exception in AdjustLabels: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "❌ Failed to add labels.\n" + ex.Message);
        }
    }

    private async Task DeleteAllLabels()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "⚠️ Are you sure you want to delete ALL labels for this project?\nThis action cannot be undone.");
        if (!confirmed)
            return;

        if (project == null)
        {
            await JS.InvokeVoidAsync("alert", "❌ No project selected.");
            return;
        }

        var imagesToUpdate = await Db.Images
            .Where(i => i.ProjectId == projectId && i.LabelStatus == "Labeled")
            .ToListAsync();

        foreach (var image in imagesToUpdate)
        {
            image.LabelStatus = "Unlabeled";
            image.LabelData = "{}";

            // 삭제된 annotated 이미지도 제거
            var srcPath = System.IO.Path.Combine(Env.WebRootPath, image.RelativePath);
            var parentDir = System.IO.Path.GetDirectoryName(System.IO.Path.GetDirectoryName(srcPath))!;
            var annotatedPath = System.IO.Path.Combine(parentDir, "images_annotated", image.FileName);
            if (File.Exists(annotatedPath))
            {
                File.Delete(annotatedPath);
            }

            Db.Images.Update(image);
        }

        await Db.SaveChangesAsync();
        await LoadImages();
    }
    
    private async Task SaveLabelFromCanvas()
    {
        // 현재 이미지 객체
        var image = await Db.Images.FindAsync(selectedImageId);
        if (image == null) return;

        // 이미 저장된 JSON 사용 (initLabelingCanvas 호출 시 labelJson 저장 필요)
        // 또는 텍스트박스/임시 저장소에서 수동으로 데이터 전달받아도 됨
        // 여기선 간단하게 현재 이미지가 저장된 걸 다시 불러 저장했다고 가정
        image.LabelStatus = string.IsNullOrWhiteSpace(image.LabelData) || image.LabelData == "[]" ? "Unlabeled" : "Labeled";
        await Db.SaveChangesAsync();
    }

    private async Task NavigateLabeling(int direction)
    {
        var currentIndex = images.FindIndex(i => i.Id == selectedImageId);
        var newIndex = currentIndex + direction;

        var nextImage = images[newIndex];
        selectedImageId = nextImage.Id;
        selectedImagePath = "/" + nextImage.RelativePath;

        // 모달 닫았다가 다시 열면 OnAfterRenderAsync에서 initLabelingCanvas 호출됨
        showLabelingModal = false;
        pendingInitJS = true;  // 다시 JS init 시도하도록 설정
        await Task.Delay(10);  // UI 상태 갱신을 위한 잠깐의 대기
        showLabelingModal = true;

        StateHasChanged();
    }

    private async Task GoToPreviousImage()
    {
        await SaveLabelFromCanvas();  // 현재 라벨 저장
        await NavigateLabeling(-1);   // 이전 이미지로 이동
    }

    private async Task GoToNextImage()
    {
        await SaveLabelFromCanvas();  // 현재 라벨 저장
        await NavigateLabeling(+1);   // 다음 이미지로 이동
    }

    private void StartEditingJson()
    {
        editedLabelJson = labelJsonPreview;
        isEditingJson = true;
    }

    private async Task SaveEditedJsonAsync()
    {
        try
        {
            // 유효성 검사 (예: JSON 구문 오류 방지)
            JsonDocument.Parse(editedLabelJson);

            var image = await Db.Images.FindAsync(selectedImageId);
            if (image == null) return;

            image.LabelData = editedLabelJson;
            image.LabelStatus = string.IsNullOrWhiteSpace(editedLabelJson) || editedLabelJson == "[]" ? "Unlabeled" : "Labeled";
            await Db.SaveChangesAsync();

            showJsonModal = false;
            isEditingJson = false;

            await LoadImages(); // 이미지 목록 갱신

            // JS 다시 초기화
            pendingInitJS = true;
            StateHasChanged();  // UI 리렌더링
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[❌] JSON Save Error: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "❌ JSON 저장 중 오류 발생!\n" + ex.Message);
        }
    }

    private async Task ToggleLabelJsonModal()
    {
        if (!showJsonModal)
        {
            var image = await Db.Images.FindAsync(selectedImageId);
            labelJsonPreview = image?.LabelData ?? "{}";
            isEditingJson = false;
        }

        showJsonModal = !showJsonModal;
    }



