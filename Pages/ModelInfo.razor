@page "/model-info"
@using System.Globalization
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject HawkAI.Data.ProjectService.IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Model Info</h3>

@if (modelRows == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>No</th>
                @foreach (var col in Columns)
                {
                    <th @onclick="() => SortBy(col)">
                        @col
                        @if (sortColumn == col)
                        {
                            <span>@(sortAscending ? "▲" : "▼")</span>
                        }
                    </th>
                }
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < SortedRows.Count(); i++)
            {
                var row = SortedRows.ElementAt(i);
                <tr>
                    <td>@(i + 1)</td>
                    <td>@row["모델명"]</td>
                    <td>@row["사이즈"]</td>
                    <td>@row["만든날짜"]</td>
                    <td>@row["Epoch"]</td>
                    <td>@row["Precision"]</td>
                    <td>@row["Recall"]</td>
                    <td>@row["mAP50"]</td>
                    <td>@row["mAP50-95"]</td>
                    <td>@row["ValBoxLoss"]</td>
                    <td>@row["ValClsLoss"]</td>
                    <td>
                        <button class="btn btn-sm btn-info me-1" @onclick="() => ShowResultsImage(row)">보기</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(row)">삭제</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<br />
<h3>Exported Datasets</h3>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>No</th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.ModelName))">
                모델명
                @if (exportSortColumn == nameof(ExportRow.ModelName))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.CreatedAt))">
                만든날짜
                @if (exportSortColumn == nameof(ExportRow.CreatedAt))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.TrainCount))">
                Train Count
                @if (exportSortColumn == nameof(ExportRow.TrainCount))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th @onclick="() => SortExportBy(nameof(ExportRow.ValidCount))">
                Valid Count
                @if (exportSortColumn == nameof(ExportRow.ValidCount))
                {
                    <span>@(exportSortAscending ? "▲" : "▼")</span>
                }
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < SortedExportInfos.Count(); i++)
        {
            var row = SortedExportInfos.ElementAt(i);
            <tr>
                <td>@(i + 1)</td>
                <td>@row.ModelName</td>
                <td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@row.TrainCount</td>
                <td>@row.ValidCount</td>
                <td>
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteExport(row.FolderName)">삭제</button>
                </td>
            </tr>
        }
    </tbody>
</table>



@if (showResultsImageModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Results Image</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showResultsImageModal = false"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="@resultsImagePath" style="max-width: 100%; height: auto;" alt="Results" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showResultsImageModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}



@code {
    List<Dictionary<string, string>> modelRows = new();
    string sortColumn = "모델명";
    bool sortAscending = true;
    string exportSortColumn = "ModelName";
    bool exportSortAscending = true;

    List<string> userProjectNames = new();
    bool isAdmin = false;

    string resultsImagePath = "";
    bool showResultsImageModal = false;

    string[] Columns = new[] {
        "모델명", "사이즈", "만든날짜", "Epoch",
        "Precision", "Recall", "mAP50", "mAP50-95",
        "ValBoxLoss", "ValClsLoss"
    };

    IEnumerable<Dictionary<string, string>> SortedRows =>
        sortAscending
            ? modelRows.OrderBy(row => row[sortColumn], StringComparer.CurrentCulture)
            : modelRows.OrderByDescending(row => row[sortColumn], StringComparer.CurrentCulture);

    IEnumerable<ExportRow> SortedExportInfos =>
    exportSortAscending
        ? exportInfos.OrderBy(e => e.GetType().GetProperty(exportSortColumn)?.GetValue(e, null))
        : exportInfos.OrderByDescending(e => e.GetType().GetProperty(exportSortColumn)?.GetValue(e, null));


    class ExportRow
    {
        public string ModelName { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public int TrainCount { get; set; }
        public int ValidCount { get; set; }
        public string FolderName { get; set; } = string.Empty;
    }

    List<ExportRow> exportInfos = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.Identity?.Name ?? "unknown";
        isAdmin = user.IsInRole("Admin");

        if (!isAdmin)
        {
            var rawProjects = await ProjectService.GetUserProjects(userId);
            userProjectNames = rawProjects.Select(p => p.Name).ToList();
        }

        LoadModelInfo();
        LoadExportInfo();
    }

    void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    void LoadModelInfo()
    {
        var runsDir = Path.Combine(Env.WebRootPath, "runs");
        if (!Directory.Exists(runsDir)) return;

        var folders = Directory.GetDirectories(runsDir);
        modelRows = new();

        foreach (var folder in folders)
        {
            var folderName = Path.GetFileName(folder);
            var parts = folderName.Split('_');
            if (parts.Length < 4) continue;

            var modelName = string.Join('_', parts[..^3]);
            if (!isAdmin && !userProjectNames.Contains(modelName)) continue;

            var size = parts[^3];
            var created = ParseDate(parts[^2] + "_" + parts[^1]);

            var row = new Dictionary<string, string>
            {
                ["모델명"] = modelName,
                ["사이즈"] = size,
                ["만든날짜"] = created,
                ["Epoch"] = "-",
                ["Precision"] = "-",
                ["Recall"] = "-",
                ["mAP50"] = "-",
                ["mAP50-95"] = "-",
                ["ValBoxLoss"] = "-",
                ["ValClsLoss"] = "-",
                ["폴더명"] = folderName
            };

            var csvPath = Path.Combine(folder, "results.csv");
            if (File.Exists(csvPath))
            {
                try
                {
                    var lines = File.ReadAllLines(csvPath);
                    if (lines.Length >= 2)
                    {
                        var last = lines.Last().Split(',');
                        row["Epoch"] = last[0];
                        row["Precision"] = last[5];
                        row["Recall"] = last[6];
                        row["mAP50"] = last[7];
                        row["mAP50-95"] = last[8];
                        row["ValBoxLoss"] = last[9];
                        row["ValClsLoss"] = last[10];
                    }
                }
                catch { }
            }

            modelRows.Add(row);
        }
    }

    void SortExportBy(string column)
    {
        if (exportSortColumn == column)
            exportSortAscending = !exportSortAscending;
        else
        {
            exportSortColumn = column;
            exportSortAscending = true;
        }
    }

    void LoadExportInfo()
    {
        var expDir = Path.Combine(Env.WebRootPath, "exports");
        if (!Directory.Exists(expDir)) return;

        var folders = Directory.GetDirectories(expDir);
        exportInfos.Clear();

        foreach (var folder in folders)
        {
            var folderName = Path.GetFileName(folder);
            var parts = folderName.Split('_');
            if (parts.Length < 3) continue;

            var modelName = string.Join('_', parts[..^2]);

            // ✅ Admin이 아니면 사용자 프로젝트 prefix와 일치하는지 검사
            if (!isAdmin && !userProjectNames.Any(p => modelName.Equals(p, StringComparison.OrdinalIgnoreCase)))
                continue;

            var yaml = Path.Combine(folder, "data.yaml");
            if (!File.Exists(yaml)) continue;

            int train = 0, valid = 0;
            var lines = File.ReadAllLines(yaml);
            foreach (var line in lines)
            {
                if (line.Contains("trainCount"))
                    train = int.Parse(line.Split(':')[1].Trim());
                if (line.Contains("validCount"))
                    valid = int.Parse(line.Split(':')[1].Trim());
            }

            exportInfos.Add(new ExportRow
            {
                ModelName = modelName,
                CreatedAt = Directory.GetCreationTime(folder),
                TrainCount = train,
                ValidCount = valid,
                FolderName = folderName
            });
        }
    }


    async Task ConfirmDelete(Dictionary<string, string> row)
    {
        var folder = Path.Combine(Env.WebRootPath, "runs", row["폴더명"]);
        if (Directory.Exists(folder))
        {
            if (await JS.InvokeAsync<bool>("confirm", $"모델 폴더를 삭제할까요?\n{row["폴더명"]}"))
            {
                try
                {
                    Directory.Delete(folder, true);
                    modelRows.Remove(row);
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("alert", $"삭제 실패: {ex.Message}");
                }
            }
        }
    }

    async Task ConfirmDeleteExport(string folderName)
    {
        var folder = Path.Combine(Env.WebRootPath, "exports", folderName);
        var zipFile = Path.Combine(Env.WebRootPath, "exports", folderName + ".zip");

        if (Directory.Exists(folder))
        {
            if (await JS.InvokeAsync<bool>("confirm", $"Export 폴더를 삭제할까요?\n{folderName}"))
            {
                try
                {
                    Directory.Delete(folder, true);
                    if (File.Exists(zipFile))
                    {
                        File.Delete(zipFile);
                    }
                    exportInfos.RemoveAll(x => x.FolderName == folderName);
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("alert", $"삭제 실패: {ex.Message}");
                }
            }
        }
    }


    string ParseDate(string input)
    {
        if (DateTime.TryParseExact(input, "yyyyMMdd_HHmmss", null, DateTimeStyles.None, out var dt))
        {
            return dt.ToString("yyyy-MM-dd HH:mm:ss");
        }
        return input;
    }


    void ShowResultsImage(Dictionary<string, string> row)
    {
        var folderName = row["폴더명"];
        var imagePath = Path.Combine("runs", folderName, "results.png");
        var fullPath = Path.Combine(Env.WebRootPath, imagePath);

        if (File.Exists(fullPath))
        {
            resultsImagePath = "/" + imagePath.Replace("\\", "/");
            showResultsImageModal = true;
        }
        else
        {
            JS.InvokeVoidAsync("alert", $"❌ results.png not found in folder: {folderName}");
        }
    }
}
