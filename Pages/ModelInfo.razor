@page "/model-info"
@using System.Globalization
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject HawkAI.Data.ProjectService.IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Globalization
@using System.IO.Compression
@using System.Linq

<h3>Model Info</h3>

@if (modelRows == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>No</th>
                @foreach (var col in Columns)
                {
                    <th @onclick="() => SortBy(col)" style="cursor:pointer;">
                        @col
                        @if (sortColumn == col)
                        {
                            <span>@(sortAscending ? "▲" : "▼")</span>
                        }
                    </th>
                }
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < SortedRows.Count(); i++)
            {
                var row = SortedRows.ElementAt(i);
                <tr>
                    <td>@(i + 1)</td>
                    <td>@row["Model"]</td>
                    <td>@row["Size"]</td>
                    <td>@row["Date"]</td>
                    <td>@row["Dataset"]</td>     
                    <td>@row["Img Size"]</td>
                    <td>@row["Epoch"]</td>
                    <td>@row["Precision"]</td>
                    <td>@row["Recall"]</td>
                    <td>@row["mAP50"]</td>
                    <td>@row["mAP50-95"]</td>
                    <td>@row["ValBoxLoss"]</td>
                    <td>@row["ValClsLoss"]</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => ShowFolder(row)">보기</button>
                        <button class="btn btn-sm btn-info me-1"
                                disabled="@(isZipping && zippingTarget == row["폴더명"])"
                                @onclick="() => DownloadFolderAsZip(row)">
                            @(isZipping && zippingTarget == row["폴더명"] ? "압축중..." : "다운로드")
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(row)">삭제</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showFolderModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-xxl" style="max-width: 1200px;">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Folder: @currentFolderName</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseFolderModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Left: file list -->
                        <div class="col-4" style="max-height:70vh; overflow:auto;">
                            <input class="form-control mb-2" placeholder="Filter files..."
                                   @bind="fileFilter" @bind:event="oninput" />
                            <ul class="list-group">
                                @foreach (var f in FilteredFiles)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center"
                                        style="cursor:pointer;@(selectedFile?.RelativePath == f.RelativePath ? "background:#eef;" : "")"
                                        @onclick="() => PreviewFile(f)">
                                        <div>
                                            <div><strong>@f.Name</strong></div>
                                            <small class="text-muted">@f.Ext · @FormatSize(f.Size) · @f.Modified.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                        </div>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="@("/" + f.RelativePath.Replace("\\", "/"))"
                                           download>다운로드</a>
                                    </li>
                                }
                            </ul>
                        </div>

                        <!-- Right: preview -->
                        <div class="col-8">
                            @if (selectedFile is null)
                            {
                                <div class="text-muted">좌측에서 파일을 선택하세요.</div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <h6 class="mb-0">@selectedFile.Name</h6>
                                        <small class="text-muted">@selectedFile.Ext · @FormatSize(selectedFile.Size) · @selectedFile.Modified.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                    </div>
                                    <a class="btn btn-sm btn-primary"
                                       href="@("/" + selectedFile.RelativePath.Replace("\\", "/"))"
                                       download>다운로드</a>
                                </div>

                                @if (IsImage(selectedFile.Ext))
                                {
                                    <div class="text-center">
                                        <img src="@("/" + selectedFile.RelativePath.Replace("\\", "/"))"
                                             style="max-width:100%; max-height:70vh; object-fit:contain;"
                                             alt="@selectedFile.Name" />
                                    </div>
                                }
                                else if (IsText(selectedFile.Ext))
                                {
                                    <pre style="max-height:70vh; overflow:auto; background:#111; color:#ddd; padding:12px; border-radius:8px;">@previewContent</pre>
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        이 파일 형식은 미리보기를 지원하지 않습니다. 다운로드해서 확인하세요.
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseFolderModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== 기존 필드 =====
    List<Dictionary<string, string>> modelRows = new();
    string sortColumn = "Date";
    bool sortAscending = false;  // 최신순 정렬

    List<string> userProjectNames = new();
    bool isAdmin = false;
    
    // ZIP 진행 상태
    bool isZipping = false;
    string? zippingTarget = null;

    string[] Columns = new[] {
        "Model", "Size", "Date", "Dataset", "Img Size", "Epoch",
        "Precision", "Recall", "mAP50", "mAP50-95",
        "ValBoxLoss", "ValClsLoss"
    };

    IEnumerable<Dictionary<string, string>> SortedRows =>
        sortAscending
            ? modelRows.OrderBy(row => row[sortColumn], StringComparer.CurrentCulture)
            : modelRows.OrderByDescending(row => row[sortColumn], StringComparer.CurrentCulture);

    // ===== 새로 추가된: 폴더 브라우저 상태 =====
    class FileItem
    {
        public string Name { get; set; } = "";
        public string RelativePath { get; set; } = ""; // e.g., "runs/folder/file.ext"
        public long Size { get; set; }
        public DateTime Modified { get; set; }
        public string Ext { get; set; } = "";
    }

    bool showFolderModal = false;
    string currentFolderName = "";
    List<FileItem> currentFiles = new();
    FileItem? selectedFile = null;
    string previewContent = "";
    string fileFilter = "";

    IEnumerable<FileItem> FilteredFiles =>
        string.IsNullOrWhiteSpace(fileFilter)
        ? currentFiles
        : currentFiles.Where(f => f.Name.Contains(fileFilter, StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.Identity?.Name ?? "unknown";
        isAdmin = user.IsInRole("Admin");

        if (!isAdmin)
        {
            var rawProjects = await ProjectService.GetUserProjects(userId);
            userProjectNames = rawProjects.Select(p => p.Name).ToList();
        }

        LoadModelInfo();
    }

    void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    void LoadModelInfo()
    {
        var runsDir = Path.Combine(Env.WebRootPath, "runs");
        if (!Directory.Exists(runsDir)) return;

        var folders = Directory.GetDirectories(runsDir);
        modelRows = new();

        foreach (var folder in folders)
        {
            var folderName = Path.GetFileName(folder);
            var parts = folderName.Split('_');
            if (parts.Length < 4) continue;

            var modelName = string.Join('_', parts[..^3]);
            if (!isAdmin && !userProjectNames.Contains(modelName)) continue;

            var size = parts[^3];
            var created = ParseDate(parts[^2] + "_" + parts[^1]);

            var row = new Dictionary<string, string>
            {
                ["Model"] = modelName,
                ["Size"] = size,
                ["Date"] = created,
                ["Dataset"] = "-",     // 초기화 후 위에서 수정됨
                ["Img Size"] = "-",    // 초기화 후 위에서 수정됨
                ["Epoch"] = "-",
                ["Precision"] = "-",
                ["Recall"] = "-",
                ["mAP50"] = "-",
                ["mAP50-95"] = "-",
                ["ValBoxLoss"] = "-",
                ["ValClsLoss"] = "-",
                ["폴더명"] = folderName
            };

            var argsPath = Path.Combine(folder, "args.yaml");
            if (File.Exists(argsPath))
            {
                try
                {
                    var lines = File.ReadAllLines(argsPath);

                    // Dataset 경로에서 마지막 폴더명만 추출
                    var dataLine = lines.FirstOrDefault(l => l.TrimStart().StartsWith("data:"));
                    if (dataLine != null)
                    {
                        var path = dataLine.Split(':', 2)[1].Trim().Replace("\"", "").Replace("'", "");
                        var datasetName = Path.GetFileName(Path.GetDirectoryName(path));
                        row["Dataset"] = datasetName ?? "-";
                    }

                    // Img Size
                    string imgSize = "-";
                    var imgszLine = lines.FirstOrDefault(l => l.TrimStart().StartsWith("imgsz:"));

                    if (imgszLine != null && imgszLine.Contains("["))
                    {
                        // imgsz: [600, 800] 형태
                        var match = System.Text.RegularExpressions.Regex.Match(imgszLine, @"\[(\d+),\s*(\d+)\]");
                        if (match.Success)
                        {
                            imgSize = $"{match.Groups[2].Value}*{match.Groups[1].Value}";
                        }
                    }
                    else
                    {
                        // imgsz: 640 (그 다음 줄도 확인 필요 없음)
                        var index = Array.IndexOf(lines, imgszLine);
                        if (index >= 0 && index + 2 < lines.Length && lines[index + 1].Trim().StartsWith("-"))
                        {
                            // 멀티라인
                            var h = lines[index + 1].Trim().TrimStart('-').Trim();
                            var w = lines[index + 2].Trim().TrimStart('-').Trim();
                            imgSize = $"{w}*{h}";
                        }
                        else if (imgszLine != null)
                        {
                            var value = imgszLine.Split(':', 2)[1].Trim();
                            imgSize = $"{value}*{value}";
                        }
                    }

                    row["Img Size"] = imgSize;
                }
                catch
                {
                    row["Dataset"] = "-";
                    row["Img Size"] = "-";
                }
            }
            else
            {
                row["Dataset"] = "-";
                row["Img Size"] = "-";
            }

            var csvPath = Path.Combine(folder, "results.csv");
            if (File.Exists(csvPath))
            {
                try
                {
                    var lines = File.ReadAllLines(csvPath);
                    if (lines.Length >= 2)
                    {
                        var last = lines.Last().Split(',');
                        row["Epoch"] = last.ElementAtOrDefault(0) ?? "-";
                        row["Precision"] = last.ElementAtOrDefault(5) ?? "-";
                        row["Recall"] = last.ElementAtOrDefault(6) ?? "-";
                        row["mAP50"] = last.ElementAtOrDefault(7) ?? "-";
                        row["mAP50-95"] = last.ElementAtOrDefault(8) ?? "-";
                        row["ValBoxLoss"] = last.ElementAtOrDefault(9) ?? "-";
                        row["ValClsLoss"] = last.ElementAtOrDefault(10) ?? "-";
                    }
                }
                catch { }
            }

            modelRows.Add(row);
        }
    }

    async Task ConfirmDelete(Dictionary<string, string> row)
    {
        var folder = Path.Combine(Env.WebRootPath, "runs", row["폴더명"]);
        if (Directory.Exists(folder))
        {
            if (await JS.InvokeAsync<bool>("confirm", $"모델 폴더를 삭제할까요?\n{row["폴더명"]}"))
            {
                try
                {
                    Directory.Delete(folder, true);
                    modelRows.Remove(row);
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("alert", $"삭제 실패: {ex.Message}");
                }
            }
        }
    }

    string ParseDate(string input)
    {
        if (DateTime.TryParseExact(input, "yyyyMMdd_HHmmss", null, DateTimeStyles.None, out var dt))
        {
            return dt.ToString("yyyy-MM-dd HH:mm:ss");
        }
        return input;
    }

    // ===== 새로 추가된: 폴더 보기/미리보기 로직 =====
    void ShowFolder(Dictionary<string, string> row)
    {
        currentFolderName = row["폴더명"];
        var folderAbs = Path.Combine(Env.WebRootPath, "runs", currentFolderName);
        currentFiles = new();

        if (Directory.Exists(folderAbs))
        {
            foreach (var path in Directory.GetFiles(folderAbs))
            {
                var fi = new FileInfo(path);
                currentFiles.Add(new FileItem
                {
                    Name = fi.Name,
                    RelativePath = Path.Combine("runs", currentFolderName, fi.Name),
                    Size = fi.Length,
                    Modified = fi.LastWriteTime,
                    Ext = fi.Extension.ToLowerInvariant()
                });
            }

            // 기본 선택: results.png가 있으면 우선, 없으면 첫 파일
            var defaultSel = currentFiles.FirstOrDefault(f => f.Name.Equals("results.png", StringComparison.OrdinalIgnoreCase))
                             ?? currentFiles.FirstOrDefault();
            selectedFile = null;
            previewContent = "";
            fileFilter = "";
            showFolderModal = true;

            if (defaultSel != null)
                PreviewFile(defaultSel);
        }
        else
        {
            JS.InvokeVoidAsync("alert", $"폴더를 찾을 수 없습니다: {currentFolderName}");
        }
    }

    void PreviewFile(FileItem f)
    {
        selectedFile = f;
        previewContent = "";

        var abs = Path.Combine(Env.WebRootPath, f.RelativePath);
        if (IsText(f.Ext))
        {
            try
            {
                // 너무 큰 파일 방지: 앞부분만 미리보기 (최대 ~200KB)
                const int maxBytes = 200_000;
                using var fs = new FileStream(abs, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                using var sr = new StreamReader(fs);
                char[] buffer = new char[Math.Min(maxBytes, (int)fs.Length)];
                int read = sr.Read(buffer, 0, buffer.Length);
                previewContent = new string(buffer, 0, read);

                // CSV 가독성: 너무 긴 줄이면 잘라서 표시
                if (f.Ext is ".csv")
                {
                    var lines = previewContent.Split('\n').Take(200); // 최대 200줄 미리보기
                    previewContent = string.Join('\n', lines);
                }
            }
            catch (Exception ex)
            {
                previewContent = $"[미리보기 실패] {ex.Message}";
            }
        }
        StateHasChanged();
    }

    void CloseFolderModal()
    {
        showFolderModal = false;
        selectedFile = null;
        currentFiles.Clear();
        previewContent = "";
        fileFilter = "";
        currentFolderName = "";
    }

    static bool IsImage(string ext)
        => ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp";

    static bool IsText(string ext)
        => ext is ".txt" or ".csv" or ".json" or ".yaml" or ".yml" or ".log" or ".md";

    static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.##} {units[unit]}";
    }

    async Task DownloadFolderAsZip(Dictionary<string, string> row)
    {
        var folderName = row["폴더명"];
        var srcDir = Path.Combine(Env.WebRootPath, "runs", folderName);

        if (!Directory.Exists(srcDir))
        {
            await JS.InvokeVoidAsync("alert", $"폴더가 없습니다: {folderName}");
            return;
        }

        try
        {
            // 상태 변경 & 즉시 렌더
            isZipping = true;
            zippingTarget = folderName;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var zipsDir = Path.Combine(Env.WebRootPath, "_zips");
            Directory.CreateDirectory(zipsDir);

            // ⬇️ 파일명 = 폴더명.zip (타임스탬프 제거)
            var zipFileName = $"{folderName}.zip";
            var zipPath = Path.Combine(zipsDir, zipFileName);

            // 기존 동일 이름 ZIP 있으면 삭제
            if (System.IO.File.Exists(zipPath))
                System.IO.File.Delete(zipPath);

            // ZIP 생성 (백그라운드 스레드)
            await Task.Run(() =>
            {
                ZipFile.CreateFromDirectory(
                    sourceDirectoryName: srcDir,
                    destinationArchiveFileName: zipPath,
                    compressionLevel: CompressionLevel.Fastest,
                    includeBaseDirectory: false
                );
            });

            // 캐시 무효화를 위해 쿼리스트링만 추가(파일명은 그대로)
            var cacheBuster = DateTimeOffset.Now.ToUnixTimeSeconds();
            var url = "/" + Path.Combine("_zips", zipFileName).Replace("\\", "/") + $"?t={cacheBuster}";

            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"ZIP 생성 실패: {ex.Message}");
        }
        finally
        {
            isZipping = false;
            zippingTarget = null;
            await InvokeAsync(StateHasChanged);
        }
    }

}
