    {
        _selectedRoiId = null;
        _selectedMeasureId = null;
        Log("Selection cleared");
        await PushCanvasStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectRoiAsync(int id)
    {
        _selectedRoiId = id;
        _selectedMeasureId = null;
        Log($"Selected roi_{id}");
        await PushCanvasStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectMeasureAsync(int id)
    {
        _selectedMeasureId = id;
